generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  collections   Collection[]

  @@map("user")
}

model Collection {
  id           String   @id @default(cuid())
  slug         String
  name         String
  baseCurrency String
  // The language the collection's own entity text is written in (#293) — a free ISO 639-1 code.
  // `CollectionArea.titleName` and the other default-language columns hold text in this language,
  // so a platform listing in it needs no translation: it is excluded from the per-language inputs
  // and resolves straight to the default value. Existing collections were backfilled to "en".
  defaultLanguage String @default("en")
  // Duplicate catalog-number policy (#85): "warn" (default) shows a non-blocking
  // warning; "block" prevents saving a stamp whose catalog identity (vendor +
  // effective area prefix + number) already exists in the collection.
  duplicateCatalogMode String @default("warn")
  // Allocation counter for the per-collection copy numbering (#268). Handing out `Item.itemNo`
  // is an atomic bump of this column (`UPDATE ... SET next_item_no = next_item_no + n RETURNING`),
  // never `max(itemNo) + 1` — a deleted copy must not hand its number to the next one, and a bulk
  // intake takes a whole range in one statement.
  nextItemNo   Int      @default(1)
  // How many digits an internal copy number is padded to for display (#268). Purely a display
  // choice — the stored `Item.itemNo` is the bare integer — so changing it never touches a row.
  itemNoPad    Int      @default(5)
  ownerId      String
  createdAt    DateTime @default(now())

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collectionAreas CollectionArea[]
  catalogVendors  CatalogVendor[]
  stamps          Stamp[]
  issues          Issue[]
  exchangeRates   ExchangeRate[]
  stampConditions StampCondition[]
  certificateStatuses CertificateStatus[]
  stampFormats    StampFormat[]
  stampFormatFactors StampFormatFactor[]
  stampSubtypes   StampSubtype[]
  collageTemplates CollageTemplate[]
  items           Item[]
  contacts        Contact[]
  locations       Location[]
  purchases       Purchase[]
  offers          Offer[]
  sales           Sale[]
  colnectCatalogMappings ColnectCatalogMapping[]
  assistantTokens AssistantToken[]
  assistantRegistrationCodes AssistantRegistrationCode[]

  @@unique([ownerId, slug])
  @@map("collection")
}

model StampCondition {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String
  sortOrder    Int

  collection    Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogPrices StampCatalogPrice[]
  items         Item[]
  translations  StampConditionTranslation[]
  formatFactors StampFormatFactor[]

  @@index([collectionId])
  @@map("stamp_condition")
}

// A physical **format** — how many stamps are attached to each other and how (horizontal pair,
// block of four, strip of three…). Supersedes the #135 convention, under which a multiple was
// recorded as its own `Stamp` with a self-descriptive number (`245 x4`): that collapses two
// independent axes into one and produces `formats × variant-tree nodes` stamps, while making
// "a pair, variant not yet identified" inexpressible — a pair of `309BP` is not a child of a
// pair of `309B`. Zusammendrucke / se-tenant that carry their **own** catalog number (Michel
// `S`/`W`/`K`/`Zd`) are unaffected and stay their own `Stamp`; they really are distinct entries.
//
// A format is a peer of `StampCondition`, not a quantity. A multiple is **never** decomposed
// into N singles — there is deliberately no unit count, and nothing anywhere multiplies or
// divides by one. Completeness asks "do I have the whole series in pairs?" exactly the way it
// asks "in MNH?", so format is a breakdown dimension alongside condition, not a factor applied
// to counts.
//
// There is no "single" row, and none is seeded: a null `formatId` **means single**, exactly as a
// null `certificateStatusId` means "no certificate" (ADR-0006 §2). That keeps every pre-existing
// price and copy valid with no backfill, and extends the existing `NULLS NOT DISTINCT` idiom to
// the new column instead of inventing a second convention.
model StampFormat {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String
  sortOrder    Int

  collection    Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogPrices StampCatalogPrice[]
  items         Item[]
  factors       StampFormatFactor[]
  translations  StampFormatTranslation[]

  @@index([collectionId])
  @@map("stamp_format")
}

// Per-language `name` / `abbreviation` for a format (#344), behind the `{format}` / `{formatAbbr}`
// tokens (#345) — a German listing should read "Viererblock", not "Block of 4". See
// {@link StampConditionTranslation}: identical shape, and the two fields fall back
// **independently**, because a language often translates the name and keeps the abbreviation.
model StampFormatTranslation {
  stampFormatId String
  language      String
  name          String?
  abbreviation  String?

  stampFormat StampFormat @relation(fields: [stampFormatId], references: [id], onDelete: Cascade)

  @@id([stampFormatId, language])
  @@map("stamp_format_translation")
}

// The multiplier that derives a format's catalog price from the single's, when no explicit price
// was recorded for that format. Catalogs are written this way — Michel Spezial prints one
// Viererblock factor per issue and an explicit price only where the multiple deviates — so
// following the source keeps entry proportional to what is actually published, instead of
// demanding a condition × certificate × format grid per stamp.
//
// One table with **nullable anchors**: the all-nulls row *is* the collection default, so there is
// a single mechanism and a single editor rather than a `defaultFactor` column plus an override
// table. A row applies only when every anchor it sets matches the stamp being priced — the area
// anchor matching any descendant of itself, so a factor on "German Reich" covers "Infla" unless
// Infla sets its own.
//
// Resolution is a **fixed precedence order**, not a specificity score: candidates are compared on
// `(issue set?, area depth, condition set?)` lexicographically and the first difference wins.
// Scoring independent dimensions against each other produces orderings nobody can predict; a
// fixed order is always explainable in one line in the UI ("from: Infla 1923 → block of 4").
// Note the consequence, chosen deliberately: *where* beats *for which condition*, so a factor
// pinned to an issue outranks a collection-wide factor pinned to "used".
model StampFormatFactor {
  id           String  @id @default(cuid())
  collectionId String
  formatId     String
  // Multiplier applied to the single's price. Four decimals because catalog factors are not
  // always whole (a pair is commonly 2.2×, a block 4.5×).
  factor       Decimal @db.Decimal(10, 4)
  // Anchors. Null means "any" — the dimension simply does not narrow this row.
  collectionAreaId String?
  issueId          String?
  conditionId      String?

  collection     Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  format         StampFormat     @relation(fields: [formatId], references: [id], onDelete: Cascade)
  collectionArea CollectionArea? @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  condition      StampCondition? @relation(fields: [conditionId], references: [id], onDelete: Restrict)

  // Uniqueness on (collectionId, formatId, collectionAreaId, issueId, conditionId) is enforced by
  // a raw `UNIQUE ... NULLS NOT DISTINCT` index (see migration) for the same reason as
  // `stamp_catalog_price`: three of the five columns are nullable, and Postgres would otherwise
  // treat every null-anchored row as distinct from every other. Requires PostgreSQL 15+.
  @@index([collectionId])
  @@index([formatId])
  @@index([collectionAreaId])
  @@index([issueId])
  @@index([conditionId])
  @@map("stamp_format_factor")
}

// Per-language `name` / `abbreviation` for a condition (#294), behind the `{condition}` and
// `{conditionAbbr}` title tokens. Same shape as `CollectionAreaTranslation` (#293): the parent's
// own columns stay the default-language values, a row here overrides them for one language, and
// each field falls back **independently** — a language may translate the name but keep the
// abbreviation (`MNH` is often left as-is).
model StampConditionTranslation {
  stampConditionId String
  language         String
  name             String?
  abbreviation     String?

  stampCondition StampCondition @relation(fields: [stampConditionId], references: [id], onDelete: Cascade)

  @@id([stampConditionId, language])
  @@map("stamp_condition_translation")
}

model CertificateStatus {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String
  sortOrder    Int

  collection    Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogPrices StampCatalogPrice[]
  items         Item[]
  translations  CertificateStatusTranslation[]

  @@index([collectionId])
  @@map("certificate_status")
}

// Per-language `name` / `abbreviation` for a certificate status (#294), behind `{certificate}` and
// `{certificateAbbr}`. See {@link StampConditionTranslation} — identical shape and fallback rules.
model CertificateStatusTranslation {
  certificateStatusId String
  language            String
  name                String?
  abbreviation        String?

  certificateStatus CertificateStatus @relation(fields: [certificateStatusId], references: [id], onDelete: Cascade)

  @@id([certificateStatusId, language])
  @@map("certificate_status_translation")
}

model StampSubtype {
  id            String  @id @default(cuid())
  collectionId  String
  name          String
  actsAsVariant Boolean @default(true)
  isDefault     Boolean @default(false)
  sortOrder     Int

  collection   Collection                @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stamps       Stamp[]
  translations StampSubtypeTranslation[]

  @@index([collectionId])
  // Exactly-one-default is enforced by a partial unique index written by hand in
  // the migration SQL (Prisma cannot express partial indexes):
  //   CREATE UNIQUE INDEX "stamp_subtype_one_default"
  //     ON "stamp_subtype"("collectionId") WHERE "isDefault";
  @@map("stamp_subtype")
}

// Per-language `name` for a subtype (#338), behind the `{subtype}` token (#339). See
// {@link IssueTranslation} — identical shape and fallback rules, and one translatable column
// because a subtype has no abbreviation.
model StampSubtypeTranslation {
  stampSubtypeId String
  language       String
  name           String?

  stampSubtype StampSubtype @relation(fields: [stampSubtypeId], references: [id], onDelete: Cascade)

  @@id([stampSubtypeId, language])
  @@map("stamp_subtype_translation")
}

// A named, reusable collage render preset (#307). How many stamps fit sensibly on one collage is a
// property of **stamp size**, not of the platform or the offer — many small definitives fit where
// few large commemoratives do — so the numbers live in templates the collector maintains once,
// rather than being set by hand on every offer.
//
// Two things to keep in mind:
//
//  - **Capacity, not frame.** `rows` × `columns` is a maximum. A set of 4 copies under a 5×4
//    template produces a one-row collage sized to its contents, not a padded 5×4 canvas (#310).
//  - **Seeded, not referenced.** A template is chosen on an offer and its values are *copied* onto
//    the offer (#308), exactly as `Contact.descriptionTemplate` seeds `Offer.description`. Editing
//    a template therefore never retroactively changes offers that were already prepared, and no
//    *offer* points back here. The single reference is `Contact.defaultCollageTemplateId` (#308) —
//    which template a new offer on that platform seeds from — and it is `onDelete: SetNull`, so a
//    template stays freely deletable.
//
// Templates carry no platform limits (max photos / edge / file size); those live on `Contact` and
// are read live at render time (#308, #310).
model CollageTemplate {
  id           String @id @default(cuid())
  collectionId String
  name         String
  // Capacity of the collage. Both ≥ 1; a 1×1 template is the single-stamp case, which is the same
  // rendering path as any other collage.
  rows         Int
  columns      Int
  // Spacing between tiles — one value used both between columns and between rows — as a **percent
  // of the stamp height**, resolved by the renderer against the median tile of the collage it is
  // laying out (#310, #312). Not pixels: a pixel number cannot be chosen without knowing the scan
  // DPI and how far the platform's limits will shrink the finished image, and neither is known when
  // the template is written.
  gapPercent   Int
  // Canvas colour behind the tiles, `#rrggbb`. Also what the label strip is drawn on.
  background   String @default("#ffffff")
  // Height of the label strip drawn below each tile (#312) — and so the size of its caption — as a
  // percent of the **finished image's longest edge**, not of the stamp (#337): every image of a
  // listing is scaled to the same platform limit before upload, so only a share of the image renders
  // at one size across a collage, a lone scan and a wide detail crop. Fractional, because the usable
  // band is a couple of percent wide and whole numbers cannot land inside it. 0 = no strip.
  labelPercent Float @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // Platforms that seed new offers from this template (#308). `onDelete: SetNull` on that FK — a
  // template deleted while a platform points at it simply leaves the platform without a default.
  defaultForPlatforms Contact[] @relation("PlatformDefaultCollage")

  @@index([collectionId])
  @@map("collage_template")
}

model CatalogVendor {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String

  collection            Collection             @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogNames          CatalogName[]
  stampCatalogNumbers   StampCatalogNumber[]
  issueCatalogNumbers   IssueCatalogNumber[]
  collectionAreaVendors CollectionAreaVendor[]
  colnectCatalogMappings ColnectCatalogMapping[]

  @@map("catalog_vendor")
}

// Per-collection translation from a Colnect catalog abbreviation (as printed on Colnect
// catalog pages: Mi, Sn, Yt, Sg, AFA, Pol…) to one of our local `CatalogVendor`s (#248,
// part of #155). Needed because Colnect's abbreviations don't all match ours — notably
// Colnect `Pol` is Fischer, which we abbreviate `Fi`. Only mismatches need an explicit row:
// an abbreviation with no row falls back to a local vendor whose `abbreviation` matches it
// exactly (case-insensitive); anything still unresolved is ignored during matching, not an
// error. See `src/lib/colnect.ts`.
model ColnectCatalogMapping {
  id              String @id @default(cuid())
  collectionId    String
  // The Colnect catalog abbreviation, stored as entered (e.g. "Pol"). Unique per collection.
  colnectAbbrev   String
  catalogVendorId String

  collection    Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogVendor CatalogVendor @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@unique([collectionId, colnectAbbrev])
  @@index([collectionId])
  @@index([catalogVendorId])
  @@map("colnect_catalog_mapping")
}

// Bearer token letting the Stamporama Assistant browser extension (#253, part of #155) call a
// collection's Colnect matcher endpoints. An extension running on colnect.com reaches our origin
// cross-site, where Better Auth's session cookie is not sent, so a token is needed. A token
// authorizes as the collection's owner for that one collection (owner-only access model). Only the
// SHA-256 hash of the raw token is stored; the raw value is shown once at creation. The full
// registration/code-exchange issuance UX is #252 — this is the minimal generator behind it.
model AssistantToken {
  id           String    @id @default(cuid())
  collectionId String
  // SHA-256 hex of the raw token; the raw value (prefix "stmpa_") is never stored.
  tokenHash    String    @unique
  // Optional human label, e.g. the profile/instance name it was issued for.
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("assistant_token")
}

model AssistantRegistrationCode {
  id           String    @id @default(cuid())
  collectionId String
  // SHA-256 hex of the raw code; the raw value (prefix "stmpr_") is shown once, on the page that
  // minted it, and exchanged by the extension for an AssistantToken.
  codeHash     String    @unique
  expiresAt    DateTime
  // Set when redeemed — the row is kept (not deleted) so a replayed code fails as "used", and
  // expired/used rows are swept when the collection mints its next code.
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("assistant_registration_code")
}

model CatalogName {
  id       String @id @default(cuid())
  vendorId String
  name     String
  currency String

  vendor                 CatalogVendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  catalogEditions        CatalogEdition[]
  collectionAreaCatalogs CollectionAreaCatalog[]
  primaryForAreas        CollectionArea[]        @relation("CollectionAreaPrimaryCatalog")

  @@map("catalog_name")
}

model CatalogEdition {
  id            String @id @default(cuid())
  catalogNameId String
  year          Int

  catalogName        CatalogName          @relation(fields: [catalogNameId], references: [id], onDelete: Cascade)
  stampCatalogPrices StampCatalogPrice[]

  @@map("catalog_edition")
}

model CollectionArea {
  id                   String   @id @default(cuid())
  collectionId         String
  name                 String
  parentId             String?
  description          String?
  catalogId            String?
  primaryCatalogNameId String?
  // Optional name to use for this area in auto-generated listing titles (#210), independent of the
  // internal `name`. When blank, the `{area}` token walks up the tree and uses the nearest ancestor
  // that sets one, else the area's own `name` — so internal grouping levels (e.g. "Second Republic")
  // roll up to a public area ("Poland") while siblings ("General Gouvernement") keep their own.
  titleName            String?
  // Grouping-only areas (e.g. "Europe") have `assignable = false`: they organize child
  // areas but cannot themselves receive Issues/stamps directly. Leaf areas that hold
  // material have `assignable = true`. Defaults true. Mirrors `Location.assignable` (#56, #263).
  assignable           Boolean  @default(true)
  // Custom display order among siblings under the same parent (#78). Lower sorts first;
  // ties break by name. New areas are appended (max sibling `sortOrder` + 1).
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())

  collection             Collection             @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parent                 CollectionArea?        @relation("CollectionAreaChildren", fields: [parentId], references: [id])
  children               CollectionArea[]       @relation("CollectionAreaChildren")
  translations           CollectionAreaTranslation[]
  stampAreaLinks         StampCollectionArea[]
  primaryCatalogName     CatalogName?           @relation("CollectionAreaPrimaryCatalog", fields: [primaryCatalogNameId], references: [id])
  collectionAreaCatalogs CollectionAreaCatalog[]
  collectionAreaVendors  CollectionAreaVendor[]
  issues                 Issue[]
  formatFactors          StampFormatFactor[]

  @@map("collection_area")
}

// Per-language text for an area (#265, #293). The parent's own `titleName` column stays the
// **default-language** value; a row here overrides it for one language. `language` is a free
// ISO 639-1 code, and the set of languages a collection uses is derived from its platforms
// (`Contact.titleLanguage`) — there is no separate language configuration. Cascade-deleted with
// the area. First of the per-entity translation tables; condition/certificate (#294), issue
// (#295) and stamp (#296) follow the same shape.
model CollectionAreaTranslation {
  collectionAreaId String
  language         String
  titleName        String?

  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)

  @@id([collectionAreaId, language])
  @@map("collection_area_translation")
}

model StampCollectionArea {
  stampId          String
  collectionAreaId String
  isPrimary        Boolean @default(false)

  stamp          Stamp          @relation(fields: [stampId], references: [id], onDelete: Cascade)
  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)

  @@id([stampId, collectionAreaId])
  @@map("stamp_collection_area")
}

model Stamp {
  id           String   @id @default(cuid())
  collectionId String
  parentId     String?
  subtypeId    String?
  // Per-stamp override of the subtype's `actsAsVariant` (ADR-0010). Tri-state:
  // null = inherit from the subtype; true/false = force. Effective value is
  // `actsAsVariantOverride ?? subtype.actsAsVariant`. Meaningful only for children.
  actsAsVariantOverride Boolean?
  name         String?
  issuedDay    Int?
  issuedMonth  Int?
  issuedYear   Int?
  createdAt    DateTime @default(now())
  // Denormalized numeric sort key for catalog-number ordering (#181): the parsed number of the
  // stamp's effective primary-catalog vendor (via its primary area link), else the lowest numeric
  // across its numbers, else null (sorts last). Maintained on every write that changes the stamp's
  // numbers or area link, and bulk-recomputed when an area's primary catalog changes. See ADR-0012.
  primaryCatalogSortKey Int?
  // Colnect Marketplace item-ID (#247, part of #155). Colnect has no API/import — every catalog
  // page exposes the numeric item-ID (header link `/en/stamps/stamp/<ID>-…`, `data-xid`). Stored
  // as a plain optional string, not through the catalog-vendor machinery: a Colnect item-ID is an
  // external identifier, not a priced catalog number, and it must be settable on any stamp
  // regardless of area. No uniqueness constraint. A later browser agent (#155) will populate it.
  colnectId    String?

  collection        Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parent            Stamp?                @relation("StampVariants", fields: [parentId], references: [id])
  subtype           StampSubtype?         @relation(fields: [subtypeId], references: [id], onDelete: Restrict)
  variants          Stamp[]               @relation("StampVariants")
  stampAreaLinks    StampCollectionArea[]
  catalogNumbers    StampCatalogNumber[]
  catalogPrices     StampCatalogPrice[]
  issueMemberships  IssueMember[]         @relation("IssueMemberStamp")
  items              Item[]               @relation("ItemStamp")
  variantHistoryFrom ItemVariantHistory[] @relation("ItemVariantHistoryFrom")
  variantHistoryTo   ItemVariantHistory[] @relation("ItemVariantHistoryTo")
  photos             Photo[]
  translations       StampTranslation[]

  @@index([subtypeId])
  @@index([collectionId, issuedYear, primaryCatalogSortKey])
  @@index([collectionId, primaryCatalogSortKey])
  @@map("stamp")
}

// Per-language `name` for a stamp (#296), behind the `{name}` title token. Same shape as
// `CollectionAreaTranslation` (#293): `Stamp.name` stays the default-language value and a row here
// overrides it for one language. The highest-row-count translation table — every value is typed by
// hand, so most stamps carry no rows at all and simply fall back.
model StampTranslation {
  stampId  String
  language String
  name     String?

  stamp Stamp @relation(fields: [stampId], references: [id], onDelete: Cascade)

  @@id([stampId, language])
  @@map("stamp_translation")
}

model StampCatalogNumber {
  stampId         String
  catalogVendorId String
  number          String

  stamp         Stamp         @relation(fields: [stampId], references: [id], onDelete: Cascade)
  catalogVendor CatalogVendor @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@id([stampId, catalogVendorId])
  @@map("stamp_catalog_number")
}

model StampCatalogPrice {
  id                  String  @id @default(cuid())
  stampId             String
  catalogEditionId    String
  conditionId         String
  certificateStatusId String?
  // Physical format this price is for; null = single, the only value before formats existed.
  // A row here is an **explicit** price that wins over anything `StampFormatFactor` would
  // derive — recording what a catalog actually prints for that multiple.
  formatId            String?
  price               Decimal @db.Decimal(10, 2)
  currency            String

  stamp             Stamp              @relation(fields: [stampId], references: [id], onDelete: Cascade)
  catalogEdition    CatalogEdition     @relation(fields: [catalogEditionId], references: [id], onDelete: Cascade)
  condition         StampCondition     @relation(fields: [conditionId], references: [id], onDelete: Restrict)
  certificateStatus CertificateStatus? @relation(fields: [certificateStatusId], references: [id], onDelete: Restrict)
  format            StampFormat?       @relation(fields: [formatId], references: [id], onDelete: Restrict)

  // Uniqueness on (stampId, catalogEditionId, conditionId, certificateStatusId, formatId)
  // is enforced by a raw `UNIQUE ... NULLS NOT DISTINCT` index (see migration),
  // which Prisma cannot express — so no @@unique here. Requires PostgreSQL 15+.
  @@index([stampId])
  @@index([catalogEditionId])
  @@index([conditionId])
  @@index([certificateStatusId])
  @@index([formatId])
  @@map("stamp_catalog_price")
}

model Item {
  id                  String   @id @default(cuid())
  collectionId        String
  // Human-readable internal identifier (#268): a per-collection sequence starting at 1,
  // assigned on creation from `Collection.nextItemNo` and never editable afterwards. It is
  // what a collector writes on the physical piece, so it must stay stable and must not be
  // reused — deleting a copy retires its number.
  itemNo              Int
  stampId             String
  conditionId         String
  certificateStatusId String?
  // Physical format of this copy; null = single. A multiple is one copy in one format — it is
  // never stored as, or counted as, N single copies (see `StampFormat`).
  formatId            String?
  inCollection        Boolean  @default(true)
  forSale             Boolean  @default(false)
  forTrade            Boolean  @default(false)
  // Acquisition link (ADR-0009). A purchase is one channel among several; `lotId` is a
  // nullable FK to a `PurchaseLot` (`onDelete: Restrict`). Supplier/date/price now live
  // on `Purchase`/`PurchaseLot`, superseding the flat cost fields from ADR-0007.
  lotId               String?
  // Physical delivery axis (ADR-0009 §5), orthogonal to `inCollection`/`forSale`/`forTrade`.
  // One of: ordered | in_transit | delivered | not_delivered | damaged. Defaults `delivered`
  // — a manually added copy is in hand; purchase intake sets `ordered` explicitly (and leaves
  // the copy out of the collection until it arrives).
  deliveryState       String   @default("delivered")
  // Base-currency cost-basis snapshot (ADR-0009 §2/§3). Null = pending (lot still open,
  // or the copy entered via a channel that has not written a cost yet).
  costBasis           Decimal? @db.Decimal(10, 2)
  notes               String?
  // Physical storage: at most one assignable `Location` per copy, plus an optional
  // free-text identifier within that location (e.g. a page/pocket ref like `A234`),
  // not unique. `onDelete: Restrict` guards against orphaning a stored copy (#56).
  locationId          String?
  locationRef         String?
  createdAt           DateTime @default(now())

  collection        Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stamp             Stamp                @relation("ItemStamp", fields: [stampId], references: [id], onDelete: Cascade)
  condition         StampCondition       @relation(fields: [conditionId], references: [id], onDelete: Restrict)
  certificateStatus CertificateStatus?   @relation(fields: [certificateStatusId], references: [id], onDelete: Restrict)
  format            StampFormat?         @relation(fields: [formatId], references: [id], onDelete: Restrict)
  lot               PurchaseLot?         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  location          Location?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  variantHistory    ItemVariantHistory[]
  photos            Photo[]
  // Sales module (ADR-0013). A copy is packaged into offer sets (N:M — the same copy can be
  // listed on several platforms at once) and, once sold, is recorded on exactly one `SaleLine`
  // via the `sale_line_item` join (the DB-level no-double-sale guard is the unique on `itemId`).
  offerSetMemberships OfferSetItem[]
  saleLineItems       SaleLineItem[]
  /** Manual offer attachments (#313) whose label tokens resolve from this copy. */
  offerPhotoAttachments OfferPhotoAttachment[]
  offerPhotoAttachmentTiles OfferPhotoAttachmentTile[]

  @@unique([collectionId, itemNo])
  @@index([collectionId])
  @@index([stampId])
  @@index([conditionId])
  @@index([lotId])
  @@index([locationId])
  @@index([formatId])
  @@map("item")
}

// A photo attached to an inventory copy (#112). One `Item` has many `Photo`s.
// `role` reserves two singleton slots — `front` / `back` — each holding at most one image
// (enforced by the partial-null unique on `[itemId, role]`; multiple NULLs stay distinct in
// Postgres, so titled extras are unlimited). Extras (role = null) carry a free-text `title`
// and are drag-orderable via `sortOrder`; front/back are fixed slots outside the ordering.
//
// `storageBackend` records which storage binding holds this photo's bytes. Only `filesystem`
// exists today (defaulted); it is the per-photo read seam that lets #138 add GCS with no forced
// migration (write-one-read-many). Bytes live at `<collectionId>/<photoId>/{full,thumb}.<ext>`
// via the storage interface (ADR-0011) — Prisma cascade removes this row but the domain must
// delete the stored bytes explicitly (no orphaned files).
//
// **Polymorphic owner** (#137, #311): exactly one of `itemId` / `stampId` / `offerId` is set (raw
// CHECK in the migration). A copy photo documents a specific owned piece; a stamp photo is a
// representative/reference image of the catalog stamp or variant; an offer photo is a listing image
// — a collage generated for the offer (#311) or, later, a file uploaded straight to it (#313), which
// belongs to neither a copy nor a stamp. Front/back are singleton slots *per owner*, enforced by raw
// *partial* unique `(*, role)` indexes — a plain unique on the nullable `itemId` would let every
// stamp photo collide on `(NULL, 'front')`. NULL role (titled extras, and every offer image) stays
// unlimited. A copy photo promoted to its stamp is an independent row with its own duplicated bytes
// and lifecycle.
//
// `kind` says how the bytes came to exist: an `original` upload/scan of something physical, or an
// image `generated` by the app (#311). Beyond describing the row it enables a later storage
// optimisation — generated bytes can be purged and recreated on demand, originals never can.
model Photo {
  id             String   @id @default(cuid())
  itemId         String?
  stampId        String?
  offerId        String?
  kind           String   @default("original")
  role           String?
  title          String?
  storageBackend String   @default("filesystem")
  storageKey     String
  mime           String
  width          Int
  height         Int
  sizeBytes      Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  item  Item?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stamp Stamp? @relation(fields: [stampId], references: [id], onDelete: Cascade)
  offer Offer? @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /** The photo plan entry this image occupies, when it is part of an offer's plan (#311). */
  offerPhotoEntry OfferPhotoEntry?
  /** Manual attachments (#313) that render *from* this image. A copy's scan can be attached to
   * several offers; an offer's own upload is attached exactly once. */
  offerPhotoAttachments OfferPhotoAttachment[]
  offerPhotoAttachmentTiles OfferPhotoAttachmentTile[]

  // Owner XOR (CHECK) and the per-owner partial unique `(*, role)` indexes are declared
  // in the migration SQL — Prisma cannot express partial unique indexes or check constraints.
  @@index([itemId])
  @@index([stampId])
  @@index([offerId])
  @@map("photo")
}

// Staging row for an eager, pre-Save photo upload (#112). On drop, the file is processed by
// `sharp` and its `full` + `thumb` bytes are written to the active storage backend under a
// staging key *before* any `Photo` row exists; this row records the pending bytes. On Save,
// the dialog's change-set promotes selected uploads into `Photo` rows (bytes moved to the
// permanent key). On Cancel, rows are simply left unreferenced. An hourly orphan-GC sweep
// (instrumentation `register()`) deletes rows older than a TTL plus their bytes — the only
// cleanup path for abandoned drops. Owner-agnostic, so #137 reuses it for stamp uploads.
model PhotoUpload {
  id             String   @id @default(cuid())
  collectionId   String
  storageBackend String   @default("filesystem")
  storageKey     String
  mime           String
  width          Int
  height         Int
  sizeBytes      Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("photo_upload")
}

model ItemVariantHistory {
  id          String   @id @default(cuid())
  itemId      String
  fromStampId String
  toStampId   String
  changedAt   DateTime @default(now())
  note        String?

  item      Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromStamp Stamp @relation("ItemVariantHistoryFrom", fields: [fromStampId], references: [id], onDelete: Cascade)
  toStamp   Stamp @relation("ItemVariantHistoryTo", fields: [toStampId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_variant_history")
}

// Purchase transaction header (ADR-0009 §1). A single acquisition event: optional
// supplier, one transaction currency, shared shipping cost, and a physical delivery
// status. Its inventory lines are `PurchaseLot`s; non-inventory lines are
// `PurchaseExpense`s. Scoped to a collection.
model Purchase {
  id           String   @id @default(cuid())
  collectionId String
  // Optional supplier — who the stamps were bought from. `onDelete: Restrict`: a contact
  // referenced by a purchase cannot be deleted without first detaching it (ADR-0008 §4,
  // ADR-0009).
  contactId    String?
  // Optional platform — the marketplace/intermediary a purchase went through (e.g. Allegro,
  // eBay), distinct from the supplier (ADR-0009 §1). A `Contact` carrying the `platform`
  // role; same `onDelete: Restrict` guard.
  platformId   String?
  // The moment money was spent; the FX rate is frozen as of this date.
  purchasedAt  DateTime @db.Date
  // Single transaction currency for every amount on this purchase and its lines.
  currency     String
  // Base-currency FX rate frozen at `purchasedAt` (ADR-0009 §4), reusing the
  // `ExchangeRate` mechanism (#20). Extra fractional digits like `ExchangeRate.rate`
  // (DECIMAL(65,30)); null when base == transaction currency or no rate is known yet.
  fxRateToBase Decimal?
  // Shared cost (shipping/handling) distributed across all lines by price (ADR-0009 §3).
  shippingCost Decimal? @db.Decimal(10, 2)
  // Physical delivery status of the shipment: preparing | in_transit | arrived.
  status       String   @default("preparing")
  createdAt    DateTime @default(now())

  collection Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contact    Contact?          @relation("PurchaseSupplier", fields: [contactId], references: [id], onDelete: Restrict)
  platform   Contact?          @relation("PurchasePlatform", fields: [platformId], references: [id], onDelete: Restrict)
  lots       PurchaseLot[]
  expenses   PurchaseExpense[]

  @@index([collectionId])
  @@index([contactId])
  @@index([platformId])
  @@map("purchase")
}

// Inventory line of a purchase (ADR-0009 §1): a priced lot that resolves into one or
// more `Item`s over time. Intake lifecycle `status`: open | closed. Cascade-deleted
// with its purchase.
model PurchaseLot {
  id         String @id @default(cuid())
  purchaseId String
  // Optional free-text title identifying the lot (e.g. "Album Polska 1950s", "Box lot").
  // When blank, the UI derives a display label from the copies identified into the lot,
  // falling back to a positional "Lot N" (#121).
  title      String?
  // Line price in the purchase's transaction currency.
  price      Decimal @db.Decimal(10, 2)
  // Intake status: open (items still being identified, cost pending) | closed
  // (pool allocated to items, cost-basis frozen). See ADR-0009 §3/§5.
  status     String  @default("open")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  items    Item[]

  @@index([purchaseId])
  @@map("purchase_lot")
}

// Non-inventory line of a purchase (ADR-0009 §1), e.g. a magnifier bought alongside
// the stamps: a label and a price, with no lifecycle and no items. It absorbs its
// fair share of the shared cost so it does not inflate the stamps. Separate table
// from `PurchaseLot` on purpose (ADR-0009 §1). Cascade-deleted with its purchase.
model PurchaseExpense {
  id         String  @id @default(cuid())
  purchaseId String
  label      String
  // Line price in the purchase's transaction currency.
  price      Decimal @db.Decimal(10, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_expense")
}

// A listing on one platform (ADR-0013, supersedes ADR-0012 §1–§2). The offer **owns its
// composition** directly (mirroring `Purchase ⊃ PurchaseLot ⊃ Item`): it holds N `OfferSet`s,
// each an atomic sellable unit. `platformId` is a `Contact` carrying the `platform` role. Price +
// currency are per-offer (platforms price independently). Lifecycle `state`: preparing | ready |
// active | paused | sold | withdrawn — a new offer starts `preparing` (composed but not yet
// published), is marked `ready` once assembled, then activated by hand (#188, #246). Nothing is
// shared between offers — the same copy listed elsewhere is a
// separate offer with its own sets. The derived "needs action" overlay (an active offer holding a
// set whose copy has already sold) is computed, never stored.
model Offer {
  id           String   @id @default(cuid())
  collectionId String
  platformId   String
  // The listing's own title (#209), independent of the derived set/copy label. Generated at
  // creation from the platform's title template (#210) over the seeded copies, then freely edited
  // or regenerated by hand. Null when never generated (no seed copies) — the UI falls back to the
  // label derived from the offer's sets.
  name         String?
  // The listing's long description (#266) and the seller-only private note some platforms allow on a
  // listing (#267). Both follow `name`: generated at creation from the platform's own template
  // (`Contact.descriptionTemplate` / `privateNoteTemplate`) over the seeded copies, then freely
  // edited or regenerated per field. Null when never generated — a platform with no template for a
  // field simply produces none, and the field stays manually editable.
  description  String?
  privateNote  String?
  // How `description` is written (#319): `plain` | `html` | `markdown`. Seeded from the platform at
  // creation and editable here, on the same reasoning as the photo configuration below — the text was
  // written for one platform's field, so re-pointing an existing listing at another interpretation
  // because a setting changed elsewhere is never what was meant. Drives how the description renders on
  // screen and what the copy action puts on the clipboard (ADR-0019). `privateNote` has no format.
  descriptionFormat String @default("plain")
  // Listing URL on the platform.
  url          String?
  // Asking price in `currency` (the offer's own transaction currency).
  price        Decimal  @db.Decimal(10, 2)
  currency     String
  state        String   @default("preparing")
  // The date the listing went live on the platform (#257), captured at offer creation and remembered
  // across creations. Distinct from `createdAt` (when the record was made); null when not recorded.
  listingDate  DateTime? @db.Date
  createdAt    DateTime @default(now())
  // "In active bidding" (#215): an auction-platform offer that has received a bid, committing the
  // collector before the sale is actually recorded. Independent axis from `state`/`sold` — freely
  // revertible if the auction doesn't close. Setting it flags every other active offer holding the
  // same copies as needing action, same as an actual sale collision (ADR-0013 §4).
  inActiveBidding Boolean @default(false)
  // ── Photo configuration (#308) ─────────────────────────────────────────────────────────────
  // What *this listing's* photos should look like, seeded at creation from the platform's defaults
  // and its default collage template (#307), then freely editable. Stored on the offer rather than
  // read from the platform so that changing a platform setting never silently alters offers already
  // prepared or listed — most of all the label template, since a buyer referring to a label on an
  // uploaded image must keep getting the same label after a regeneration (#315). Editing any of
  // these marks the generated photo plan out of date (#311).
  //
  // Scan sides to include: `front` | `back` | `both`.
  photoSides   String  @default("front")
  // Per-tile label templates (#312), left and right annotation; null when the platform had none
  // configured. Both resolve per copy, share one strip and one font size.
  photoLabelLeftTemplate String?
  photoLabelRightTemplate String?
  // The collage numbers copied from the chosen template (#307). All null together when the platform
  // had no default template and none has been picked on the offer yet — there is no collage to
  // render until they are set. Units follow the template: percent of the stamp height for
  // `collageGapPercent`, percent of the finished image's longest edge for `collageLabelPercent`
  // (#337, fractional), `#rrggbb` for `collageBackground`.
  collageRows  Int?
  collageColumns Int?
  collageGapPercent Int?
  collageBackground String?
  collageLabelPercent Float?
  // A manual **plan order** over this offer's photos (#313): an ordered list of stable tokens, one
  // per planned image — `c:<side>:<sortedItemIds>` for a generated collage side, `a:<attachmentId>`
  // for a manual attachment. It is an *override* of the derived order (set order + grouping), not a
  // replacement: the engine still groups the composition, then reorders the images by this list.
  // Tokens the composition no longer contains are ignored; images added since the last reorder slot
  // in after their natural predecessor. Empty (the default) means the derived order, so an offer
  // never reordered by hand behaves exactly as before.
  //
  // The order is also the **priority** order: what the platform's photo limit drops is whatever
  // falls off the end of it. And it is applied to the stored images directly (their entries are
  // renumbered), so the plan and the stored files never disagree about the upload sequence.
  photoPlanOrder String[] @default([])
  // Plan tokens marked **do not publish**: still rendered and stored — the collector wants to look
  // at them, and a collage cannot be "removed" the way a manual attachment can — but kept out of the
  // upload set. They take no upload number, are absent from the plan's ZIP, and do not count toward
  // the platform's photo limit, so hiding one can let a truncated image back in.
  photoPlanUnpublished String[] @default([])

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  platform   Contact    @relation("OfferPlatform", fields: [platformId], references: [id], onDelete: Restrict)
  sets       OfferSet[]
  saleLines  SaleLine[]
  /** Listing images owned by this offer (#311): the generated collages, and the files uploaded
   * straight to it for a manual attachment (#313). */
  photos     Photo[]
  photoEntries OfferPhotoEntry[]
  photoAttachments OfferPhotoAttachment[]
  photoGeneration OfferPhotoGeneration?

  @@index([collectionId])
  @@index([platformId])
  @@map("offer")
}

// The state of one offer's photo generation (#311) — at most one row per offer, acting as both the
// job queue entry and the state the panel reads.
//
// Generation is **explicit**: nothing renders until the collector presses Generate, which only
// enqueues (`status = 'queued'`). An in-process worker started from `instrumentation.ts` `register()`
// drains the queue, so a large offer never blocks a request. A row left `running` by a container
// restart is requeued at boot — the render is idempotent (it replaces everything it finds).
//
// `fingerprint` is the hash of the inputs the *stored* images were produced from (composition and
// order, source photo ids, the offer's photo configuration, the platform's limits). Comparing it with
// the current inputs is what marks a plan **out of date**; it is only a signal, never a trigger —
// images are served as stored and regenerated on request alone. Null until a run has succeeded.
model OfferPhotoGeneration {
  id       String @id @default(cuid())
  offerId  String @unique
  /** `queued` | `running` | `ready` | `failed`. */
  status   String @default("queued")
  fingerprint String?
  /** Progress, for the panel: images the plan asked for, and images written so far. */
  plannedCount  Int @default(0)
  renderedCount Int @default(0)
  /** Why the last run failed, shown verbatim; null once a run succeeds. */
  error    String?
  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([status, queuedAt])
  @@map("offer_photo_generation")
}

// One image of an offer's photo plan (#309, #311). Thin on purpose: `Photo` stays the record of a
// *file* (bytes, dimensions, mime, backend, owner), and everything that describes the image's place
// in the plan lives here.
//
// `role` on the photo does not describe plan images — they carry `role = null` and take their order
// from `sortOrder` here, which is the upload order for the platform.
//
// `setIds` is a plain array, not a foreign key: a group can cover several single-copy sets (#309
// chunking), and the plan is a *snapshot* of what was rendered — a set disappearing afterwards is
// exactly the staleness the fingerprint reports, not a referential error to repair.
model OfferPhotoEntry {
  id      String @id @default(cuid())
  offerId String
  /** The generated file this entry is. One entry per photo; deleting either drops the pair. */
  photoId String @unique
  /** 0-based position in the finished plan — the order the images are uploaded in. Rewritten when
   * the collector reorders the plan (#313), so the stored files, their numbering and the ZIP always
   * follow one order; the bytes are never touched by a reorder. */
  sortOrder Int
  /** The plan identity this image was rendered for (#313): `c:<side>:<sortedItemIds>` for a collage
   * side, `a:<attachmentId>` for a manual attachment. It is what matches a stored file back to its
   * planned entry — so the plan can preview a generated collage with the real image, and a reorder
   * or a do-not-publish mark can name it. Null on rows generated before tokens existed that could
   * not be backfilled; such a row simply does not match. */
  token   String?
  /** What the image was produced from: `collage` (a group of set copies) today; `copy_photo` and
   * `upload` arrive with manual attachments (#313). */
  source  String @default("collage")
  /** `front` | `back` for a collage; null for an attachment, which has no side. */
  side    String?
  /** Links the front/back pair rendered from the same copies; null when the image has no pair. */
  pairKey String?
  /** The sets that contributed copies, in plan order. */
  setIds  String[]
  /** The copies this image actually shows, in tile order (#314). `setIds` cannot answer that on its
   * own: a set larger than the collage's capacity is split into several groups that all name it. */
  itemIds String[]
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([offerId, sortOrder])
  @@map("offer_photo_entry")
}

// A manual photo attachment on an offer (#313) — an image the collector put in the plan by hand,
// rather than one a rule produced.
//
// Three modes, one row shape. `copy_photo` points at a *specific* photo of a copy in the offer (a
// front, a back, or an extra), so a perforation or a cancel can be shown on its own; its label
// tokens resolve from that copy. `upload` points at an image uploaded straight to the offer — an
// offer-owned `Photo` with `kind = original` — which has no copy at all, so inventory tokens
// resolve empty and only the literal text of the label template renders. `manual_collage` (#331) is a set
// of chosen photos — either kind, mixed freely — combined into **one** image at a column count the
// collector picks: the grouping the automatic rules do not produce. Its tiles are `tiles` rows and
// its `photoId` is null, because there is no single image; the other two modes are the same shape
// with one tile, which is what `photoId` is shorthand for.
//
// The row is the *plan entry*, not the image: this is where the derived/manual distinction lives,
// which is what lets a regeneration (#315) recompute the collages and leave these alone. Being
// manual, they are also protected from the platform's photo-count truncation (#309) — a collage is
// the output of a rule, an attachment was added deliberately.
//
// `photoId` cascades on purpose. Deleting a copy's scan removes the attachment from *future* plans;
// the image already generated from it is a separate `Photo` and survives, which is exactly the
// staleness the fingerprint reports. An `upload` attachment's photo exists only for the attachment,
// so removing the attachment deletes that row and its bytes explicitly.
model OfferPhotoAttachment {
  id      String @id @default(cuid())
  offerId String
  /** 0-based position in the finished plan. Out-of-range values clamp to the end (#309). */
  sortOrder Int
  /** `copy_photo` | `upload` | `manual_collage`. */
  source  String
  /** The image this attachment shows: a copy's own photo, or the offer's own upload. Null for a
   * `manual_collage` (#331), whose images are its `tiles`. */
  photoId String?
  /** The copy whose data annotates the tile (#312); null for an upload and for a collage, whose
   * tiles each name their own. */
  itemId  String?
  /** How many tiles per row a `manual_collage` is laid out at (#331); null for the single-image modes.
   * Rows are not stored: the contents are explicit here, so the row count follows from the two. */
  collageColumns Int?
  /** The collector's own caption for the attachment, shown in the plan. Never drawn on the image —
   * the tile's annotation comes from the offer's label templates like every other tile. */
  title   String?
  createdAt DateTime @default(now())

  offer Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  photo Photo? @relation(fields: [photoId], references: [id], onDelete: Cascade)
  item  Item?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tiles OfferPhotoAttachmentTile[]

  // The per-mode shape (which of `photoId` / `itemId` / `collageColumns` each mode carries) is a
  // CHECK in the migration — Prisma cannot express it.
  @@index([offerId, sortOrder])
  @@index([photoId])
  @@index([itemId])
  @@map("offer_photo_attachment")
}

// One tile of a manual collage attachment (#331), in the order the collector arranged them — tiles
// fill the collage left to right, row by row.
//
// It carries its own `source` for the same reason the attachment does: it says who owns the bytes.
// An `upload` tile's photo is offer-owned (`kind = original`) and exists for this collage alone, so
// removing the attachment deletes that row and its bytes; a `copy_photo` tile only ever pointed at
// the copy's own scan and leaves it be.
model OfferPhotoAttachmentTile {
  id           String @id @default(cuid())
  attachmentId String
  /** 0-based, dense. */
  sortOrder    Int
  /** `copy_photo` | `upload`. */
  source       String
  photoId      String
  /** The copy whose data annotates this tile (#312); null for an uploaded image. */
  itemId       String?

  attachment OfferPhotoAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  photo      Photo                @relation(fields: [photoId], references: [id], onDelete: Cascade)
  item       Item?                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([attachmentId, sortOrder])
  @@index([photoId])
  @@index([itemId])
  @@map("offer_photo_attachment_tile")
}

// One atomic sellable unit inside an offer (ADR-0013). A set holds one or more `Item`s that sell
// **together and indivisibly** — a series / *komplet* never breaks apart. There is no unit/quantity
// discriminator: a single-stamp offer is one 1-item set, a series is one N-item set, and a
// "quantity" listing is simply many sets. Cascade-deleted with its offer.
model OfferSet {
  id      String  @id @default(cuid())
  offerId String
  // Optional free-text label; the UI derives one from the copies when blank.
  title   String?
  // Explicit, user-controlled position within the offer (#306), 0-based and dense. Sets are what a
  // buyer sees as "the second lot" and what the photo plan (#309) renders as image groups, so the
  // order is canonical and persisted rather than incidental creation order. New sets append.
  sortOrder Int @default(0)

  offer     Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  items     OfferSetItem[]
  saleLines SaleLine[]

  @@index([offerId])
  @@map("offer_set")
}

// The physical copies in an offer set (ADR-0013). **N:M** — unlike `PurchaseLot`, which owns its
// items, a copy can belong to sets across several offers at once (listed on multiple platforms).
// This is the cross-platform thread: selling a copy retires it globally (`sale_line_item.itemId`
// UNIQUE) and every other offer whose set still holds it surfaces as needing action. Cascade-
// deleted with either side.
model OfferSetItem {
  offerSetId String
  itemId     String
  // Position of the copy inside its set (#306) — the tile order in a collage, the copy order in a
  // generated listing text. **Nullable on purpose**: `null` means "derive from the catalog sort
  // key" (`stamp.primaryCatalogSortKey`), a value means the collector hand-corrected it. The
  // distinction is what tells "this is how catalog order came out" from "this is how I want it".
  // Kept all-or-nothing per set: reordering writes a value for every copy in the set, and the
  // reset action clears the whole set back to null. A copy added to a hand-ordered set appends.
  sortOrder  Int?

  offerSet OfferSet @relation(fields: [offerSetId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([offerSetId, itemId])
  @@index([itemId])
  @@map("offer_set_item")
}

// A sale transaction (ADR-0012). Single platform, single currency. Shared amounts —
// buyer-paid handling (+), my actual shipping (−), platform commission (−, entered manually) —
// are allocated proportionally to line sale prices by the pure engine (#163). `fxRateToBase`
// is frozen at `soldAt` (#20). A single sale can span multiple offers within the one platform.
model Sale {
  id            String   @id @default(cuid())
  collectionId  String
  platformId    String
  // Optional buyer — the `Contact` (carrying the `buyer` role) the sale went to. `onDelete:
  // Restrict`: a referenced buyer cannot be deleted without first detaching it (like the
  // purchase supplier). Null when the buyer is unknown/anonymous.
  buyerId       String?
  // The moment of sale; the FX rate is frozen as of this date.
  soldAt        DateTime @db.Date
  // Single transaction currency for every amount on this sale and its lines.
  currency      String
  // The transaction / order number in the external system (e.g. a Delcampe or Allegro order id),
  // free-text. Null when not recorded. Handy for reconciling against the marketplace.
  externalRef   String?
  // Base-currency FX rate frozen at `soldAt` (DECIMAL(65,30), like `ExchangeRate.rate`);
  // null when base == transaction currency or no rate is known yet.
  fxRateToBase  Decimal?
  // Buyer-paid handling/postage collected from the buyer (adds to proceeds, +). The buyer-side
  // proceeds have exactly one anchor (#205): either this handling is stored directly, or the total
  // the buyer paid is stored in `buyerPaidTotal` and handling is derived (total − gross). At most
  // one of the two is non-null.
  buyerHandling Decimal? @db.Decimal(10, 2)
  // The full amount the buyer paid, when that is the anchor (#205). When set, buyer handling is
  // derived = this − gross (sum of line prices) and recomputed as sold sets change, so `buyerHandling`
  // is null. Null when handling is entered directly.
  buyerPaidTotal Decimal? @db.Decimal(10, 2)
  // My actual shipping/postage cost, in `shippingCurrency` (subtracts from proceeds, −). Entered in
  // any currency (#206) — converted straight to the base currency for profit, not to the sale's
  // transaction currency.
  shippingCost  Decimal? @db.Decimal(10, 2)
  // Currency `shippingCost` was paid in (#206), independent of the sale's transaction currency.
  // Null when no shipping cost is recorded; defaults to the sale currency in the UI.
  shippingCurrency String?
  // Base-currency FX rate for `shippingCurrency`, frozen at `soldAt` (DECIMAL(65,30), like
  // `fxRateToBase`). Null when `shippingCurrency == base` (identity) or no rate is known (#206).
  shippingFxRateToBase Decimal?
  // Platform commission/fees, entered manually per transaction (subtracts, −).
  commission    Decimal? @db.Decimal(10, 2)
  // Fulfillment status in lifecycle order (#191): ordered → paid → packed → sent → received.
  // Defaults `ordered` — a freshly recorded sale is placed but not yet paid/shipped. Each change
  // also appends a `SaleStatusEvent` so the transition timeline is preserved for reporting/audit.
  status        String   @default("ordered")
  createdAt     DateTime @default(now())

  collection    Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  platform      Contact           @relation("SalePlatform", fields: [platformId], references: [id], onDelete: Restrict)
  buyer         Contact?          @relation("SaleBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  lines         SaleLine[]
  statusEvents  SaleStatusEvent[]

  @@index([collectionId])
  @@index([platformId])
  @@index([buyerId])
  @@map("sale")
}

// Append-only fulfillment-status transition log for a sale (#191). One row per status change,
// stamped at the moment of transition, so the sale's progression through ordered → paid → packed
// → sent → received is preserved for future reporting/audit. Cascades with its sale.
model SaleStatusEvent {
  id        String   @id @default(cuid())
  saleId    String
  // The status the sale moved to at `changedAt` (same token set as `Sale.status`).
  status    String
  changedAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_status_event")
}

// One line of a sale (ADR-0013): the offer set that went, the offer it sold through, its line
// sale price (sale currency), and the exact physical `Item`s that left (via `sale_line_item`).
// One line per set sold — a quantity offer selling K units records K lines.
model SaleLine {
  id         String  @id @default(cuid())
  saleId     String
  // The offer the sale came through; `SetNull` so a historical sale survives offer cleanup.
  offerId    String?
  // The offer set sold; `Restrict` so a sold set cannot be deleted out from under the sale record.
  offerSetId String
  // Line sale price in the sale's transaction currency.
  price      Decimal @db.Decimal(10, 2)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  offer    Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerSet OfferSet @relation(fields: [offerSetId], references: [id], onDelete: Restrict)
  items    SaleLineItem[]

  @@index([saleId])
  @@index([offerId])
  @@index([offerSetId])
  @@map("sale_line")
}

// The specific physical copies that left on a sale line (ADR-0012). The **no-double-sale**
// invariant is a DB-level `@@unique([itemId])`: a copy can appear on at most one sale line
// ever. `onDelete: Restrict` on the item so a sold copy cannot be deleted while the sale
// record references it; the join cascades with its sale line.
model SaleLineItem {
  saleLineId String
  itemId     String
  // Whether this individual physical copy has been packed (#192). Independent of the sale's overall
  // fulfillment status (#191): packing happens per copy, and a sale can span many copies packed at
  // different times. When every copy of a sale is packed the UI hints that the sale can advance to
  // the `packed` status, but never changes `Sale.status` automatically.
  packed     Boolean  @default(false)

  saleLine SaleLine @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([saleLineId, itemId])
  @@unique([itemId])
  @@map("sale_line_item")
}

model Contact {
  id               String   @id @default(cuid())
  collectionId     String
  name             String
  notes            String?
  email            String?
  phone            String?
  // Roles are independent, combinable boolean flags (a contact can be several at
  // once), mirroring the disposition flags on `Item` (ADR-0007 §4, ADR-0008).
  buyer            Boolean  @default(false)
  seller           Boolean  @default(false)
  exchangePartner  Boolean  @default(false)
  auctionHouse     Boolean  @default(false)
  platform         Boolean  @default(false)
  other            Boolean  @default(false)
  // Fixed transaction currency for a platform (#196). Every offer and sale routed to this
  // platform inherits and locks this currency, guaranteeing offer↔sale consistency. Nullable —
  // only platforms carry it, and it is required (domain-enforced, not a DB constraint) before the
  // first offer/sale on the platform. A per-offer/-sale `currency` snapshot preserves history, so
  // changing this later leaves existing offers/sales untouched.
  platformCurrency String?
  // Free-text title template for this platform's listings (#210), e.g. `{catalog} {name} {year}
  // {condition}`. Tokens resolve over an offer's (or set's) copies to pre-fill the offer name (#209)
  // and set/lot titles. Nullable — only platforms use it, and a null template falls back to the
  // built-in default (`DEFAULT_TITLE_TEMPLATE`). See `offer-title-template.ts`.
  titleTemplate    String?
  // Templates for the platform's longer generated listing texts: the public description (#266) and
  // the seller-only private note (#267). Same `{token}` engine as `titleTemplate`, but multi-line and
  // able to repeat a block per set / copy (`{#set}…{/set}`, `{#copy}…{/copy}`). Nullable, and blank
  // here means **generate nothing** (there is no built-in default to fall back to) — which is also
  // how a platform that has no private-note feature at all is configured.
  descriptionTemplate String?
  privateNoteTemplate String?
  // What the platform's description field accepts (#319): `plain` | `html` | `markdown`. Marketplaces
  // disagree — some show plain text with its line breaks, some take raw HTML, some paste rich text —
  // and the app renders and copies the description accordingly (ADR-0019). **Seeded** onto every
  // offer created on this platform, like the photo defaults: changing it here never re-interprets a
  // listing already written. The private note (#267) has no format; it is always plain.
  descriptionFormat String @default("plain")
  // Language this platform's generated listing text is written in (#265, #293) — a free ISO 639-1
  // code (`"pl"`, `"en"`). Nullable; only platforms carry it. Title tokens resolve translated
  // entity text for this language and fall back to the entity's default-language value when a
  // translation is missing. The collection's language set is the distinct set of these values, so
  // entity forms only offer per-language inputs for languages actually in use.
  titleLanguage    String?
  // ── Offer photos (#308) ────────────────────────────────────────────────────────────────────
  // Hard technical limits on what this platform physically accepts. All optional (null = no limit),
  // and **not** seeded onto offers: they describe the platform, so the renderer reads them live
  // (#310). They say nothing about how many stamps go on one collage — that is the collage
  // template's job (#307).
  maxPhotos        Int?
  // Longest edge of an uploaded image, in pixels.
  maxPhotoEdge     Int?
  // Maximum file size per image, in mebibytes — the unit platforms actually quote, never bytes.
  maxPhotoFileSizeMib Int?
  // Defaults **seeded** onto every offer created on this platform, exactly as the listing-text
  // templates seed the offer's texts: which scan sides to include (`front` | `back` | `both`) and
  // the two per-tile label templates (#312). Changing any of them here never touches an offer
  // already prepared — a buyer referring to a label on an uploaded image must keep getting that
  // label. A tile's strip carries two independent annotations, drawn flush left and flush right;
  // either may be null, and a lone one is centred.
  photoSides       String  @default("front")
  tileLabelLeftTemplate String?
  tileLabelRightTemplate String?
  // Which collage template (#307) a new offer on this platform copies its render numbers from.
  // Null — or a template later deleted — leaves the offer without collage numbers until one is
  // picked on the offer itself.
  defaultCollageTemplateId String?
  createdAt        DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  defaultCollageTemplate CollageTemplate? @relation("PlatformDefaultCollage", fields: [defaultCollageTemplateId], references: [id], onDelete: SetNull)
  // Purchases sourced from this contact (supplier). `onDelete: Restrict` on the FK
  // (from `Purchase`) means a referenced contact cannot be deleted without first
  // detaching it (ADR-0008 §4, ADR-0009 — supersedes the old `Item` acquisition link).
  purchases         Purchase[] @relation("PurchaseSupplier")
  // Purchases routed through this contact as their platform (e.g. Allegro). Same
  // `onDelete: Restrict` guard from the `Purchase.platformId` FK.
  platformPurchases Purchase[] @relation("PurchasePlatform")
  // Sales module (ADR-0012): offers listed on this contact's platform, and sales
  // transacted through it. Both FKs are `onDelete: Restrict` (same detach-before-delete
  // guard as purchases).
  offers            Offer[]    @relation("OfferPlatform")
  salesPlatform     Sale[]     @relation("SalePlatform")
  // Sales made to this contact as the buyer (ADR-0012, #166). Same detach-before-delete guard
  // via the `Sale.buyerId` FK (`onDelete: Restrict`).
  salesBuyer        Sale[]     @relation("SaleBuyer")

  // `name` is unique per collection (see migration).
  @@unique([collectionId, name])
  @@index([collectionId])
  @@index([defaultCollageTemplateId])
  @@map("contact")
}

model Location {
  id           String   @id @default(cuid())
  collectionId String
  name         String
  parentId     String?
  description  String?
  // Grouping-only nodes (e.g. a cabinet) have `assignable = false`; leaf storage
  // that can hold copies (e.g. a stockbook) has `assignable = true`. Defaults true (#56).
  assignable   Boolean  @default(true)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // Adjacency-list hierarchy (same pattern as `CollectionArea`). Deleting a location
  // with children or items is blocked in the domain layer; the FK is SetNull as a
  // backstop, matching `CollectionArea`.
  parent     Location?  @relation("LocationChildren", fields: [parentId], references: [id])
  children   Location[] @relation("LocationChildren")
  items      Item[]

  @@index([collectionId])
  @@map("location")
}

model CollectionAreaCatalog {
  collectionAreaId String
  catalogNameId    String

  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  catalogName    CatalogName    @relation(fields: [catalogNameId], references: [id], onDelete: Cascade)

  @@id([collectionAreaId, catalogNameId])
  @@map("collection_area_catalog")
}

model CollectionAreaVendor {
  collectionAreaId String
  catalogVendorId  String
  areaPrefix       String?

  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  catalogVendor  CatalogVendor  @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@id([collectionAreaId, catalogVendorId])
  @@map("collection_area_vendor")
}

model Issue {
  id               String   @id @default(cuid())
  collectionId     String
  collectionAreaId String
  name             String?
  year             Int?
  isAutoCreated    Boolean  @default(false)
  createdAt        DateTime @default(now())
  // Denormalized numeric sort key for catalog-number ordering (#181): the parsed number of the
  // issue's effective primary-catalog vendor, else the lowest numeric across its numbers, else
  // null (sorts last). Maintained on every write that changes the issue's numbers or area, and
  // bulk-recomputed when an area's effective primary catalog changes. See ADR-0012.
  primaryCatalogSortKey Int?

  collection     Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionArea CollectionArea       @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  members        IssueMember[]
  catalogNumbers IssueCatalogNumber[]
  translations   IssueTranslation[]
  formatFactors  StampFormatFactor[]

  @@index([collectionId, year, primaryCatalogSortKey])
  @@index([collectionId, primaryCatalogSortKey])
  @@map("issue")
}

// Per-language `name` for an issue (#295), behind the `{issueName}` title token. Same shape as
// `CollectionAreaTranslation` (#293): `Issue.name` stays the default-language value and a row here
// overrides it for one language.
model IssueTranslation {
  issueId  String
  language String
  name     String?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([issueId, language])
  @@map("issue_translation")
}

model IssueCatalogNumber {
  issueId         String
  catalogVendorId String
  firstNumber     String
  lastNumber      String?

  issue         Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  catalogVendor CatalogVendor @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@id([issueId, catalogVendorId])
  @@map("issue_catalog_number")
}

model IssueMember {
  issueId                 String
  stampId                 String
  requiredForCompleteness Boolean @default(false)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  stamp Stamp @relation("IssueMemberStamp", fields: [stampId], references: [id], onDelete: Cascade)

  @@id([issueId, stampId])
  @@map("issue_member")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  collectionId String
  fromCurrency String
  toCurrency   String
  rate         Decimal
  fetchedAt    DateTime

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, fromCurrency, toCurrency])
  @@map("exchange_rate")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
