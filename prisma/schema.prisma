generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  collections   Collection[]

  @@map("user")
}

model Collection {
  id           String   @id @default(cuid())
  slug         String
  name         String
  baseCurrency String
  // The language the collection's own entity text is written in (#293) — a free ISO 639-1 code.
  // `CollectionArea.titleName` and the other default-language columns hold text in this language,
  // so a platform listing in it needs no translation: it is excluded from the per-language inputs
  // and resolves straight to the default value. Existing collections were backfilled to "en".
  defaultLanguage String @default("en")
  // Duplicate catalog-number policy (#85): "warn" (default) shows a non-blocking
  // warning; "block" prevents saving a stamp whose catalog identity (vendor +
  // effective area prefix + number) already exists in the collection.
  duplicateCatalogMode String @default("warn")
  // Allocation counter for the per-collection copy numbering (#268). Handing out `Item.itemNo`
  // is an atomic bump of this column (`UPDATE ... SET next_item_no = next_item_no + n RETURNING`),
  // never `max(itemNo) + 1` — a deleted copy must not hand its number to the next one, and a bulk
  // intake takes a whole range in one statement.
  nextItemNo   Int      @default(1)
  // How many digits an internal copy number is padded to for display (#268). Purely a display
  // choice — the stored `Item.itemNo` is the bare integer — so changing it never touches a row.
  itemNoPad    Int      @default(5)
  // The resolution this collection's cards are scanned at (#598), in dots per inch — the scale a
  // measurement taken on a scan is converted with. **Stated, never inferred**: no EXIF is read
  // anywhere, because #574's source corpus claimed a resolution its images did not have, and a
  // gauge is an absolute claim where philately separates perf 11½ from perf 12 (under 4%).
  //
  // A prefilled default rather than a fact about a file: one scanner profile is used almost always,
  // so the field is right without being touched. It is edited **in the measuring tool**, where it
  // is on view beside the result it produced — and a change made there holds for that sitting only.
  // Writing this column is a Settings act, so one old scan measured once cannot silently redefine
  // what every later measurement assumes.
  //
  // Not nullable: unlike the retention periods below, there is no instance-wide scanner and nothing
  // for *I have no opinion* to defer to. 1200 dpi is what this app's own reference scans were made
  // at and what a flatbed set up for stamps is usually left on.
  scanDpi      Int      @default(1200)
  // How long this collection's closed offers keep their generated listing images (#577), holding
  // **exactly** what `STAMPORAMA_CLOSED_OFFER_PHOTO_TTL_DAYS` holds — `off`/`never` for keep for
  // ever, `0` to purge at the next sweep, otherwise days — so one parser reads both and the two
  // sides cannot come to disagree. This is the first **nullable** setting on `Collection`, and the
  // difference is the point: `itemNoPad` and its kind have a default that means something for every
  // collection, while this one has to be able to say *I have no opinion, use the instance's*, which
  // no default can express. Null therefore defers to the environment variable and then to the
  // built-in seven days, so an operator who configured one keeps exactly what they configured.
  closedOfferPhotoTtlDays String?
  // How long this collection keeps the retained card scans of a batch it has finished with (#578),
  // in the *same* vocabulary as the column above — `off`/`never` for keep for ever, `0` to sweep at
  // the next pass, otherwise days — because two retention settings on one screen where `0` means
  // opposite things would be a trap. A separate column all the same: a collector may keep card scans
  // for ever while purging offer images weekly, and one column could not say both.
  //
  // Null defers to `STAMPORAMA_SCAN_SHEET_TTL_DAYS` and then to the built-in default, which for this
  // setting is **keep for ever** — a scan is a source, not output (#137), so the sweep ships off and
  // is switched on by the collector who has the disk problem.
  scanSheetTtlDays String?
  // The band a bid recommendation is stated as, in percent of the lot's fair figure (#508;
  // ADR-0029 §3, §4). Below the floor a lot is a bargain, past the ceiling it belongs to somebody
  // else. A percentage of `fair` rather than the market's own spread: at the sample sizes this
  // evidence has, a measured range would be one or two results wearing a statistic's name (§4).
  // Floor ≤ 100 ≤ ceiling is deliberately not enforced — "I only buy at 40–60% of what it is
  // worth" is a trading style, not a mistake.
  bidFloorPercent   Int @default(75)
  bidCeilingPercent Int @default(125)
  // Catalogue → anchor while the collection has no ratio evidence at all (ADR-0029 §2, bucket 5).
  // The realization ratio itself is *learned* from recorded results (#520) and is deliberately not
  // a setting: a single configured percentage is a market opinion stated once and wrong nearly
  // everywhere, which is what a base of recorded hammer prices exists to replace. 100 so that,
  // until anything has been learned, a catalogue-anchored recommendation is exactly what the
  // "ceiling ← catalogue value" quick fill (#370) already writes.
  bidFallbackPercent Int @default(100)
  // The same allocation counter for `Offer.offerNo` (#416), bumped the same atomic way and for the
  // same reason: an offer number that has been published in a marketplace note must never be handed
  // to a different offer. Separate from `nextItemNo` because copies and listings are counted
  // separately — sharing one sequence would make both numbers jump for no reason a collector can see.
  nextOfferNo  Int      @default(1)
  // The same counter, once per remaining major entity (#432): `Issue.issueNo`,
  // `Purchase.purchaseNo`, `Sale.saleNo`, `AuctionLot.auctionLotNo`. Bumped by the same atomic
  // `UPDATE ... RETURNING` and never `max + 1`, for the reason #268 gives: a number a collector has
  // quoted — in the quick-jump box (#431), in a note, out loud — must not later mean something else.
  // One counter per entity rather than one shared sequence: a collector counts purchases and issues
  // separately, and a shared sequence would make every number jump for reasons nothing on screen
  // explains.
  nextIssueNo    Int    @default(1)
  nextPurchaseNo Int    @default(1)
  nextSaleNo     Int    @default(1)
  nextAuctionLotNo Int  @default(1)
  ownerId      String
  createdAt    DateTime @default(now())

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  collectionAreas CollectionArea[]
  catalogVendors  CatalogVendor[]
  stamps          Stamp[]
  issues          Issue[]
  exchangeRates   ExchangeRate[]
  stampConditions StampCondition[]
  certificateStatuses CertificateStatus[]
  stampFormats    StampFormat[]
  stampFormatFactors StampFormatFactor[]
  stampSubtypes   StampSubtype[]
  checklists      Checklist[]
  wants           Want[]
  acceptanceProfiles AcceptanceProfile[]
  collageTemplates CollageTemplate[]
  refCardTemplates RefCardTemplate[]
  items           Item[]
  contacts        Contact[]
  locations       Location[]
  purchases       Purchase[]
  offers          Offer[]
  sales           Sale[]
  shippingMethods ShippingMethod[]
  carriers        Carrier[]
  auctionSales    AuctionSale[]
  colnectCatalogMappings ColnectCatalogMapping[]
  colnectConditionMappings ColnectConditionMapping[]
  assistantTokens AssistantToken[]
  assistantRegistrationCodes AssistantRegistrationCode[]
  allegroConnection AllegroConnection?
  allegroSyncState  AllegroSyncState?
  allegroOrders     AllegroOrder[]
  allegroOrderLines AllegroOrderLine[]
  allegroListings   AllegroListing[]
  allegroListingProfiles AllegroListingProfile[]
  delcampeListingProfiles DelcampeListingProfile[]
  delcampeListings  DelcampeListing[]
  delcampeImportState DelcampeImportState?
  platformCategoryLessons PlatformCategoryLesson[]
  allegroCategoryParameterMemories AllegroCategoryParameterMemory[]

  @@unique([ownerId, slug])
  @@map("collection")
}

model StampCondition {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String
  sortOrder    Int

  collection    Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogPrices StampCatalogPrice[]
  items         Item[]
  translations  StampConditionTranslation[]
  formatFactors StampFormatFactor[]
  auctionLotLines AuctionLotLine[]
  colnectMapping ColnectConditionMapping?
  platformCategoryLessons PlatformCategoryLesson[]
  wantAcceptance WantCondition[]
  profileAcceptance AcceptanceProfileCondition[]
  /** The condition half of a hand-picked listing variant — the cheapest variant is a per-condition
   *  answer, so overriding it is too. See {@link OfferListedVariant}. */
  offerListedVariants OfferListedVariant[]

  @@index([collectionId])
  @@map("stamp_condition")
}

// A physical **format** — how many stamps are attached to each other and how (horizontal pair,
// block of four, strip of three…). Supersedes the #135 convention, under which a multiple was
// recorded as its own `Stamp` with a self-descriptive number (`245 x4`): that collapses two
// independent axes into one and produces `formats × variant-tree nodes` stamps, while making
// "a pair, variant not yet identified" inexpressible — a pair of `309BP` is not a child of a
// pair of `309B`. Zusammendrucke / se-tenant that carry their **own** catalog number (Michel
// `S`/`W`/`K`/`Zd`) are unaffected and stay their own `Stamp`; they really are distinct entries.
//
// A format is a peer of `StampCondition`, not a quantity. A multiple is **never** decomposed
// into N singles — there is deliberately no unit count, and nothing anywhere multiplies or
// divides by one. Completeness asks "do I have the whole series in pairs?" exactly the way it
// asks "in MNH?", so format is a breakdown dimension alongside condition, not a factor applied
// to counts.
//
// There is no "single" row, and none is seeded: a null `formatId` **means single**, exactly as a
// null `certificateStatusId` means "no certificate" (ADR-0006 §2). That keeps every pre-existing
// price and copy valid with no backfill, and extends the existing `NULLS NOT DISTINCT` idiom to
// the new column instead of inventing a second convention.
model StampFormat {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String
  sortOrder    Int

  collection    Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogPrices StampCatalogPrice[]
  items         Item[]
  factors       StampFormatFactor[]
  translations  StampFormatTranslation[]
  auctionLotLines AuctionLotLine[]
  wantAcceptance WantFormat[]
  profileAcceptance AcceptanceProfileFormat[]

  @@index([collectionId])
  @@map("stamp_format")
}

// Per-language `name` / `abbreviation` for a format (#344), behind the `{format}` / `{formatAbbr}`
// tokens (#345) — a German listing should read "Viererblock", not "Block of 4". See
// {@link StampConditionTranslation}: identical shape, and the two fields fall back
// **independently**, because a language often translates the name and keeps the abbreviation.
model StampFormatTranslation {
  stampFormatId String
  language      String
  name          String?
  abbreviation  String?

  stampFormat StampFormat @relation(fields: [stampFormatId], references: [id], onDelete: Cascade)

  @@id([stampFormatId, language])
  @@map("stamp_format_translation")
}

// The multiplier that derives a format's catalog price from the single's, when no explicit price
// was recorded for that format. Catalogs are written this way — Michel Spezial prints one
// Viererblock factor per issue and an explicit price only where the multiple deviates — so
// following the source keeps entry proportional to what is actually published, instead of
// demanding a condition × certificate × format grid per stamp.
//
// One table with **nullable anchors**: the all-nulls row *is* the collection default, so there is
// a single mechanism and a single editor rather than a `defaultFactor` column plus an override
// table. A row applies only when every anchor it sets matches the stamp being priced — the area
// anchor matching any descendant of itself, so a factor on "German Reich" covers "Infla" unless
// Infla sets its own.
//
// Resolution is a **fixed precedence order**, not a specificity score: candidates are compared on
// `(issue set?, area depth, condition set?)` lexicographically and the first difference wins.
// Scoring independent dimensions against each other produces orderings nobody can predict; a
// fixed order is always explainable in one line in the UI ("from: Infla 1923 → block of 4").
// Note the consequence, chosen deliberately: *where* beats *for which condition*, so a factor
// pinned to an issue outranks a collection-wide factor pinned to "used".
model StampFormatFactor {
  id           String  @id @default(cuid())
  collectionId String
  formatId     String
  // Multiplier applied to the single's price. Four decimals because catalog factors are not
  // always whole (a pair is commonly 2.2×, a block 4.5×).
  factor       Decimal @db.Decimal(10, 4)
  // Anchors. Null means "any" — the dimension simply does not narrow this row.
  collectionAreaId String?
  issueId          String?
  conditionId      String?

  collection     Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  format         StampFormat     @relation(fields: [formatId], references: [id], onDelete: Cascade)
  collectionArea CollectionArea? @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  issue          Issue?          @relation(fields: [issueId], references: [id], onDelete: Cascade)
  condition      StampCondition? @relation(fields: [conditionId], references: [id], onDelete: Restrict)

  // Uniqueness on (collectionId, formatId, collectionAreaId, issueId, conditionId) is enforced by
  // a raw `UNIQUE ... NULLS NOT DISTINCT` index (see migration) for the same reason as
  // `stamp_catalog_price`: three of the five columns are nullable, and Postgres would otherwise
  // treat every null-anchored row as distinct from every other. Requires PostgreSQL 15+.
  @@index([collectionId])
  @@index([formatId])
  @@index([collectionAreaId])
  @@index([issueId])
  @@index([conditionId])
  @@map("stamp_format_factor")
}

// Per-language `name` / `abbreviation` for a condition (#294), behind the `{condition}` and
// `{conditionAbbr}` title tokens. Same shape as `CollectionAreaTranslation` (#293): the parent's
// own columns stay the default-language values, a row here overrides them for one language, and
// each field falls back **independently** — a language may translate the name but keep the
// abbreviation (`MNH` is often left as-is).
model StampConditionTranslation {
  stampConditionId String
  language         String
  name             String?
  abbreviation     String?

  stampCondition StampCondition @relation(fields: [stampConditionId], references: [id], onDelete: Cascade)

  @@id([stampConditionId, language])
  @@map("stamp_condition_translation")
}

model CertificateStatus {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String
  sortOrder    Int

  collection    Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogPrices StampCatalogPrice[]
  items         Item[]
  auctionLotLines AuctionLotLine[]
  translations  CertificateStatusTranslation[]
  wantAcceptance WantCertificateStatus[]
  profileAcceptance AcceptanceProfileCertificateStatus[]

  @@index([collectionId])
  @@map("certificate_status")
}

// Per-language `name` / `abbreviation` for a certificate status (#294), behind `{certificate}` and
// `{certificateAbbr}`. See {@link StampConditionTranslation} — identical shape and fallback rules.
model CertificateStatusTranslation {
  certificateStatusId String
  language            String
  name                String?
  abbreviation        String?

  certificateStatus CertificateStatus @relation(fields: [certificateStatusId], references: [id], onDelete: Cascade)

  @@id([certificateStatusId, language])
  @@map("certificate_status_translation")
}

model StampSubtype {
  id            String  @id @default(cuid())
  collectionId  String
  name          String
  actsAsVariant Boolean @default(true)
  isDefault     Boolean @default(false)
  sortOrder     Int

  collection   Collection                @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stamps       Stamp[]
  translations StampSubtypeTranslation[]
  platformCategoryLessons PlatformCategoryLesson[]

  @@index([collectionId])
  // Exactly-one-default is enforced by a partial unique index written by hand in
  // the migration SQL (Prisma cannot express partial indexes):
  //   CREATE UNIQUE INDEX "stamp_subtype_one_default"
  //     ON "stamp_subtype"("collectionId") WHERE "isDefault";
  @@map("stamp_subtype")
}

// Per-language `name` for a subtype (#338), behind the `{subtype}` token (#339). See
// {@link IssueTranslation} — identical shape and fallback rules, and one translatable column
// because a subtype has no abbreviation.
model StampSubtypeTranslation {
  stampSubtypeId String
  language       String
  name           String?

  stampSubtype StampSubtype @relation(fields: [stampSubtypeId], references: [id], onDelete: Cascade)

  @@id([stampSubtypeId, language])
  @@map("stamp_subtype_translation")
}

// A named, reusable collage render preset (#307). How many stamps fit sensibly on one collage is a
// property of **stamp size**, not of the platform or the offer — many small definitives fit where
// few large commemoratives do — so the numbers live in templates the collector maintains once,
// rather than being set by hand on every offer.
//
// Two things to keep in mind:
//
//  - **Capacity, not frame.** `rows` × `columns` is a maximum. A set of 4 copies under a 5×4
//    template produces a one-row collage sized to its contents, not a padded 5×4 canvas (#310).
//  - **Two ways to read that maximum** (#413). In `fixed` mode `columns` is also the shape: rows are
//    filled to that width and the last one is short. In `auto` mode the two numbers are bounds only,
//    and the renderer picks the width from the tiles actually on the image — so one template stops
//    needing a hand-adjustment every time an offer holds a different number of stamps.
//  - **Seeded, not referenced.** A template is chosen on an offer and its values are *copied* onto
//    the offer (#308), exactly as `Contact.descriptionTemplate` seeds `Offer.description`. Editing
//    a template therefore never retroactively changes offers that were already prepared, and no
//    *offer* points back here. The single reference is `Contact.defaultCollageTemplateId` (#308) —
//    which template a new offer on that platform seeds from — and it is `onDelete: SetNull`, so a
//    template stays freely deletable.
//
// Templates carry no platform limits (max photos / edge / file size); those live on `Contact` and
// are read live at render time (#308, #310).
model CollageTemplate {
  id           String @id @default(cuid())
  collectionId String
  name         String
  // Capacity of the collage. Both ≥ 1; a 1×1 template is the single-stamp case, which is the same
  // rendering path as any other collage. In `auto` mode they are read as *max* rows and *max*
  // columns — the product is still the capacity, so the grouping rules (#309) are unchanged.
  rows         Int
  columns      Int
  // `fixed` | `auto` (#413). Fixed lays every row out at `columns`; auto solves the width per image
  // from its tile count, staying inside both bounds. Defaults to fixed, which is what every template
  // written before this existed does.
  gridMode     String @default("fixed")
  // Spacing between tiles — one value used both between columns and between rows — as a **percent
  // of the stamp height**, resolved by the renderer against the median tile of the collage it is
  // laying out (#310, #312). Not pixels: a pixel number cannot be chosen without knowing the scan
  // DPI and how far the platform's limits will shrink the finished image, and neither is known when
  // the template is written.
  gapPercent   Int
  // Canvas colour behind the tiles, `#rrggbb`. Also what the label strip is drawn on. Defaults to
  // black (#381): a scan's own pale margins dissolve into a white canvas, so the tiles lose their
  // outlines, and the label ink follows the background's luminance either way. Existing templates
  // keep the colour they were written with — only the default moved.
  background   String @default("#000000")
  // Height of the label strip drawn below each tile (#312) — and so the size of its caption — as a
  // percent of the **finished image's longest edge**, not of the stamp (#337): every image of a
  // listing is scaled to the same platform limit before upload, so only a share of the image renders
  // at one size across a collage, a lone scan and a wide detail crop. Fractional, because the usable
  // band is a couple of percent wide and whole numbers cannot land inside it. 0 = no strip.
  labelPercent Float @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // Platforms that seed new offers from this template (#308). `onDelete: SetNull` on that FK — a
  // template deleted while a platform points at it simply leaves the platform without a default.
  defaultForPlatforms Contact[] @relation("PlatformDefaultCollage")

  @@index([collectionId])
  @@map("collage_template")
}

/// A blank ref-card format (#569) — the paper stationery the ref-card sheet
/// (`locations/ref-cards`) prints, named so a collection can keep several: a ref card is slipped
/// into a transport card's pocket alongside the stamps, so its size is set by that pocket and its
/// type size by how much of the card stays visible above them.
///
/// Read **live** at print time and never copied anywhere, which is the opposite of
/// {@link CollageTemplate}'s seeding (#308) and deliberately so: nothing about a printed sheet is
/// recorded, so an edit has no past act to change retroactively. Hence no in-use check, no
/// `templateId` on anything, and no snapshot.
model RefCardTemplate {
  id           String @id @default(cuid())
  collectionId String
  name         String
  // Millimetres throughout — the whole purpose is matching a physical card, and one print unit is
  // worth more here than the convenience of `rem`. Fractional: index-card stock is sold at sizes
  // like 62.5 mm, and rounding a card to the millimetre is what makes it not fit.
  cardWidthMm  Float
  cardHeightMm Float
  // Type size of the ref, and how far down the card it sits. The ref is printed at the top rather
  // than centred because the rest of the card is hidden inside the pocket.
  fontSizeMm   Float
  paddingTopMm Float
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // The sheet's picker names them, so two formats called "Postcard" is a dictionary nobody can
  // read — `AcceptanceProfile`'s rule (#533), reported as its own error rather than as a failed save.
  @@unique([collectionId, name])
  @@index([collectionId])
  @@map("ref_card_template")
}

model CatalogVendor {
  id           String @id @default(cuid())
  collectionId String
  name         String
  abbreviation String

  collection            Collection             @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogNames          CatalogName[]
  stampCatalogNumbers   StampCatalogNumber[]
  issueCatalogNumbers   IssueCatalogNumber[]
  issueCatalogPrefixes  IssueCatalogPrefix[]
  collectionAreaVendors CollectionAreaVendor[]
  colnectCatalogMappings ColnectCatalogMapping[]

  @@map("catalog_vendor")
}

// Per-collection translation from a Colnect catalog abbreviation (as printed on Colnect
// catalog pages: Mi, Sn, Yt, Sg, AFA, Pol…) to one of our local `CatalogVendor`s (#248,
// part of #155). Needed because Colnect's abbreviations don't all match ours — notably
// Colnect `Pol` is Fischer, which we abbreviate `Fi`. Only mismatches need an explicit row:
// an abbreviation with no row falls back to a local vendor whose `abbreviation` matches it
// exactly (case-insensitive); anything still unresolved is ignored during matching, not an
// error. See `src/lib/colnect.ts`.
model ColnectCatalogMapping {
  id              String @id @default(cuid())
  collectionId    String
  // The Colnect catalog abbreviation, stored as entered (e.g. "Pol"). Unique per collection.
  colnectAbbrev   String
  catalogVendorId String

  collection    Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  catalogVendor CatalogVendor @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@unique([collectionId, colnectAbbrev])
  @@index([collectionId])
  @@index([catalogVendorId])
  @@map("colnect_catalog_mapping")
}

// Per-collection translation from one of our `StampCondition`s to Colnect's own grade (#404, part
// of #155). The condition-side counterpart of {@link ColnectCatalogMapping} above, and configured
// in the same Settings tab: `StampCondition` is the collector's own list, while Colnect ships a
// closed one, and listing a copy means translating between them — once, not per catalog number.
//
// Colnect's vocabulary is **fixed and global** (#402): the identical five options render under
// every item of a multi-item sale form, so only Colnect's option value is stored and the label it
// renders as lives in code (`src/lib/colnect-conditions.ts`). Unlike the catalog mapping there is
// no exact-abbreviation fallback and no ignoring — a condition with no row is unmapped, which is a
// listing **precondition failure** (#406) rather than a silent default: never guess a grade on a
// listing about to be published.
model ColnectConditionMapping {
  id               String @id @default(cuid())
  collectionId     String
  stampConditionId String
  // Colnect's own option value (`1`–`5`), validated against the built-in vocabulary on write.
  colnectValue     String

  collection     Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stampCondition StampCondition @relation(fields: [stampConditionId], references: [id], onDelete: Cascade)

  // One mapping per condition: a copy has one condition and a listing takes one grade. Unique on
  // the condition alone, which already belongs to exactly one collection.
  @@unique([stampConditionId])
  @@index([collectionId])
  @@map("colnect_condition_mapping")
}

// This collection's authenticated access to the collector's Allegro account through Allegro's
// public REST API (#476; ADR-0023). It is the foundation the sold-listing worklist (#467) and the
// order → Sale flow (#463) read through; on its own it reads no business data.
//
// **Per collection**, matching the Allegro platform contact (#355) it attaches to and every other
// platform setting here — an Allegro account belongs to a seller rather than to a collection, but
// this app has one authorization model (`collectionId` + owner check) and an instance-level secret
// would sit outside it. One row per collection, hence the unique.
//
// Self-hosting is what puts the client credentials in this table at all: no OAuth application can
// ship in a public image, so each instance registers its own at `apps.developer.allegro.pl`. The
// client **secret** and both tokens are therefore stored sealed (AES-256-GCM under
// `STAMPORAMA_SECRET_KEY`, `src/lib/secret-box.ts`) — a hash would be useless for a value that is
// replayed, and a database dump is a routinely-copied artefact in a self-hosted install. The client
// *id* is not a secret and stays plain, so Settings can state which application is connected even
// when the key is missing.
model AllegroConnection {
  id           String @id @default(cuid())
  collectionId String @unique

  // The registered application. `clientSecretSealed` is `sealSecret()` output, never plaintext.
  clientId           String
  clientSecretSealed String
  // What the collector called that application on `apps.developer.allegro.pl`. Allegro requires a
  // `User-Agent` on every request (mandatory from the end of June 2026) and wants it to name the
  // registered application, so that they can reach whoever is generating the traffic — which in a
  // self-hosted install is a name only the collector knows. Null falls back to `Stamporama`, which
  // still answers Allegro's question; `allegroUserAgent` in `allegro-oauth.ts` builds the header.
  applicationName    String?
  // Allegro's sandbox is a property of the *connection*, not of the deployment: an application
  // registered in the sandbox has different credentials from one registered in production.
  sandbox            Boolean @default(false)

  // The grant, absent until the collector completes a flow. Both sealed.
  accessTokenSealed  String?
  refreshTokenSealed String?
  // When the access token expires, so it can be refreshed *ahead* of expiry rather than after a
  // call has already failed.
  expiresAt          DateTime?
  // Which flow made the grant is deliberately **not** stored. It was, until the refresh turned out
  // to be identical for both — same endpoint, same parameters, no redirect_uri — leaving a column
  // nothing read.

  // Who is connected, for the status line. Allegro's own account id and login.
  accountId    String?
  accountLogin String?

  // Set when a refresh was rejected: the connection is then explicitly "needs reconnecting" rather
  // than every later call failing on its own with a different message. Cleared by a successful
  // refresh or a fresh connect.
  needsReconnect  Boolean   @default(false)
  lastError       String?
  lastRefreshedAt DateTime?
  // Why this account cannot publish a listing through the API, in **Allegro's own words**, latched
  // the first time Allegro said so (#477).
  //
  // It exists because the answer cannot be asked for in advance. Allegro's selling endpoints are
  // open to **business accounts only**, and a private seller's grant is issued, refreshed and used
  // for reading orders and bids perfectly happily — the refusal arrives only when something is
  // actually published, and it is a permanent property of the account rather than a fault in the
  // request. Without recording it, the collector re-discovers it once per offer.
  //
  // Deliberately **not** `needsReconnect` (ADR-0023's single unusable state): reconnecting changes
  // nothing here, and this connection is not unusable — everything it was connected for still works.
  // It is a text rather than a flag because the sentence is Allegro's and this app has no business
  // paraphrasing a rule about somebody's account status. Cleared when a fresh grant is stored or the
  // application is re-saved, which are the two moments the answer could have changed.
  publishRefusedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("allegro_connection")
}

// Where the Allegro sold-listing sync has got to (#467; ADR-0024). One row per collection, beside
// the connection rather than on it: `AllegroConnection` holds secrets and exists to hold as few as
// possible, while this holds a cursor and an error message, which are neither sensitive nor read by
// anything that decrypts.
model AllegroSyncState {
  id           String @id @default(cuid())
  collectionId String @unique

  // The last order event Allegro handed us, its own event id. A pass resumes from here, which is
  // what makes a re-run a refresh rather than a re-import. Null before the first sync, and reset to
  // null when Allegro no longer accepts it (the stream is retained for a limited window) — the pass
  // then falls back to the dated window read, which is safe because every write is an upsert.
  orderCursor    String?
  // The instant the *lines* are current as of: the `boughtAt` floor a window read would use. Null
  // before the first sync, which is what makes that first pass read `SYNC_WINDOW_DAYS` back.
  ordersSyncedAt DateTime?
  // When the seller's active listings were last swept end to end. "Ended without selling" is derived
  // from a listing's *absence* from that sweep, so a half-finished sweep must never be read as one:
  // this is stamped only after the last page.
  listingsSweptAt DateTime?

  // ── The bidding poll (#481) ────────────────────────────────────────────────────────────────
  // Its own cursor, its own dates and its own error, because it is its own cadence: a bid has to be
  // acted on in minutes, and re-sweeping every listing that often to discover that nothing happened
  // would spend the account's quota to learn nothing. It follows Allegro's **offer** event stream
  // (`GET /sale/offer-events`) instead and reads details only for the offers that were bid on.
  //
  // The stream is retained for 24 hours, so a cursor older than that is refused and reset to null —
  // the poll then seeks to the end of the stream and leaves the state itself to the full sweep,
  // which reads every listing's bidding anyway.
  offerEventCursor  String?
  eventPolledAt   DateTime?
  // Kept apart from `lastError` on purpose: a failing bid poll must not make the sold-listing
  // worklist read as stale, and the other way round. Two questions, two answers.
  eventPollError      String?

  // The last pass that finished, and the last one that did not. A worklist whose newest observation
  // is hours old has to say so rather than look current, which is the whole reason both are here.
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastError       String?
  // True while a pass is running, so the poll and a **Sync now** click cannot read the same events
  // twice. Cleared on both outcomes; a stale flag from a killed process is timed out against
  // `startedAt`, since a lock nothing can release is worse than a second pass over idempotent writes.
  running   Boolean   @default(false)
  startedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("allegro_sync_state")
}

// One Allegro order, as the API reported it (#467; ADR-0024) — an **observation**, never a financial
// record: creating the `Sale` stays an explicit act (#463), and nothing here is written by the
// collector.
//
// A header of its own rather than order columns repeated on every line: the buyer, the status and
// the total are facts about the *order*, and one order routinely carries several of the collector's
// listings. `orderId` is Allegro's checkout form id — what a `Sale` records as `externalRef`, which
// is how a recorded sale takes its order back out of the worklist.
model AllegroOrder {
  id           String @id @default(cuid())
  collectionId String
  orderId      String

  // Allegro's own status for the order, and the payment reading derived from it (`unpaid` | `paid` |
  // `cancelled`). The second is what decides whether the order is waiting to be recorded at all — a
  // cancelled one is never actioned.
  status        String
  paymentStatus String
  // The earliest of its lines' purchase instants: what the order is dated by, and sorted by.
  boughtAt      DateTime

  // Who bought it — the buyer's Allegro login, and their name or company where the order carries
  // one. **Deliberately only these two.** The order also carries an email, a phone number and a
  // delivery address, and none of that belongs in a table whose question is "what has sold": the
  // sale #463 writes is where a buyer becomes a `Contact`, and it reads the order again at the
  // moment the collector confirms it.
  buyerLogin String?
  buyerName  String?

  // What the buyer paid in total, in `currency` — Allegro's own `summary.totalToPay`, so it includes
  // delivery. Stored rather than summed from the lines because the two are different numbers and the
  // one worth showing is what actually changed hands (`Sale.buyerPaidTotal`'s own anchor, #205).
  // Null where Allegro stated no summary.
  totalPaid Decimal? @db.Decimal(10, 2)
  currency  String?

  // When the sync last saw this order, and when it first did. The first is what dates the worklist —
  // an undated "sold" says nothing about how current the picture is (#449's `priceCheckedAt`).
  observedAt  DateTime
  firstSeenAt DateTime @default(now())

  // Allegro's order id of the checkout form that **took this one over** (#495), or null on an order
  // still standing in its own right — which is all the worklist shows.
  //
  // A buyer who wins several auctions has one checkout form per purchase until they pay; paying for
  // several at once makes Allegro issue a *new* form carrying the same `lineItemId`s and abandon the
  // originals, unpaid and never updated again. Nothing in the API then says so — no event, no status
  // change — so the leftovers would ask for ever to be recorded as sales that the merged order has
  // already accounted for. The shared line item ids are what gives it away, and the sync works it out
  // from rows it already holds rather than by asking Allegro anything.
  supersededByOrderId String?

  collection Collection         @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  lines      AllegroOrderLine[]

  @@unique([collectionId, orderId])
  @@index([collectionId, boughtAt])
  @@map("allegro_order")
}

// One line of one Allegro order.
//
// Per line rather than per offer because an order line is not one-to-one with a listing: an offer
// with stock above one sells a copy at a time, and one order can carry several of the collector's
// offers.
model AllegroOrderLine {
  id           String @id @default(cuid())
  collectionId String

  // The order this belongs to, and Allegro's own id for the line within it. The pair is the identity
  // of this observation, so a second sync updates the row instead of adding one.
  allegroOrderId String
  lineItemId     String

  // The listing that sold. `platformOfferId` is Allegro's offer id — the same digits the capture
  // module matches on (#355) — and `externalId` is the listing's own external id, which is the
  // Stamporama offer number when the listing was published through the API. The second is an exact
  // match where it exists; the first is what everything published by hand is matched on.
  platformOfferId String
  externalId      String?
  title           String
  quantity        Int
  // What the buyer paid for this line, per unit, in `currency`. Allegro states the price per item
  // and the quantity separately, and so does this: a total would lose which of the two moved.
  unitPrice Decimal @db.Decimal(10, 2)
  currency  String

  // When this particular line was bought. Allegro dates the purchase per line, and so does this —
  // the order's own `boughtAt` is the earliest of them.
  boughtAt DateTime

  // The local offer this line was matched to, and how (`external` | `url`). Null when nothing here
  // matched: an unmatched line is **shown** rather than dropped, because that is how the collector
  // learns a listing was posted outside Stamporama or that its URL was never recorded.
  offerId   String?
  matchedBy String?

  observedAt DateTime

  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  allegroOrder AllegroOrder @relation(fields: [allegroOrderId], references: [id], onDelete: Cascade)
  offer        Offer?       @relation("AllegroOrderLineOffer", fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([allegroOrderId, lineItemId])
  @@index([collectionId])
  @@index([offerId])
  @@map("allegro_order_line")
}

// One of the seller's own listings as the sweep has seen it (#467; ADR-0024). The sweep reads the
// account's **active** listings only — paging every listing an account has ever ended is unbounded
// and answers a question nobody asked — and a row the newest sweep did not see is marked `ENDED`
// rather than deleted. That absence *is* the ended-without-selling signal, and keeping the row is
// what lets it be shown with the date it was last seen up.
model AllegroListing {
  id           String @id @default(cuid())
  collectionId String

  platformOfferId String
  externalId      String?
  title           String
  // Allegro's publication status as the sweep last saw it (`ACTIVE`, `ACTIVATING`), or `ENDED` —
  // which is this app's own word for a row that dropped out of a sweep, Allegro never having been
  // asked about it. `endingAt` is when the listing was due to end, as given.
  status    String
  endingAt  DateTime?
  // How many are still on sale and how many have gone. A listing still active with stock sold is
  // exactly the case an ended-only reading would miss.
  available Int?
  sold      Int?

  // What the sweep saw of the **bidding** (#481). Allegro states all three on the same page the rest
  // of this row comes from, so they cost no extra request.
  //
  // `format` is Allegro's own selling mode (`AUCTION` | `BUY_NOW` | `ADVERTISEMENT`): it is what
  // decides whether the two figures below mean anything at all, and it is deliberately recorded
  // rather than inferred from the local offer, which can disagree. `biddersCount` is how many people
  // have bid — `0` being "up, nobody has bid", not "unknown". `currentPrice` is the standing bid,
  // with its own currency beside it because the marketplace's currency is the marketplace's and a
  // figure without one is not a price.
  //
  // The same observation is copied onto the matched `Offer` (its `price` / `priceCheckedAt` /
  // `bidderCount`), which is what the collector's own screens read. This row keeps the platform's
  // side of it: what Allegro said, and when it said it.
  format          String?
  biddersCount    Int?
  currentPrice    Decimal? @db.Decimal(10, 2)
  currentCurrency String?

  offerId   String?
  matchedBy String?

  // When the listing was last seen **up**. It is deliberately not restamped when the row is marked
  // `ENDED`, so an ended row still says when the listing was last observed active — which is the
  // only date the collector has for it, Allegro's sweep being the one thing that saw it.
  observedAt DateTime

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  offer      Offer?     @relation("AllegroListingOffer", fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([collectionId, platformOfferId])
  @@index([offerId])
  @@map("allegro_listing")
}

// The seller-side settings every published Allegro listing needs and no offer has any notion of
// (#486; ADR-0025) — delivery, after-sales services and where the parcel is sent from — held as a
// **named profile** on the Allegro platform contact.
//
// `POST /sale/product-offers` demands all of it beyond what an offer holds, and every field of it is
// the collector's *account configuration* rather than anything about a stamp: it is identical for a
// 1918 Polish issue and a modern block, and it changes when the collector moves house or adds a
// courier — never when they list something else. Hence one profile, a default per platform, and an
// offer that may point at another when a heavier package wants a different rate set.
//
// The category and its parameters are deliberately **not** here. Those *are* about the stamp, they
// differ per listing, and they are learned from what was published before rather than configured —
// that is #488's, and it is where they live.
//
// The three dictionary references below are **Allegro's own ids**, not rows of this database: they
// name things defined in the collector's Allegro account, which is the only place they can be
// created. The `*Name` beside each is a **snapshot for display**, written when the profile was saved
// from what the account then said, so a screen can name a rate set without a live call and can say
// what a profile points at when Allegro cannot be reached. The id is the truth; the name is a label.
// Nothing re-validates them on save (ADR-0025 §3) — the editor reads the account live, and #477's
// publish is where a rate set deleted on Allegro actually matters.
model AllegroListingProfile {
  id           String @id @default(cuid())
  collectionId String
  // The platform (a `Contact` carrying the `platform` role, and the one this collection calls
  // Allegro) whose listings are published with this. Owned by it, exactly as the shipping-method
  // price list is (#468).
  platformId   String
  // What the collector calls it — "Home, letter rates", "Away, courier". The pick-list, so unique
  // per platform.
  name         String

  // ── Delivery ──────────────────────────────────────────────────────────────────────────────
  // Allegro's own **shipping rate set** (`GET /sale/shipping-rates`), by its id. Not our
  // `ShippingMethod` (#468), which is a name and a cost recorded when a sale is made: that one
  // describes what the buyer paid, this one is Allegro's table of what a listing *offers*.
  shippingRatesId   String
  shippingRatesName String?
  // How long the collector takes to send, as the ISO-8601 duration Allegro states it in (`PT24H`,
  // `P3D`). A string rather than a number of days because Allegro's vocabulary includes `PT0S` and
  // hour-scale values, and re-deriving its wording from an integer is a translation with nothing to
  // gain.
  handlingTime String @default("PT24H")
  // How long a listing runs, as the ISO-8601 duration Allegro's **sale form** offers (#493). Null is
  // "leave it as the form was served", which is what every profile written before this existed says.
  //
  // It is here rather than on the offer because it is a way of selling rather than a fact about the
  // stamps — the same reasoning that puts the handling time and the returns policy here. Read by the
  // Assistant path only: `POST /sale/product-offers` (#477) does not send one and takes Allegro's own
  // default, and this app has not established what that endpoint would do with a duration, so it is
  // not sent there rather than sent untested to a live selling account.
  durationLimit String?
  // Whether Allegro re-lists the offer with a full set of items when its duration runs out (#493) —
  // the sale form's *automatyczne wznawianie oferty*. A boolean and not a nullable one: it is a way
  // of selling that the profile decides either way, so "unticked" is an answer rather than a gap,
  // and the form is set to what the profile says in both directions.
  //
  // Read by the Assistant path only, for {@link durationLimit}'s reason.
  autoRepublish Boolean @default(false)

  // ── After-sales services ──────────────────────────────────────────────────────────────────
  // The return policy and implied warranty from the account's own dictionaries
  // (`GET /after-sales-service-conditions/*`). Nullable: Allegro defaults these for business
  // accounts, so a private collector's account may legitimately have none defined — and a profile
  // that cannot name one is still a profile worth having. #477 is what says whether a listing can
  // go out without them.
  returnPolicyId      String?
  returnPolicyName    String?
  impliedWarrantyId   String?
  impliedWarrantyName String?

  // ── Location ──────────────────────────────────────────────────────────────────────────────
  // Where the parcel is sent from — nowhere else in the model, because nothing else here cares.
  // Free text as Allegro takes it, with the country as an ISO 3166-1 alpha-2 code.
  locationCountryCode String @default("PL")
  locationCity        String
  locationPostCode    String

  // ── Payments ──────────────────────────────────────────────────────────────────────────────
  // What the listing promises about invoicing (`payments.invoice`). A private collector sells
  // without one, which is the default here; the vocabulary is Allegro's and is validated in
  // `src/lib/allegro-listing-profile.ts` rather than by an enum, so a value Allegro adds is a
  // one-line change and not a migration.
  invoiceType String @default("NO_INVOICE")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // A profile belongs to its platform: deleting the platform takes its profiles with it, exactly as
  // it takes its shipping methods.
  platform   Contact    @relation("PlatformAllegroListingProfile", fields: [platformId], references: [id], onDelete: Cascade)
  // The back-references of the two `SetNull` pointers at this row: the platform that publishes with
  // it by default, and the offers that named it in place of that default.
  defaultForPlatforms Contact[] @relation("PlatformDefaultAllegroListingProfile")
  offers              Offer[]   @relation("OfferAllegroListingProfile")

  // The names *are* the pick-list, so they are unique per platform — the shipping-method rule, for
  // the shipping-method reason.
  @@unique([platformId, name])
  @@index([collectionId])
  @@index([platformId])
  @@map("allegro_listing_profile")
}

// Everything an **Easy Uploader** row carries that is not a fact about the stamps (#608; ADR-0034).
//
// Delcampe is listed to by uploading a CSV, not through an API — the REST path sits behind the paid
// API Pass and is deliberately not taken — so the file's columns are the contract. Most of them the
// app already answers: the title and description come from the platform's templates (#210, #266),
// the price and quantity from the offer, `selling_type` from its listing type (#449), the currency
// from `platformCurrency` (#196). What is left over is this: which of the seller's own shipping
// models the row names, how long and how often the listing renews itself, whether any of Delcampe's
// paid promotions is bought, and the bid step a row is written with.
//
// Held as one **named profile** rather than as columns on the contact, exactly as Allegro's is, and
// for a reason the collector stated in advance: the second answer is real — heavier lots want the
// other shipping model — and the whole set moves together when it does. A pick list of shipping
// model names beside a separate set of renewal defaults would be two lists to keep in step for what
// is one decision at upload time.
model DelcampeListingProfile {
  id           String @id @default(cuid())
  collectionId String
  // The platform (the `Contact` this collection calls Delcampe) whose uploads use this. Owned by it,
  // as the Allegro profiles and the shipping-method price list are.
  platformId   String
  // What the collector calls it — "Standard letter", "Heavy lot, tracked". The pick list, so unique
  // per platform.
  name         String

  // ── Delivery ──────────────────────────────────────────────────────────────────────────────
  // Delcampe's `shipping_model` column: the **name** of one of the shipping models the seller has
  // defined on Delcampe. Inverted from Allegro's rate set (#486), which stores Allegro's own id with
  // the name as a screen label: here the CSV carries the name itself and there is no id in reserve,
  // so a model renamed on Delcampe makes the upload fail and nothing here can find out beforehand —
  // `GET /shippingModels` is API-Pass-only. Stored as unvalidatable data, said out loud in the
  // editor, so a refused upload does not read as a fault in the export.
  shippingModel String

  // ── Renewal ───────────────────────────────────────────────────────────────────────────────
  // `renew_duration` (days a listing runs before it renews) and `renew_total_count` (how many times
  // it may) **on a fixed-price row**. 28 × 99 is shop-stock behaviour: a listing that stays up until
  // it sells. An auction takes its own two figures from the auction group below (#620) rather than
  // these — nothing here describes a listing with a real end.
  renewDuration   Int @default(28)
  renewTotalCount Int @default(99)
  // `has_renewable_options`: whether the paid options below are re-bought on each renewal. `N` in
  // practice, and a plain boolean rather than a nullable one — the file writes a letter either way,
  // so "unticked" is an answer rather than a gap.
  hasRenewableOptions Boolean @default(false)

  // ── Paid promotions ───────────────────────────────────────────────────────────────────────
  // Delcampe's five `option_*` columns, each a `Y`/`N` that costs money. All false today; they are
  // here because the file demands a value for every one of them, and a column silently written `N`
  // by the exporter is a decision nobody could find later.
  optionStrongTitle       Boolean @default(false)
  optionBackgroundColor   Boolean @default(false)
  optionBorderColor       Boolean @default(false)
  optionListPromotion     Boolean @default(false)
  optionHomepagePromotion Boolean @default(false)

  // ── Bid step ──────────────────────────────────────────────────────────────────────────────
  // `minimum_bid_step` is not a constant: `0,01` was observed on cheap items and `0,10` on dearer
  // ones, so it is a **threshold rule** — below the threshold one step, at or above it the other.
  // The threshold is a field and not a constant because it was never confirmed against Delcampe, and
  // a guess compiled into the exporter is a guess nobody can see or correct. In the platform's own
  // currency, like every other figure on a listing there.
  minBidStepThreshold  Decimal @default(1.00) @db.Decimal(10, 2)
  minBidStepBelow      Decimal @default(0.01) @db.Decimal(10, 2)
  minBidStepAtOrAbove  Decimal @default(0.10) @db.Decimal(10, 2)

  // ── Auctions ──────────────────────────────────────────────────────────────────────────────
  // The second duration group (#620), and deliberately not a reinterpretation of the first: the
  // renewal counters above are shop stock — a listing that stays up until it sells — while an
  // auction's whole point is a deadline. An auction row takes `renew_duration` and
  // `renew_total_count` from *these* two instead.
  //
  // **Blank until typed, and seeded with nothing.** Everything else on this model carries an
  // observed default, because it was observed on the collector's own live listings; there are no
  // auctions to observe, so a figure here would be this app inventing how long somebody's auctions
  // run. An auction export refuses while they are null and says which are missing, which is the one
  // honest thing to do with a number nobody has stated.
  auctionDuration        Int?
  auctionRenewTotalCount Int?
  // `sale_end_day` / `sale_end_time`: empty on every fixed-price row — a shop listing has no end
  // worth choosing — and meaningful on an auction, where when it closes decides who is watching.
  //
  // **Stored and written verbatim**, which is ADR-0034 §2's treatment of `shippingModel` applied to
  // a second unvalidatable cell: what spelling Easy Uploader wants for a closing day and hour is not
  // published anywhere this app can read and has never been confirmed. A day picker and an hour
  // picker would be a claim about that format, and a wrong claim would need a release to correct;
  // a text cell is corrected by retyping it. Blank is allowed and means the row states no end,
  // leaving it to Delcampe's own default for the duration.
  auctionEndDay          String @default("")
  auctionEndTime         String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  platform   Contact    @relation("PlatformDelcampeListingProfile", fields: [platformId], references: [id], onDelete: Cascade)
  defaultForPlatforms Contact[] @relation("PlatformDefaultDelcampeListingProfile")
  offers              Offer[]   @relation("OfferDelcampeListingProfile")

  @@unique([platformId, name])
  @@index([collectionId])
  @@index([platformId])
  @@map("delcampe_listing_profile")
}

// One listing as Delcampe's own **active-items export** last stated it (#611; ADR-0037) — the read
// half of a contract whose write half is #610's Easy Uploader file.
//
// It is `AllegroListing`'s shape (#467) on a marketplace with no API: a file the seller downloads
// stands in for the sweep, and everything that follows from it follows for the same reasons.
//
//   * **Rows of its own, not a state on `Offer`.** A listing may match no offer at all — one posted
//     straight on Delcampe, or one whose reference belongs to a collection that is not this one —
//     and an observation with nowhere to live is one the collector never gets to see.
//   * **Absence is the signal.** A row the newest import did not carry is marked `ENDED` rather than
//     deleted: keeping it is what lets the screen say *when the listing was last seen up*, which is
//     the only date there is for a listing nobody watched go. It is cleaner here than on Allegro —
//     a file is whole by nature, so there is no half-finished sweep to guard against the way
//     `AllegroSyncState.listingsSweptAt` does.
//   * **What it says about money is what the platform said.** `presentPrice`, `bidsCount` and
//     `bestBidder` are kept beside the row whether or not they reach an offer, exactly as the
//     Allegro row keeps its bidding: an unmatched auction still has a standing bid.
model DelcampeListing {
  id           String @id @default(cuid())
  collectionId String

  // Delcampe's own listing id (`id_auction` in the file) — matched on **exactly**, never derived
  // from an address, and the address is composed back from it
  // (`delcampe.net/en_US/collectibles/item/<itemId>.html`) rather than stored a second time.
  itemId String
  title  String
  // The `personal_reference` the row came back with, verbatim, and what it resolved to. Both, on
  // purpose: the reference is what the collector sees on Delcampe and has to correct there, and the
  // offer number is what makes an unmatched row readable ("names offer 412, which is not here") and
  // what groups the two rows of a duplicated reference together.
  personalReference String?
  referenceOfferNo  Int?

  // `ACTIVE` — carried by the newest import — or `ENDED`, which is this app's own word for a row
  // that dropped out of one. Delcampe is never asked about it, and the file states no status.
  status String
  // When Delcampe says the listing closes, from `end_date` read against its **separate `GMT`
  // column**; null where the file stated neither or the pair could not be read.
  endsAt DateTime?

  // What the listing is at right now, its currency taken from the Delcampe platform contact
  // (#196) — the file states none, and a figure without a currency is not a price. `bidsCount` is
  // `bids_number` (`0` is "up, nobody has bid", which is not the same as unknown) and `bestBidder`
  // is the login the file names, held because it is what the row *said*; nothing is derived from it.
  presentPrice Decimal? @db.Decimal(10, 2)
  currency     String?
  quantity     Int?
  bidsCount    Int?
  bestBidder   String?
  visits       Int?
  // Delcampe's `id_category` as the listing actually carries it — the answer to what was uploaded,
  // beside `Offer.delcampeCategoryId`, which is what would be uploaded next.
  categoryId   String?

  offerId   String?
  // How the row found its offer. Only ever `reference` today; a column rather than a boolean for
  // `AllegroListing.matchedBy`'s reason — the provenance of a match is what makes it correctable.
  matchedBy String?
  // Why it did **not**, where it did not: `no-reference`, `unknown-offer`, `duplicate-reference`,
  // `offer-already-listed`. Stored rather than re-derived on every read, because it is the
  // conclusion the import came to about *that file* — a screen that recomputed it would quietly
  // answer a question about the offers as they are now, which is not what the collector is looking
  // at when they go and fix a reference on Delcampe.
  problem   String?

  // When the listing was last seen **up**. Deliberately not restamped when the row is marked
  // `ENDED`: an ended row still has to say when it was last observed active.
  observedAt DateTime

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  offer      Offer?     @relation("DelcampeListingOffer", fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([collectionId, itemId])
  @@index([offerId])
  @@map("delcampe_listing")
}

// When this collection last read Delcampe's active-items export (#611).
//
// The header's honesty, and the whole of what this table is for: a list of live listings that was
// last refreshed a fortnight ago must say so where it is being read, exactly as the Allegro
// worklist's header does. It carries no cursor, no lock and no error — an import is a file a person
// chose and pressed a button for, so its failures are answered in the dialog they happened in
// rather than latched for a background pass nobody is watching.
model DelcampeImportState {
  id           String @id @default(cuid())
  collectionId String @unique

  lastImportedAt DateTime?
  // The name of the file the collector picked, kept so the screen can say *which* export it is
  // showing — Delcampe names its exports by date, which is the one thing about them worth quoting.
  lastFileName   String?
  lastRowCount   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@map("delcampe_import_state")
}

// Delcampe's own category tree, as Delcampe publishes it (#609; ADR-0035 §4) — names for the numeric
// `category_id` the Easy Uploader file demands.
//
// **Not a mapping and not a setting.** Nothing here says what a stamp should be listed as; that is
// the register's job and it is learned. This is a *dictionary*: `7945` on its own is unreadable, and
// a picker that made the collector type it from a spreadsheet would be the hand-maintained table
// #609 exists to avoid. It is filled from Delcampe's published list at
// `delcampe.net/en_GB/collectables/category-id/stamps/`, since there is no API (the REST one is
// behind the paid API Pass, ADR-0034) and the CSV is the whole contract.
//
// **Instance-wide, with no `collectionId`** — the one table in this schema that is not scoped to a
// collection, and deliberately so: Delcampe's taxonomy is Delcampe's, identical for every collection
// on this instance, and a per-collection copy would be N copies of one public fact refreshed N
// times. `StorageCacheEntry` is the existing precedent for an instance-wide row (#591), for the same
// kind of reason. Nothing collection-specific can be read out of it, so there is nothing to scope.
//
// The rows are **replaceable, never authoritative**: the id is what the file carries, the name and
// the path are how a person recognises it, and a category Delcampe retires simply stops arriving. A
// stored offer keeps the name it was given as a display snapshot (the ADR-0025 §3 rule), so a
// disappearing row never blanks a listing that was already prepared.
model DelcampeCategory {
  // Delcampe's own numeric id, held as text: it is an identifier the CSV echoes back verbatim, and
  // nothing here does arithmetic on it.
  id   String @id
  name String
  // The breadcrumb it sits at, `Stamps > Europe > Poland > 1919-1939 Second Republic > Used stamps`.
  // The whole value of the picker: on Delcampe's tree a leaf is called `Used stamps` some three
  // hundred times over, and only the path says which country's and which decade's.
  path String
  // When this row was last seen in Delcampe's list. The refresh upserts what it read and deletes
  // only what a **complete** pass did not see, so a crawl that was rate-limited half way leaves the
  // previous snapshot standing rather than emptying the picker.
  refreshedAt DateTime @default(now())

  @@index([refreshedAt])
  @@map("delcampe_category")
}

// What was listed for a kind of stamp — the **key → category** register (#488; ADR-0026, generalised
// across platforms by #609; ADR-0035).
//
// A marketplace listing needs a category, and unlike a listing profile it is a property of *this
// stamp* rather than of the account: a 1935 Polish used definitive and a modern German souvenir sheet
// belong in different categories on every marketplace there is. Nothing in the offer model says which
// — but the collection already knows what a stamp is, so the association worth recording is between
// those four facts and the category that was actually used. Learned, never configured: a row appears
// only when an offer was **finished being prepared** with one (#494), and a draft teaches nothing.
//
// **One table for every platform**, keyed per (collection, `platformId`), which is what it has been
// since #488 — the Allegro name it carried was the only Allegro thing about it. Delcampe (#609) files
// its categories quite differently and still asks the same question in the same order, and two copies
// of the relaxation ladder would drift on the first correction. What did *not* generalise is
// `AllegroCategoryParameterMemory` below: Delcampe's categories carry no parameters, and keeping the
// two registers apart (ADR-0026 §1) is exactly what makes only the shared half shared.
//
// Every part of the key is nullable, and null means **absent from this key** rather than "no value"
// (ADR-0026 §2) — an offer whose copies disagree about their year asks a question that is not about a
// year, exactly as a stamp with no year does. Lookup relaxes in one fixed order (§3): the exact key,
// then without the year, then without the subtype, then one level up the area tree and again. The
// condition is never dropped.
model PlatformCategoryLesson {
  id           String @id @default(cuid())
  collectionId String
  // The platform contact this row is about, which owns what is known about that marketplace's
  // taxonomy — the `AllegroListingProfile` ownership, for the same reason (ADR-0026 §5). It is also
  // what keeps one table honest: a category id means nothing without the marketplace it belongs to,
  // and every read is filtered by it.
  platformId   String

  // ── The key ───────────────────────────────────────────────────────────────────────────────
  // A node of the area tree; lookup walks upwards from the offer's own node and a tier matches this
  // node **or any of its descendants**, which is what makes a lesson learned on one branch reach a
  // sibling one.
  areaId      String?
  issuedYear  Int?
  conditionId String?
  subtypeId   String?

  // ── What was listed ───────────────────────────────────────────────────────────────────────
  // The marketplace's own category id, with the name and the breadcrumb beside it as **display
  // snapshots** (the ADR-0025 §3 rule): the id is the truth, and a screen can name a category without
  // a live call. A category restructured on the marketplace leaves this pointing at nothing — which
  // on Allegro the publish turns into a refusal, on Delcampe the upload does, and which the settings
  // panel is where it is deleted.
  categoryId   String
  categoryName String?
  categoryPath String?

  // How well backed this row is (ADR-0026 §4). The count is what breaks a tie between two rows one
  // relaxed tier both matches, and what lets a suggestion say "used 7 times" rather than quoting a
  // single publish.
  timesUsed  Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  collection Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  platform   Contact         @relation("PlatformCategoryLesson", fields: [platformId], references: [id], onDelete: Cascade)
  // All three key references cascade: a learned association is derived knowledge about data that has
  // gone, not something the collector would want left behind pointing at an id that no longer names
  // anything.
  area       CollectionArea? @relation(fields: [areaId], references: [id], onDelete: Cascade)
  condition  StampCondition? @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  subtype    StampSubtype?   @relation(fields: [subtypeId], references: [id], onDelete: Cascade)

  // One row per key per platform. The key parts are nullable and a null is a *value* of the key here,
  // so the unique index is created `NULLS NOT DISTINCT` by hand in the migration (ADR-0006) — Prisma
  // cannot express it, and without it every mixed offer would add a new row instead of bumping one:
  //     CREATE UNIQUE INDEX "platform_category_lesson_key"
  //         ON "platform_category_lesson"("platformId", "areaId", "issuedYear", "conditionId", "subtypeId")
  //         NULLS NOT DISTINCT;
  @@index([collectionId])
  @@index([platformId])
  @@index([areaId])
  @@index([conditionId])
  @@index([subtypeId])
  @@map("platform_category_lesson")
}

// What was answered for a category's parameters — the **category → parameter values** register
// (#488; ADR-0026 §1).
//
// The second register, and separate from the first on purpose: this is what makes a *new* key still
// cheap to publish once its category has been picked by hand, while the first is what makes an old
// key free. One row **per parameter** rather than one per category holding all of them, so a category
// that gains a parameter does not invalidate what is known about the others.
//
// It stayed **Allegro's** when the first register went platform-generic (#609): Delcampe's categories
// carry no parameters, so there is nothing here for a second marketplace to share — and that the two
// registers were separate tables from the start is exactly what made only the shared half shared.
model AllegroCategoryParameterMemory {
  id           String @id @default(cuid())
  collectionId String
  platformId   String

  // Allegro's category and parameter ids, with the parameter's name as a display snapshot.
  categoryId    String
  parameterId   String
  parameterName String?

  // The value as Allegro takes it in `parameters[]` — `{ valuesIds?, values?, rangeValue? }`. Held as
  // JSON rather than as columns because the shape is the parameter's type's: a dictionary parameter
  // answers with ids, a float with a number, a range with two. Splitting that into nullable columns
  // would be this app deciding it knows Allegro's parameter types, which it has no reason to.
  value Json

  timesUsed  Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  platform   Contact    @relation("PlatformAllegroCategoryParameterMemory", fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, categoryId, parameterId])
  @@index([collectionId])
  @@index([platformId, categoryId])
  @@map("allegro_category_parameter_memory")
}

// Bearer token letting the Stamporama Assistant browser extension (#253, part of #155) call a
// collection's Colnect matcher endpoints. An extension running on colnect.com reaches our origin
// cross-site, where Better Auth's session cookie is not sent, so a token is needed. A token
// authorizes as the collection's owner for that one collection (owner-only access model). Only the
// SHA-256 hash of the raw token is stored; the raw value is shown once at creation. The full
// registration/code-exchange issuance UX is #252 — this is the minimal generator behind it.
model AssistantToken {
  id           String    @id @default(cuid())
  collectionId String
  // SHA-256 hex of the raw token; the raw value (prefix "stmpa_") is never stored.
  tokenHash    String    @unique
  // Optional human label, e.g. the profile/instance name it was issued for.
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("assistant_token")
}

model AssistantRegistrationCode {
  id           String    @id @default(cuid())
  collectionId String
  // SHA-256 hex of the raw code; the raw value (prefix "stmpr_") is shown once, on the page that
  // minted it, and exchanged by the extension for an AssistantToken.
  codeHash     String    @unique
  expiresAt    DateTime
  // Set when redeemed — the row is kept (not deleted) so a replayed code fails as "used", and
  // expired/used rows are swept when the collection mints its next code.
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@map("assistant_registration_code")
}

model CatalogName {
  id       String @id @default(cuid())
  vendorId String
  name     String
  currency String

  vendor                 CatalogVendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  catalogEditions        CatalogEdition[]
  collectionAreaCatalogs CollectionAreaCatalog[]
  primaryForAreas        CollectionArea[]        @relation("CollectionAreaPrimaryCatalog")

  @@map("catalog_name")
}

model CatalogEdition {
  id            String @id @default(cuid())
  catalogNameId String
  year          Int

  catalogName        CatalogName          @relation(fields: [catalogNameId], references: [id], onDelete: Cascade)
  stampCatalogPrices StampCatalogPrice[]

  @@map("catalog_edition")
}

model CollectionArea {
  id                   String   @id @default(cuid())
  collectionId         String
  name                 String
  parentId             String?
  description          String?
  catalogId            String?
  primaryCatalogNameId String?
  // Optional name to use for this area in auto-generated listing titles (#210), independent of the
  // internal `name`. When blank, the `{area}` token walks up the tree and uses the nearest ancestor
  // that sets one, else the area's own `name` — so internal grouping levels (e.g. "Second Republic")
  // roll up to a public area ("Poland") while siblings ("General Gouvernement") keep their own.
  titleName            String?
  // Grouping-only areas (e.g. "Europe") have `assignable = false`: they organize child
  // areas but cannot themselves receive Issues/stamps directly. Leaf areas that hold
  // material have `assignable = true`. Defaults true. Mirrors `Location.assignable` (#56, #263).
  assignable           Boolean  @default(true)
  // Custom display order among siblings under the same parent (#78). Lower sorts first;
  // ties break by name. New areas are appended (max sibling `sortOrder` + 1).
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())

  collection             Collection             @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parent                 CollectionArea?        @relation("CollectionAreaChildren", fields: [parentId], references: [id])
  children               CollectionArea[]       @relation("CollectionAreaChildren")
  translations           CollectionAreaTranslation[]
  stampAreaLinks         StampCollectionArea[]
  primaryCatalogName     CatalogName?           @relation("CollectionAreaPrimaryCatalog", fields: [primaryCatalogNameId], references: [id])
  collectionAreaCatalogs CollectionAreaCatalog[]
  collectionAreaVendors  CollectionAreaVendor[]
  issues                 Issue[]
  formatFactors          StampFormatFactor[]
  platformCategoryLessons PlatformCategoryLesson[]

  @@map("collection_area")
}

// Per-language text for an area (#265, #293). The parent's own `titleName` column stays the
// **default-language** value; a row here overrides it for one language. `language` is a free
// ISO 639-1 code, and the set of languages a collection uses is derived from its platforms
// (`Contact.titleLanguage`) — there is no separate language configuration. Cascade-deleted with
// the area. First of the per-entity translation tables; condition/certificate (#294), issue
// (#295) and stamp (#296) follow the same shape.
model CollectionAreaTranslation {
  collectionAreaId String
  language         String
  titleName        String?

  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)

  @@id([collectionAreaId, language])
  @@map("collection_area_translation")
}

model StampCollectionArea {
  stampId          String
  collectionAreaId String
  isPrimary        Boolean @default(false)

  stamp          Stamp          @relation(fields: [stampId], references: [id], onDelete: Cascade)
  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)

  @@id([stampId, collectionAreaId])
  @@map("stamp_collection_area")
}

model Stamp {
  id           String   @id @default(cuid())
  collectionId String
  parentId     String?
  subtypeId    String?
  // Per-stamp override of the subtype's `actsAsVariant` (ADR-0010). Tri-state:
  // null = inherit from the subtype; true/false = force. Effective value is
  // `actsAsVariantOverride ?? subtype.actsAsVariant`. Meaningful only for children.
  actsAsVariantOverride Boolean?
  name         String?
  issuedDay    Int?
  issuedMonth  Int?
  issuedYear   Int?
  createdAt    DateTime @default(now())
  // Denormalized numeric sort key for catalog-number ordering (#181): the parsed number of the
  // stamp's effective primary-catalog vendor (via its primary area link), else the lowest numeric
  // across its numbers, else null (sorts last). Maintained on every write that changes the stamp's
  // numbers or area link, and bulk-recomputed when an area's primary catalog changes. See ADR-0012.
  primaryCatalogSortKey Int?
  // Colnect Marketplace item-ID (#247, part of #155). Colnect has no API/import — every catalog
  // page exposes the numeric item-ID (header link `/en/stamps/stamp/<ID>-…`, `data-xid`). Stored
  // as a plain optional string, not through the catalog-vendor machinery: a Colnect item-ID is an
  // external identifier, not a priced catalog number, and it must be settable on any stamp
  // regardless of area. No uniqueness constraint. A later browser agent (#155) will populate it.
  colnectId    String?

  collection        Collection            @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  parent            Stamp?                @relation("StampVariants", fields: [parentId], references: [id])
  subtype           StampSubtype?         @relation(fields: [subtypeId], references: [id], onDelete: Restrict)
  variants          Stamp[]               @relation("StampVariants")
  stampAreaLinks    StampCollectionArea[]
  catalogNumbers    StampCatalogNumber[]
  catalogPrices     StampCatalogPrice[]
  issueMemberships  IssueMember[]         @relation("IssueMemberStamp")
  checklistEntries  ChecklistStamp[]      @relation("ChecklistStampStamp")
  wants             Want[]                @relation("WantStamp")
  items              Item[]               @relation("ItemStamp")
  variantHistoryFrom ItemVariantHistory[] @relation("ItemVariantHistoryFrom")
  variantHistoryTo   ItemVariantHistory[] @relation("ItemVariantHistoryTo")
  auctionLotLines    AuctionLotLine[]
  photos             Photo[]
  translations       StampTranslation[]
  tileCandidates     ScanTileCandidate[]
  /** Offers that hold this stamp as an umbrella and were told by hand which variant to list it
   *  under, and offers that named this stamp as that variant. See {@link OfferListedVariant}. */
  listedVariantUmbrellas OfferListedVariant[] @relation("OfferListedVariantUmbrella")
  listedVariantChoices   OfferListedVariant[] @relation("OfferListedVariantChoice")

  @@index([subtypeId])
  @@index([collectionId, issuedYear, primaryCatalogSortKey])
  @@index([collectionId, primaryCatalogSortKey])
  @@map("stamp")
}

// Per-language `name` for a stamp (#296), behind the `{name}` title token. Same shape as
// `CollectionAreaTranslation` (#293): `Stamp.name` stays the default-language value and a row here
// overrides it for one language. The highest-row-count translation table — every value is typed by
// hand, so most stamps carry no rows at all and simply fall back.
model StampTranslation {
  stampId  String
  language String
  name     String?

  stamp Stamp @relation(fields: [stampId], references: [id], onDelete: Cascade)

  @@id([stampId, language])
  @@map("stamp_translation")
}

model StampCatalogNumber {
  stampId         String
  catalogVendorId String
  number          String

  stamp         Stamp         @relation(fields: [stampId], references: [id], onDelete: Cascade)
  catalogVendor CatalogVendor @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@id([stampId, catalogVendorId])
  // The primary key answers "this stamp's number in that catalog"; the Colnect matcher asks the
  // opposite question — who holds this catalog's number — over a batch at a time. Its recall
  // predicate is a substring match, so this index cannot serve it directly, but it keeps the
  // planner's cost estimate for that scan honest as the collection grows.
  @@index([catalogVendorId, number])
  @@map("stamp_catalog_number")
}

model StampCatalogPrice {
  id                  String  @id @default(cuid())
  stampId             String
  catalogEditionId    String
  conditionId         String
  certificateStatusId String?
  // Physical format this price is for; null = single, the only value before formats existed.
  // A row here is an **explicit** price that wins over anything `StampFormatFactor` would
  // derive — recording what a catalog actually prints for that multiple.
  formatId            String?
  price               Decimal @db.Decimal(10, 2)
  currency            String

  stamp             Stamp              @relation(fields: [stampId], references: [id], onDelete: Cascade)
  catalogEdition    CatalogEdition     @relation(fields: [catalogEditionId], references: [id], onDelete: Cascade)
  condition         StampCondition     @relation(fields: [conditionId], references: [id], onDelete: Restrict)
  certificateStatus CertificateStatus? @relation(fields: [certificateStatusId], references: [id], onDelete: Restrict)
  format            StampFormat?       @relation(fields: [formatId], references: [id], onDelete: Restrict)

  // Uniqueness on (stampId, catalogEditionId, conditionId, certificateStatusId, formatId)
  // is enforced by a raw `UNIQUE ... NULLS NOT DISTINCT` index (see migration),
  // which Prisma cannot express — so no @@unique here. Requires PostgreSQL 15+.
  @@index([stampId])
  @@index([catalogEditionId])
  @@index([conditionId])
  @@index([certificateStatusId])
  @@index([formatId])
  @@map("stamp_catalog_price")
}

model Item {
  id                  String   @id @default(cuid())
  collectionId        String
  // Human-readable internal identifier (#268): a per-collection sequence starting at 1,
  // assigned on creation from `Collection.nextItemNo` and never editable afterwards. It is
  // what a collector writes on the physical piece, so it must stay stable and must not be
  // reused — deleting a copy retires its number.
  itemNo              Int
  stampId             String
  conditionId         String
  certificateStatusId String?
  // Physical format of this copy; null = single. A multiple is one copy in one format — it is
  // never stored as, or counted as, N single copies (see `StampFormat`).
  formatId            String?
  inCollection        Boolean  @default(true)
  forSale             Boolean  @default(false)
  forTrade            Boolean  @default(false)
  // Acquisition link (ADR-0009). A purchase is one channel among several; `lotId` is a
  // nullable FK to a `PurchaseLot` (`onDelete: Restrict`). Supplier/date/price now live
  // on `Purchase`/`PurchaseLot`, superseding the flat cost fields from ADR-0007.
  lotId               String?
  // Physical delivery axis (ADR-0009 §5), orthogonal to `inCollection`/`forSale`/`forTrade`.
  // One of: ordered | in_transit | delivered | not_delivered | damaged. Defaults `delivered`
  // — a manually added copy is in hand; purchase intake sets `ordered` explicitly (and leaves
  // the copy out of the collection until it arrives).
  deliveryState       String   @default("delivered")
  // Disposal axis (#394), orthogonal to disposition and delivery: the copy left the collector's
  // hands *after* it arrived — lost, damaged in storage, discarded. The involuntary counterpart to
  // a sale. `disposedAt` doubles as flag and timestamp (null = still held), so every filter stays a
  // plain `where`; `disposalReason` is one of lost | damaged | other, and `disposalNote` is
  // required when the reason is `other`. The lot allocation is never touched — unlike
  // `not_delivered`, the cost really was incurred, so `costBasis`/`lotId`/`itemNo` all stay.
  disposedAt          DateTime?
  disposalReason      String?
  disposalNote        String?
  // Base-currency cost-basis snapshot (ADR-0009 §2/§3). Null = pending (lot still open,
  // or the copy entered via a channel that has not written a cost yet).
  costBasis           Decimal? @db.Decimal(10, 2)
  notes               String?
  // Physical storage: at most one assignable `Location` per copy, plus an optional
  // free-text identifier within that location (e.g. a page/pocket ref like `A234`),
  // not unique. `onDelete: Restrict` guards against orphaning a stored copy (#56).
  locationId          String?
  locationRef         String?
  createdAt           DateTime @default(now())

  collection        Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stamp             Stamp                @relation("ItemStamp", fields: [stampId], references: [id], onDelete: Cascade)
  condition         StampCondition       @relation(fields: [conditionId], references: [id], onDelete: Restrict)
  certificateStatus CertificateStatus?   @relation(fields: [certificateStatusId], references: [id], onDelete: Restrict)
  format            StampFormat?         @relation(fields: [formatId], references: [id], onDelete: Restrict)
  lot               PurchaseLot?         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  location          Location?            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  variantHistory    ItemVariantHistory[]
  photos            Photo[]
  // Sales module (ADR-0013). A copy is packaged into offer sets (N:M — the same copy can be
  // listed on several platforms at once) and, once sold, is recorded on exactly one `SaleLine`
  // via the `sale_line_item` join (the DB-level no-double-sale guard is the unique on `itemId`).
  offerSetMemberships OfferSetItem[]
  saleLineItems       SaleLineItem[]
  /** Manual offer attachments (#313) whose label tokens resolve from this copy. */
  offerPhotoAttachments OfferPhotoAttachment[]
  offerPhotoAttachmentTiles OfferPhotoAttachmentTile[]
  /** Platforms this copy is deliberately never listed on (#506). */
  platformExclusions ItemPlatformExclusion[]
  /** Scan tiles this copy was identified from (#567). Normally none or one; several when two
   * tiles of the same piece — a front card and a back card cut as separate batches — were both
   * assigned to it. */
  scanTiles ScanTile[]

  @@unique([collectionId, itemNo])
  @@index([collectionId])
  @@index([stampId])
  @@index([conditionId])
  @@index([lotId])
  @@index([locationId])
  @@index([formatId])
  // Every collection-scoped read narrows to the copies still held (#394/#396), so the flag is
  // indexed together with the scope rather than on its own.
  @@index([collectionId, disposedAt])
  @@map("item")
}

// A copy the collector has decided is **never** to be listed on one platform (#506).
//
// The *not offered on X* worklist (#259) answers "what is for sale and still needs a listing there",
// and its weakness is that a copy deliberately kept off a marketplace answers it truthfully for
// ever: a thousand such copies bury the one that arrived yesterday. This row is the collector saying
// "stop asking about this one, here" — a decision, not a fact about the goods, which is why it lives
// beside the copy rather than on it and is scoped to one platform at a time.
//
// A flag and a timestamp, no reason field: the worklist only needs to know the question is settled,
// and anything worth writing down about *why* is what the copy's own `notes` are. The presence of
// the row is the whole state, so setting it twice is a no-op and clearing it is a delete — which is
// what makes the bulk write idempotent.
//
// Both FKs **cascade**. Unlike a purchase or a sale, an exclusion records nothing that happened:
// deleting the copy takes its exclusions with it, and deleting the platform contact must not be
// blocked by a preference that stops meaning anything the moment the platform is gone.
model ItemPlatformExclusion {
  id         String   @id @default(cuid())
  itemId     String
  // A `Contact` carrying the `platform` role — the same reference `Offer.platformId` is.
  platformId String
  createdAt  DateTime @default(now())

  item     Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  platform Contact @relation("PlatformItemExclusion", fields: [platformId], references: [id], onDelete: Cascade)

  // One decision per copy per platform; the unique is what lets the write be an upsert-by-absence.
  @@unique([itemId, platformId])
  @@index([platformId])
  @@map("item_platform_exclusion")
}

// A photo attached to an inventory copy (#112). One `Item` has many `Photo`s.
// `role` reserves two singleton slots — `front` / `back` — each holding at most one image
// (enforced by the partial-null unique on `[itemId, role]`; multiple NULLs stay distinct in
// Postgres, so titled extras are unlimited). Extras (role = null) carry a free-text `title`
// and are drag-orderable via `sortOrder`; front/back are fixed slots outside the ordering.
//
// `storageBackend` records which storage binding holds this photo's bytes. Only `filesystem`
// exists today (defaulted); it is the per-photo read seam that lets #138 add GCS with no forced
// migration (write-one-read-many). Bytes live at `<collectionId>/<photoId>/{full,thumb}.<ext>`
// via the storage interface (ADR-0011) — Prisma cascade removes this row but the domain must
// delete the stored bytes explicitly (no orphaned files).
//
// **Polymorphic owner** (#137, #311): exactly one of `itemId` / `stampId` / `offerId` is set (raw
// CHECK in the migration). A copy photo documents a specific owned piece; a stamp photo is a
// representative/reference image of the catalog stamp or variant; an offer photo is a listing image
// — a collage generated for the offer (#311) or, later, a file uploaded straight to it (#313), which
// belongs to neither a copy nor a stamp. Front/back are singleton slots *per owner*, enforced by raw
// *partial* unique `(*, role)` indexes — a plain unique on the nullable `itemId` would let every
// stamp photo collide on `(NULL, 'front')`. NULL role (titled extras, and every offer image) stays
// unlimited. A copy photo promoted to its stamp is an independent row with its own duplicated bytes
// and lifecycle.
//
// `kind` says how the bytes came to exist: an `original` upload/scan of something physical, or an
// image `generated` by the app (#311). Beyond describing the row it enables a later storage
// optimisation — generated bytes can be purged and recreated on demand, originals never can.
model Photo {
  id             String   @id @default(cuid())
  itemId         String?
  stampId        String?
  offerId        String?
  /** Fourth owner (#566): a scan tile, holding its front/back crop before any copy exists to hang
   * it on. #567 moves the images onto the new copy by reassigning this column to `itemId`. */
  tileId         String?
  kind           String   @default("original")
  role           String?
  title          String?
  storageBackend String   @default("filesystem")
  storageKey     String
  mime           String
  width          Int
  height         Int
  /** Dimensions measured before the FULL_MAX_EDGE downscale, so the collage renderer can restore
   * true relative sizes across scans. Null on rows predating the columns — originals are never
   * stored, so there is nothing to backfill from; readers fall back to `width`/`height`. */
  originalWidth  Int?     @map("original_width")
  originalHeight Int?     @map("original_height")
  sizeBytes      Int
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  item  Item?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stamp Stamp? @relation(fields: [stampId], references: [id], onDelete: Cascade)
  offer Offer? @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tile  ScanTile? @relation(fields: [tileId], references: [id], onDelete: Cascade)
  /** The photo plan entry this image occupies, when it is part of an offer's plan (#311). */
  offerPhotoEntry OfferPhotoEntry?
  /** Manual attachments (#313) that render *from* this image. A copy's scan can be attached to
   * several offers; an offer's own upload is attached exactly once. */
  offerPhotoAttachments OfferPhotoAttachment[]
  offerPhotoAttachmentTiles OfferPhotoAttachmentTile[]

  // Owner XOR (CHECK) and the per-owner partial unique `(*, role)` indexes are declared
  // in the migration SQL — Prisma cannot express partial unique indexes or check constraints.
  @@index([itemId])
  @@index([stampId])
  @@index([offerId])
  @@index([tileId])
  @@map("photo")
}

// Staging row for an eager, pre-Save photo upload (#112). On drop, the file is processed by
// `sharp` and its `full` + `thumb` bytes are written to the active storage backend under a
// staging key *before* any `Photo` row exists; this row records the pending bytes. On Save,
// the dialog's change-set promotes selected uploads into `Photo` rows (bytes moved to the
// permanent key). On Cancel, rows are simply left unreferenced. An hourly orphan-GC sweep
// (instrumentation `register()`) deletes rows older than a TTL plus their bytes — the only
// cleanup path for abandoned drops. Owner-agnostic, so #137 reuses it for stamp uploads.
model PhotoUpload {
  id             String   @id @default(cuid())
  collectionId   String
  storageBackend String   @default("filesystem")
  storageKey     String
  mime           String
  width          Int
  height         Int
  /** Carried from the upload to the `Photo` row on commit — see the note on `Photo`. */
  originalWidth  Int?     @map("original_width")
  originalHeight Int?     @map("original_height")
  sizeBytes      Int
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@map("photo_upload")
}

model ItemVariantHistory {
  id          String   @id @default(cuid())
  itemId      String
  fromStampId String
  toStampId   String
  changedAt   DateTime @default(now())
  note        String?

  item      Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromStamp Stamp @relation("ItemVariantHistoryFrom", fields: [fromStampId], references: [id], onDelete: Cascade)
  toStamp   Stamp @relation("ItemVariantHistoryTo", fields: [toStampId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@map("item_variant_history")
}

// Purchase transaction header (ADR-0009 §1). A single acquisition event: optional
// supplier, one transaction currency, shared shipping cost, and a physical delivery
// status. Its inventory lines are `PurchaseLot`s; non-inventory lines are
// `PurchaseExpense`s. Scoped to a collection.
model Purchase {
  id           String   @id @default(cuid())
  collectionId String
  // Short per-collection purchase number (#432) — see `Issue.issueNo`. What the quick-jump box
  // takes after `p` (#431), and the short handle for a parcel one refers to away from the screen.
  purchaseNo   Int
  // Optional supplier — who the stamps were bought from. `onDelete: Restrict`: a contact
  // referenced by a purchase cannot be deleted without first detaching it (ADR-0008 §4,
  // ADR-0009).
  contactId    String?
  // Optional platform — the marketplace/intermediary a purchase went through (e.g. Allegro,
  // eBay), distinct from the supplier (ADR-0009 §1). A `Contact` carrying the `platform`
  // role; same `onDelete: Restrict` guard.
  platformId   String?
  // The moment money was spent; the FX rate is frozen as of this date.
  purchasedAt  DateTime @db.Date
  // Single transaction currency for every amount on this purchase and its lines.
  currency     String
  // Base-currency FX rate frozen at `purchasedAt` (ADR-0009 §4), reusing the
  // `ExchangeRate` mechanism (#20). Extra fractional digits like `ExchangeRate.rate`
  // (DECIMAL(65,30)); null when base == transaction currency or no rate is known yet.
  fxRateToBase Decimal?
  // Shared cost (shipping/handling) distributed across all lines by price (ADR-0009 §3).
  shippingCost Decimal? @db.Decimal(10, 2)
  // Physical delivery status of the shipment: preparing | in_transit | arrived.
  status       String   @default("preparing")
  // Per-purchase batch sequence for scan ingest (#566, re-parented by #586). Per **purchase**
  // rather than per lot: a batch number names the physical card on the desk, and one card of a
  // settled auction routinely holds pieces belonging to a dozen of the purchase's lots. Per lot it
  // existed twenty times over in one parcel and named nothing.
  nextScanBatchNo Int @default(1)
  createdAt    DateTime @default(now())

  collection Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contact    Contact?          @relation("PurchaseSupplier", fields: [contactId], references: [id], onDelete: Restrict)
  platform   Contact?          @relation("PurchasePlatform", fields: [platformId], references: [id], onDelete: Restrict)
  lots       PurchaseLot[]
  expenses   PurchaseExpense[]
  // Retained card scans and the tiles cut from them (#566/#586, ADR-0033).
  scanSheets ScanSheet[]
  scanTiles  ScanTile[]
  // Card scans still arriving in chunks (#590). Staging: a finished upload deletes its own row.
  scanUploads ScanUpload[]
  // The auction settlement this purchase was transcribed from, when it came from one (ADR-0021).
  auctionSale AuctionSale?

  @@unique([collectionId, purchaseNo])
  @@index([collectionId])
  @@index([contactId])
  @@index([platformId])
  @@map("purchase")
}

// Inventory line of a purchase (ADR-0009 §1): a priced lot that resolves into one or
// more `Item`s over time. Intake lifecycle `status`: open | closed. Cascade-deleted
// with its purchase.
model PurchaseLot {
  id         String @id @default(cuid())
  purchaseId String
  // Optional free-text title identifying the lot (e.g. "Album Polska 1950s", "Box lot").
  // When blank, the UI derives a display label from the copies identified into the lot,
  // falling back to a positional "Lot N" (#121).
  title      String?
  // Line price in the purchase's transaction currency.
  price      Decimal @db.Decimal(10, 2)
  // Intake status: open (items still being identified, cost pending) | closed
  // (pool allocated to items, cost-basis frozen). See ADR-0009 §3/§5.
  status     String  @default("open")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  items    Item[]
  // The won auction lot this line was transcribed from, when it came from one (ADR-0021).
  auctionLot AuctionLot?

  @@index([purchaseId])
  @@map("purchase_lot")
}

// A retained scan of one stockbook card (#566, ADR-0033).
//
// Deliberately **not** a `Photo`. A `Photo` is two derivatives of something and the upload's own
// bytes are discarded; a sheet is the opposite — the bytes are the point, because the cut happens
// on the original and a stockbook cannot be re-scanned once it has been broken up. It also needs
// an `original` variant the closed `PhotoVariant` union has no room for, and would have to be
// excluded from every existing photo reader.
//
// Variants hang under `storageKey` as `<prefix>/{original,view}.<ext>`: `original` is the upload
// untouched, `view` a FULL_MAX_EDGE-capped derivative the review editor displays, because a
// browser cannot be handed a 30 Mpx image and the original must never be the thing on screen.
model ScanSheet {
  id             String   @id @default(cuid())
  /** The **purchase**, not one of its lots (#586). A card is scanned once and holds pieces
   * belonging to any number of the parcel's lots; which lot a piece belongs to is not answerable
   * until it has been identified, which is #567's step and not this one. */
  purchaseId     String
  /** The cut this sheet belongs to: a front sheet, an optional back sheet, and the tiles cut
   * from them. A per-purchase sequence taken from `Purchase.nextScanBatchNo`. */
  batchNo        Int
  /** An optional short name for the card (#587) — *Klaser Polska 1*, *Zestawy 3–5*. The number
   * stays primary: it is assigned rather than chosen and it is what makes a batch findable, so
   * this is a gloss on it and never a replacement. Written to **both** sheets of a batch, exactly
   * as `batchDoneAt` is, so either side answers for the batch and neither can be the one that got
   * replaced. */
  label          String?
  /** front | back. Unconstrained in the DB, matching `Offer.state` and `PurchaseLot.status`. */
  side           String
  storageBackend String   @default("filesystem")
  /** Key **prefix**, exactly as `Photo.storageKey` is. */
  storageKey     String
  mime           String
  /** The original's dimensions. Every box is stored in these coordinates — this is what the editor
   * scales by and what `sharp.extract` is handed. */
  width          Int
  height         Int
  /** The `view` derivative's dimensions; the editor's display scale is `viewWidth / width`. */
  viewWidth      Int
  viewHeight     Int
  /** The retained original's size, counted in the collection's storage total: it is the largest
   * object the app stores and it would be dishonest for it to be the invisible one. */
  sizeBytes      Int
  /** When the **last** tile of this batch left `unidentified` (#567) — consumed into a copy or
   * discarded. From that moment the batch can never be re-cut (a consumed tile refuses it), so the
   * retained original has no remaining function. Nothing reads it yet; #578's retention sweep is
   * what will, on the closed-offer photos' TTL-after-a-terminal-state pattern (#512). Written now
   * because deriving it from the tiles afterwards is fragile and adding the column later is a
   * migration. Cleared again if a tile ever returns to `unidentified`. */
  batchDoneAt    DateTime?
  /** When the retention sweep deleted this sheet's bytes (#578), or null while they are still
   * there. **The row survives the purge**: a re-cut then refuses with *the scan has been deleted*
   * and the batch still lists what it held, rather than a missing file surfacing as a read error —
   * which is the worst way for a collector to learn about it. `sizeBytes` goes to 0 at the same
   * moment, so the collection's storage total (#144) drops without any reader having to know this
   * column exists. */
  purgedAt       DateTime?
  createdAt      DateTime @default(now())

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  frontTiles ScanTile[] @relation("ScanTileFrontSheet")
  backTiles  ScanTile[] @relation("ScanTileBackSheet")

  @@unique([purchaseId, batchNo, side])
  @@index([purchaseId])
  @@map("scan_sheet")
}

// One region of one cut (#566, ADR-0033) — an image of something not yet identified, sitting on a
// purchase until #567 turns it into a copy on one of its lots or records that it became nothing.
//
// Why this is not an `Item`: `Item.stampId` is NOT NULL and stays that way. Every read in the app
// assumes a copy points at a stamp, and lot closing decides it — the pool is split across copies by
// primary-catalog price, before the parcel arrives, so a stamp-less stub copy would have no weight
// in that split. As its own entity a tile is simply not in the split, and the lot header warns
// "N tiles unidentified" the way the existing "N to sort" warning does.
//
// The boxes are retained though nothing needs them to *serve* a tile: they are what lets a re-cut
// reopen the editor on the previous cut rather than an empty canvas.
model ScanTile {
  id           String   @id @default(cuid())
  /** The **purchase** (#586). A tile is an unidentified image, and which lot it belongs to is
   * exactly the question identification answers — `itemId` below is where that answer lands, via
   * the copy's own lot. */
  purchaseId   String
  batchNo      Int
  /** Reading order within the batch: rows by top edge within a tolerance taken from the median box
   * height, each row left to right. Assigned at commit and stable afterwards. */
  position     Int
  /** unidentified | consumed | discarded (#567) | parked (#597). `consumed` means the tile became a
   * copy and handed it these very images; `discarded` means it became nothing and keeps them;
   * `parked` is still to be identified, set aside because the answer is not at the desk. */
  state        String   @default("unidentified")
  /** The copy a `consumed` tile became (#567) — created from it, or an already-identified copy on
   * the lot that needed photographs rather than identification. `SetNull` rather than cascade: a
   * deleted copy must not take the record of the tile with it, and the tile stays `consumed`
   * because its images left with the copy and there is nothing to go back to. */
  itemId       String?
  /** Where the front came from. Null on a **back-only** tile: an unmatched back box becomes a tile
   * of its own so it can be dragged onto a front tile, which is the manual pairing path. */
  frontSheetId String?
  frontX       Int?
  frontY       Int?
  frontW       Int?
  frontH       Int?
  backSheetId  String?
  backX        Int?
  backY        Int?
  backW        Int?
  backH        Int?
  /** Why a tile was discarded (#567) — junk, damaged beyond interest, unidentifiable. For a
   * stockbook bought sight-unseen this is the only record of what was actually inside. */
  note         String?
  createdAt    DateTime @default(now())

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item       Item?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /** `Restrict`: a sheet cannot be deleted out from under the tiles cut from it. */
  frontSheet ScanSheet? @relation("ScanTileFrontSheet", fields: [frontSheetId], references: [id], onDelete: Restrict)
  backSheet  ScanSheet? @relation("ScanTileBackSheet", fields: [backSheetId], references: [id], onDelete: Restrict)
  /** The tile's front/back crops, as `Photo` rows under the fourth owner. */
  photos     Photo[]
  /** The shortlist a parked tile carries (#607): what this piece could be, kept so the return
   * sitting does not repeat the narrowing that discovered the picture cannot settle it. */
  candidates ScanTileCandidate[]

  // The "a tile has at least one side" CHECK is declared in the migration SQL — Prisma cannot
  // express check constraints.
  @@index([purchaseId])
  @@index([purchaseId, batchNo])
  @@index([purchaseId, state])
  @@index([itemId])
  @@map("scan_tile")
}

// What a parked tile **could be** (#607) — the narrowing that discovering "this cannot be
// identified from its picture" already required.
//
// Knowing that a watermark or a shade decides a piece means having worked out which stamps it could
// be, and #597 kept the note and threw that away. A row here is one of those possibilities;
// returning to the tile offers them as one-press identifications.
//
// **Nothing survives the identification.** What the copy became is the record, and refinement
// history (#101/#130) is where a later change of mind is written — a shortlist standing beside it
// would be a second, staler account of the same question. So these rows are deleted when the tile is
// consumed, and when it is put back in the queue with its note (the doubt is spent either way). A
// discard keeps them for the reason it keeps the note: for a sight-unseen stockbook the tile is the
// only record of what the parcel held.
//
// No `position`: a shortlist of two or three has no order worth storing, and the surfaces read it in
// the order it was built.
model ScanTileCandidate {
  tileId    String
  stampId   String
  createdAt DateTime @default(now())

  tile  ScanTile @relation(fields: [tileId], references: [id], onDelete: Cascade)
  /** `Cascade`: a stamp that has been deleted is no longer one of the possibilities, and a
   * shortlist is a working note rather than a record anything is owed to. */
  stamp Stamp    @relation(fields: [stampId], references: [id], onDelete: Cascade)

  // The pair **is** the row: one stamp is on a tile's shortlist or it is not, so the composite key
  // is also the "no duplicates" rule and there is nothing for a write to have to check.
  @@id([tileId, stampId])
  @@index([stampId])
  @@map("scan_tile_candidate")
}

// A card scan arriving in **parts** (#590) — the row that holds an upload together between the
// request that opens it and the one that finalizes it.
//
// A 1200 dpi card is 100–200 MB and no ordinary deployment can carry that in one request body:
// nginx defaults `client_max_body_size` to 1 MB and Cloudflare caps at 100 MB, so the app's own
// 200 MB `MAX_UPLOAD_BYTES` was asking the operator's proxy for something it refuses. Chunking
// removes the requirement rather than restating it at a higher number.
//
// The parts do **not** go to the storage backend. They live on local disk under
// `STAMPORAMA_DATA_DIR/scan-uploads/<id>/`, whatever `STAMPORAMA_STORAGE_BACKEND` says: a chunk is
// written once, read once and deleted, so sending it to a bucket would mean 200 MB going up as
// parts and coming straight back down to be assembled seconds later. Only the assembled sheet is
// handed to the storage interface. This is not a cache of a remote object (#591) — a chunk was
// never remote.
//
// The row is what makes an abandoned upload findable: a directory says what is on disk but not
// whose it is or when it last moved, and a sweep trusting a listing would be one race away from
// deleting an upload mid-flight. It is staging in the same sense a `PhotoUpload` is, and is swept
// on the same TTL by the same pass.
model ScanUpload {
  id             String   @id @default(cuid())
  /** The order the finished scan belongs to — and, through it, the collection every chunk request
   * is checked against. */
  purchaseId     String
  /** Everything the finalize step will hand `uploadSheet`, captured at open time: a chunk request
   * carries bytes and an index and nothing else. */
  side           String
  batchNo        Int?
  label          String?
  mime           String
  /** The size the client declared, checked against `MAX_UPLOAD_BYTES` before a byte is sent — a
   * scan too large is refused at the open rather than after 200 MB have crossed the wire. */
  totalBytes     Int
  /** The chunk size this upload was opened at. Held per upload rather than read from the
   * environment at finalize time, so a restart mid-upload cannot change the arithmetic under an
   * upload already in flight. */
  chunkBytes     Int
  /** How many parts have been stored. Also the index of the **next** part expected: chunks arrive
   * in order, so this is both the progress the client is acknowledged with and the count the
   * sweep addresses the parts by. */
  receivedChunks Int      @default(0)
  receivedBytes  Int      @default(0)
  createdAt      DateTime @default(now())
  /** Bumped by every accepted chunk, so the sweep measures an upload's age from the last sign of
   * life rather than from when it was opened — a 200 MB card over a slow line can legitimately
   * take longer than the TTL to send. */
  updatedAt      DateTime @updatedAt

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([updatedAt])
  @@map("scan_upload")
}

// One locally held copy of a **remote** storage object (#591), and the `used` a least-recently-used
// cache needs somewhere to record.
//
// Emphatically not `ScanUpload`'s neighbour in kind, however alike two tables of local bytes look:
// a chunk (#590) was never remote and has an explicit lifecycle, while every row here is a copy of
// something that still exists in the bucket and can be thrown away at any moment without losing
// anything. Nothing may merge the two on the strength of both being local bytes.
//
// **A table rather than filesystem metadata**, because there is no filesystem metadata to use:
// `atime` is off on most modern mounts (`relatime`, `noatime`) and `mtime` records writing, not
// use. A row touched per access is affordable precisely because only *work* populates the cache
// and never delivery (see `StorageAccess`), so accesses are few and large — it would not be if
// every thumbnail served counted. It also means the cache **survives a restart**, without which
// the first detection after a deploy fetches back the 200 MB this exists to stop.
//
// **The row and the file may drift, and neither trusts the other.** A row whose file is gone is a
// *miss*, not an error; a file with no row is garbage the eviction pass collects. A cache that
// throws when its own bookkeeping is stale is worse than no cache, because every caller then has
// to handle a failure that has nothing to do with what it asked for.
//
// `key` is the backend-agnostic storage key, which is already collection-scoped (ADR-0011) — so
// *clear this collection's entries* is a delete by prefix and the cache needs no partitioning to
// be clearable per collection, while its cap stays one number for the instance.
model StorageCacheEntry {
  /** Which binding the original lives on. Part of the identity because the same key names a
   * different object on a different backend, and because the cache is only ever in front of a
   * remote one — a filesystem object is already local and is never copied here. */
  backend    String
  key        String
  /** The local copy's size on disk, as `stat` reported it after writing. What the cap is counted
   * against, and what an eviction pass frees. */
  sizeBytes  Int
  createdAt  DateTime @default(now())
  /** The LRU's ordering. Bumped by every work read that hits, and set by the write that
   * populated. */
  lastUsedAt DateTime @default(now())

  @@id([backend, key])
  @@index([lastUsedAt])
  @@index([key])
  @@map("storage_cache_entry")
}

// Non-inventory line of a purchase (ADR-0009 §1), e.g. a magnifier bought alongside
// the stamps: a label and a price, with no lifecycle and no items. It absorbs its
// fair share of the shared cost so it does not inflate the stamps. Separate table
// from `PurchaseLot` on purpose (ADR-0009 §1). Cascade-deleted with its purchase.
model PurchaseExpense {
  id         String  @id @default(cuid())
  purchaseId String
  label      String
  // Line price in the purchase's transaction currency.
  price      Decimal @db.Decimal(10, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@map("purchase_expense")
}

// Auction tracking (ADR-0021, #23/#350): a bidding watchlist with a fork at the end. Three levels,
// `AuctionSale` ⊃ `AuctionLot` ⊃ `AuctionLotLine`, and the whole thing settles into the purchase
// model that already exists rather than growing an acquisition path of its own.
//
// An `AuctionSale` is **one settlement with one seller** — what ships in one parcel — not "an
// auction as an event". For an auction house it coincides with the house's own sale (`Köhler 385`);
// on a marketplace it is an open-ended basket of everything currently being bid on with one seller.
// That framing is what makes shipping distribution fall out of ADR-0009 §3 for free: the grouping
// the shipping cost has to be spread over was made when it was natural, at bidding time.
//
// Two contacts, exactly as `Purchase` has: `sellerId` is who is being bought from, `platformId`
// what the sale is routed through. A house selling directly is the same contact in both; a house
// listing through philasearch is seller = house, platform = philasearch. Both `Restrict`, the same
// detach-before-delete guard purchases use (ADR-0008 §4).
model AuctionSale {
  id           String  @id @default(cuid())
  collectionId String
  sellerId     String
  platformId   String
  // `Köhler 385`, or a derived `Philkam · Allegro` for a marketplace basket. There is no separate
  // sale-number column: a house's sale identifier is part of the name.
  name         String
  // The house's catalogue URL, or the seller's marketplace page. Optional.
  url          String?
  // A **default for new lots in this sale**, never the sale's own date. A house sale has one
  // closing date and a marketplace basket has none, so the outcome-bearing date lives on the lot.
  endsAt       DateTime?
  // Transaction currency for every amount on this sale and its lots. Seeded from the seller's
  // `defaultCurrency` at creation and freely editable here. Currency belongs to the **seller**,
  // not the platform: philasearch aggregates houses listing in EUR, CHF and GBP, so the platform's
  // fixed `Contact.platformCurrency` (#196) does not apply.
  currency     String
  // The seller's fees, seeded from the contact's defaults at creation and editable here (#308/#319
  // seeding pattern): changing a seller's settings must never re-price a sale already tracked.
  // Both premium components apply — a house charging 20% + a lot fee is one sale, not two.
  shippingCost   Decimal? @db.Decimal(10, 2)
  premiumPercent Decimal? @db.Decimal(5, 2)
  premiumFixed   Decimal? @db.Decimal(10, 2)
  // open (lots still being added) | settled (converted to a purchase) | closed (nothing won).
  // Winning something else from the same seller after the parcel has shipped closes one sale and
  // starts another: two parcels, two purchases, correct cost distribution.
  status       String  @default("open")
  // Set on settlement (#28). `SetNull` so deleting the purchase leaves the auction history intact
  // rather than taking it along; unique because a settlement is 1:1.
  purchaseId   String?

  collection Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  seller     Contact      @relation("AuctionSaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  platform   Contact      @relation("AuctionSalePlatform", fields: [platformId], references: [id], onDelete: Restrict)
  purchase   Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  lots       AuctionLot[]
  createdAt  DateTime     @default(now())

  @@unique([purchaseId])
  @@index([collectionId])
  @@index([sellerId])
  @@index([platformId])
  @@map("auction_sale")
}

// One thing being bid on. Outcome lives **on the lot, never on the sale**: within one sale some
// lots are won and others lost, and that is the normal case rather than an edge one.
model AuctionLot {
  id             String   @id @default(cuid())
  auctionSaleId  String
  // Short per-collection lot number (#432), allocated from `Collection.nextAuctionLotNo`. Named
  // apart from `lotNo` on purpose, and the two are genuinely different facts: `lotNo` is the
  // **house's** number for the lot (or, for a captured Allegro listing, its offer id — #355), which
  // is typed in, may repeat across sales and may be absent; this one is ours, per collection,
  // allocated once and never reused. It is what the quick-jump box takes after `lot` (#431).
  //
  // There is no `@@unique([collectionId, auctionLotNo])`, because a lot carries no `collectionId` —
  // it reaches its collection through its sale, and denormalizing that would be a second answer to
  // "which collection is this lot in" for the sake of a safety net. The counter is the guarantee,
  // as it is for every other number here; the index below is what makes the lookup cheap.
  auctionLotNo   Int
  lotNo          String?
  url            String?
  title          String?
  // The lot's own closing time. On a marketplace every lot closes at a different moment, so this
  // is per-lot even though a house sale seeds them all from `AuctionSale.endsAt`.
  endsAt         DateTime
  // What the lot opened at. Optional: a marketplace listing often has one and a house lot always
  // does, but it is not something worth chasing. Purely a record — it never stands in for a bid,
  // because "opens at 20" and "someone has bid 20" are different facts and only the second one
  // costs money.
  startingPrice  Decimal? @db.Decimal(10, 2)
  // A single overwritten figure with the moment it was read, **not** a history. Refreshing is
  // manual, so every field that must be kept current is real work; `checkedAt` already answers
  // the only question a history would ("what is stale before it closes?").
  currentBid     Decimal? @db.Decimal(10, 2)
  checkedAt      DateTime?
  // What the collector has actually **placed** at the platform — a proxy/maximum bid, not what the
  // lot stands at. Distinct from both neighbours on purpose: `currentBid` is an observation of the
  // world, `maxBid` is a private valuation, and this is a commitment made to a third party. Without
  // it "40" on screen cannot tell "I am leading at 40" from "someone outbid me at 40".
  //
  // Who is leading is **derived** from this against `currentBid`, never stored: a stored flag would
  // be a third thing to keep current by hand, and it would go stale the moment the bid moves.
  myBid          Decimal? @db.Decimal(10, 2)
  // The collector's own ceiling, and what the lot actually fetched. `finalPrice` is optional
  // because a lot that simply vanished from view yields no datapoint (#24) — that is not an error
  // state, just an absent observation.
  maxBid         Decimal? @db.Decimal(10, 2)
  finalPrice     Decimal? @db.Decimal(10, 2)
  // Base-currency FX rate frozen when the outcome was recorded, at `endsAt` (#354), reusing the
  // `ExchangeRate` mechanism (#20) exactly as `Purchase` does at `purchasedAt` (ADR-0009 §4). Extra
  // fractional digits like `ExchangeRate.rate` (DECIMAL(65,30)). A 2023 result has to keep its 2023
  // rate: the whole point of a lost lot is that it is a *dated* price observation, and revaluing it
  // at today's rate would make the datapoint say something that was never true. Null when the sale
  // is already in the base currency, when no rate could be had, and whenever there is no
  // `finalPrice` — a rate exists to convert a figure, and an absent observation has none.
  fxRateToBase   Decimal?
  // The lot's **lifecycle**, recorded by hand: `open` | `closed` | `cancelled`. Not its outcome —
  // won/lost/observed are *derived* from `myBid` against `finalPrice` by `lotOutcome` in
  // `auction-lot.ts` and never stored (ADR-0021 §4). `closed` means the figures have been confirmed
  // after the close, which is what the old `watching`-past-`endsAt` state could not say.
  status         String   @default("open")
  // Who bid first, and **only** consulted when `finalPrice` equals `myBid`.
  //
  // At equal figures the two real cases are indistinguishable — you bid your maximum first and won,
  // or somebody else bid the same maximum first and you lost — and what separates them is the order
  // the bids were placed in, which no arithmetic recovers. So it is asked once, at closing, and
  // stored. Null everywhere else, where it means nothing; null *on* a tie reads as lost, because
  // guessing a win would feed a fabricated line into settlement (§7).
  wonTie         Boolean?
  // Set when the lot is settled into the purchase (#28). `SetNull`/unique for the same reasons as
  // `AuctionSale.purchaseId`.
  purchaseLotId  String?
  notes          String?

  auctionSale AuctionSale      @relation(fields: [auctionSaleId], references: [id], onDelete: Cascade)
  purchaseLot PurchaseLot?     @relation(fields: [purchaseLotId], references: [id], onDelete: SetNull)
  lines       AuctionLotLine[]
  createdAt   DateTime         @default(now())

  @@unique([purchaseLotId])
  @@index([auctionSaleId])
  @@index([auctionLotNo])
  @@map("auction_lot")
}

// What a lot contains: structured `stamp × condition × format × quantity`, never free text. That
// is what makes the catalogue value computable and what makes a lost lot a usable price datapoint.
// Nothing new is decided here — pointing a line at an unknown-variant umbrella covers "variant
// unspecified" and rolls up from the cheapest child exactly as the issue list does (#238), and
// `formatId` prices multiples through `StampFormatFactor` (ADR-0020, null = single).
model AuctionLotLine {
  id           String @id @default(cuid())
  auctionLotId String
  stampId      String
  conditionId  String
  // Certificate the lot is described as carrying. Null means **none**, the same unmarked default
  // `Item.certificateStatusId` uses (ADR-0006 §2) — a house lot sold with a Fotoattest is worth a
  // different figure from the same stamp without one, and catalogue prices are keyed on
  // condition × certificate × format, so the line has to be able to say which.
  certificateStatusId String?
  formatId     String?
  quantity     Int    @default(1)

  auctionLot AuctionLot     @relation(fields: [auctionLotId], references: [id], onDelete: Cascade)
  stamp      Stamp          @relation(fields: [stampId], references: [id], onDelete: Restrict)
  condition  StampCondition @relation(fields: [conditionId], references: [id], onDelete: Restrict)
  certificateStatus CertificateStatus? @relation(fields: [certificateStatusId], references: [id], onDelete: Restrict)
  format     StampFormat?   @relation(fields: [formatId], references: [id], onDelete: Restrict)

  @@index([auctionLotId])
  @@index([stampId])
  @@index([conditionId])
  @@index([certificateStatusId])
  @@index([formatId])
  @@map("auction_lot_line")
}

// A listing on one platform (ADR-0013, supersedes ADR-0012 §1–§2). The offer **owns its
// composition** directly (mirroring `Purchase ⊃ PurchaseLot ⊃ Item`): it holds N `OfferSet`s,
// each an atomic sellable unit. `platformId` is a `Contact` carrying the `platform` role. Price +
// currency are per-offer (platforms price independently). Lifecycle `state`: preparing | ready |
// active | paused | sold | withdrawn — a new offer starts `preparing` (composed but not yet
// published), is marked `ready` once assembled, then activated by hand (#188, #246). Nothing is
// shared between offers — the same copy listed elsewhere is a
// separate offer with its own sets. The derived "needs action" overlay (an active offer holding a
// set whose copy has already sold) is computed, never stored.
model Offer {
  id           String   @id @default(cuid())
  collectionId String
  // Short per-collection listing number (#416), the offer-side counterpart of `Item.itemNo` (#268):
  // assigned on creation from `Collection.nextOfferNo`, never editable and never reused. It exists
  // because an offer's address has to fit somewhere tiny — Colnect's private note allows 100
  // characters (#402), which a cuid-based URL nearly fills on its own — and because a short number
  // is what one quotes about a listing at all.
  offerNo      Int
  platformId   String
  // The listing's own title (#209), independent of the derived set/copy label. Generated at
  // creation from the platform's title template (#210) over the seeded copies, then freely edited
  // or regenerated by hand. Null when never generated (no seed copies) — the UI falls back to the
  // label derived from the offer's sets.
  name         String?
  // The listing's long description (#266) and the seller-only private note some platforms allow on a
  // listing (#267). Both follow `name`: generated at creation from the platform's own template
  // (`Contact.descriptionTemplate` / `privateNoteTemplate`) over the seeded copies, then freely
  // edited or regenerated per field. Null when never generated — a platform with no template for a
  // field simply produces none, and the field stays manually editable.
  description  String?
  privateNote  String?
  // How `description` is written (#319): `plain` | `html` | `markdown`. Seeded from the platform at
  // creation and editable here, on the same reasoning as the photo configuration below — the text was
  // written for one platform's field, so re-pointing an existing listing at another interpretation
  // because a setting changed elsewhere is never what was meant. Drives how the description renders on
  // screen and what the copy action puts on the clipboard (ADR-0019). `privateNote` has no format.
  descriptionFormat String @default("plain")
  // Which of the three generated texts the collector has **written themselves** (#380). A generated
  // text follows the offer's composition: adding or removing a set re-renders it from the platform's
  // template, so a listing's wording never falls behind what it lists. That is only safe while the
  // text is still the template's — hence one flag per field, set the moment the field is edited in
  // place and cleared by its ↻ Regenerate, which is how a field is handed back to the template.
  //
  // Deliberately three flags rather than one: the fields are edited, regenerated and copied one at a
  // time, and a hand-written description is no reason to freeze the title beside it.
  nameEdited        Boolean @default(false)
  descriptionEdited Boolean @default(false)
  privateNoteEdited Boolean @default(false)
  // Listing URL on the platform.
  url          String?
  // How the listing is sold (#449): `fixed` — a quick-buy at a stated asking price — or `auction`,
  // where the figure moves with the bidding. It is a fact about *this* listing rather than about the
  // platform: a marketplace that offers both (Allegro, Delcampe) carries offers of either kind.
  listingType  String   @default("fixed")
  // The figure the listing is *currently* at, in `currency` (the offer's own transaction currency):
  // the asking price of a fixed-price listing, the standing bid of an auction. One column for both
  // readings on purpose (#449) — it is what the lists show, what converts to base (#208), what the
  // suggested price (#190) is judged against and what the sale is priced from, and all of those want
  // the live number, not the historical one.
  //
  // On an auction it is an *observation*, so a listing nobody has bid on carries `0` and reads as
  // "no bids yet": the opening figure is never copied into it, since that would record a bid that
  // never happened. What such an auction is required to have is `startingPrice`, not this.
  price        Decimal  @db.Decimal(10, 2)
  // What an `auction` listing opened at (#449) — the figure the *seller states*, and so the one an
  // auction must carry to go `ready`/`active`, in place of the asking price a quick buy needs.
  // Nothing is calculated from it: every figure in the app is about what the lot is at now. Null on
  // a fixed-price listing, and on an auction still being assembled.
  startingPrice Decimal? @db.Decimal(10, 2)
  // When an `auction` listing closes (#490) — the counterpart of `AuctionLot.endsAt` on the selling
  // side, and the date the "ended, and somebody bid" flag is read against. Null on a fixed-price
  // listing, which never ends of its own accord, and on any auction whose closing time is not known.
  //
  // Optional and **not** a gate on going ready/active, unlike `startingPrice`: a listing published
  // before this field existed has none, and the field's job is to raise a flag rather than to hold a
  // listing back. What fills it in on a connected platform is the sync (#481), from the same sweep
  // that reads the bidding — which is what makes Allegro's automatic relist of an unsold auction
  // safe here: a republished listing arrives with a new closing time, and the flag moves with it.
  endsAt         DateTime?
  // When `price` was last confirmed against the live listing (#449), the auction lot's
  // `currentBid`/`checkedAt` pattern (#351): what a stored figure is worth depends on when it was
  // last looked at. Stamped by the in-place price edit, and by the sync of a **connected selling
  // platform** (#481, ADR-0021 §8 as amended) — on a marketplace this instance holds a grant for,
  // its own feed is fresher than anything typed here. Null on a price never checked — which is every
  // fixed-price listing, where the seller sets the number and nothing moves it, and every auction
  // nobody has bid on, which has had nothing to observe yet.
  priceCheckedAt DateTime?
  // The unacknowledged **notice** that the app set `inActiveBidding` itself (#481): stamped by the
  // sync at the moment it flags an auction, cleared when the collector has seen it — opening the
  // offer is that acknowledgement — and cleared again if they clear the flag by hand.
  //
  // A notice rather than a "when was it flagged" date, because the question the notification centre
  // asks is "is there anything here you have not seen yet", not "how long has this been bid on". A
  // date would have to be paired with a window, and a window is a guess about how long a hundred
  // live auctions should keep shouting; this simply stops when it has been read. Null on everything
  // flagged by hand, which is not news to the person who did it.
  biddingNoticeAt DateTime?
  // How many bidders the connected platform reported on this auction, as of `priceCheckedAt` (#481).
  // Written **only** by a platform sync and never editable by hand, which is what makes its presence
  // the provenance of the figure beside it: a bid this app observed, rather than one typed in.
  // Null on a fixed-price listing and on any auction no sync has read; `0` is an auction the sync has
  // looked at and found unbid, which is a different thing from never having looked.
  bidderCount    Int?
  currency     String
  state        String   @default("preparing")
  // The date the listing went live on the platform (#257), captured at offer creation and remembered
  // across creations. Distinct from `createdAt` (when the record was made); null when not recorded.
  listingDate  DateTime? @db.Date
  // The listing on the platform no longer says what this record says (#542): stamped the moment an
  // offer that is **up** — `active` or `paused`, both of which are listings a buyer can see — has its
  // composition, its stated price or one of its texts changed, and cleared the moment the live entry
  // is brought back into step. That is the collector's whole question after #513's "add it to the
  // offer that already exists": which of my live listings did I change, and therefore have to go and
  // re-post?
  //
  // A **timestamp of the change, not a snapshot of what was posted**. #462 declined to store what
  // went out, and that reasoning still holds — an update reloads every field precisely so that no
  // second copy of the offer has to be kept honest — but it concluded there could be no drift signal
  // at all, and that was the wrong conclusion: "something changed here since it went up" needs only
  // to know *that* it changed, which is one column and can never disagree with the offer itself.
  //
  // Null is "as far as this record knows, the live listing matches" — which is every offer that has
  // never been touched since it went up, every offer that is not up at all, and every offer whose
  // update has been pushed. It is cleared only by the acts that genuinely put the current content in
  // front of buyers: a first publication (`ready → active`), a listing URL captured by the Assistant,
  // an Assistant **update** that saved (#462), or the collector saying so by hand. Pausing and
  // **resuming** leave it exactly where it was — a resume puts the same live entry back up, which is
  // no more a re-post than the pause was.
  //
  // It dates the **first** change since the listing was last in step, not the latest, so the flag
  // reads as "diverging since…" — the number a collector triages by is how long the live listing has
  // been wrong, and a field retyped this morning would otherwise hide a set added a fortnight ago.
  //
  // Two changes are deliberately **outside** it. An auction's *current* price is an observation of
  // the bidding rather than a change to the listing, so recording a bid — by hand or by the sync
  // (#481) — raises nothing; its **starting** price is the seller's own statement and does. And the
  // generated photos have their own out-of-date signal (#311), which says the same thing about the
  // images and says it where the images are.
  listingContentChangedAt DateTime?
  // When this listing was **closed** (#512) — stamped the moment the offer entered `sold` or
  // `withdrawn`, cleared if it ever leaves one (deleting the sale that sold it reverts it to
  // `active`). Null on every offer that is still open.
  //
  // It exists for one reader: the sweep that purges a closed offer's generated images once the
  // grace period is up. `state` alone cannot answer "how long has this been over", and the offer's
  // own `updatedAt` would be reset by anything at all — a note edited on a sold listing is not the
  // listing closing again.
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  // "In active bidding" (#215): an auction-platform offer that has received a bid, committing the
  // collector before the sale is actually recorded. Independent axis from `state`/`sold` — freely
  // revertible if the auction doesn't close. Setting it flags every other active offer holding the
  // same copies as needing action, same as an actual sale collision (ADR-0013 §4).
  //
  // Set by hand, and **automatically** by the sync of a connected selling platform the moment that
  // platform reports a bidder (#481). Never cleared automatically, on any signal: having pulled the
  // copies from every other marketplace on this flag, a silent un-commit in the background is worse
  // than a row to look at, so clearing stays the collector's own act exactly as #215 specifies.
  inActiveBidding Boolean @default(false)
  // ── Photo configuration (#308) ─────────────────────────────────────────────────────────────
  // What *this listing's* photos should look like, seeded at creation from the platform's defaults
  // and its default collage template (#307), then freely editable. Stored on the offer rather than
  // read from the platform so that changing a platform setting never silently alters offers already
  // prepared or listed — most of all the label template, since a buyer referring to a label on an
  // uploaded image must keep getting the same label after a regeneration (#315). Editing any of
  // these marks the generated photo plan out of date (#311).
  //
  // Scan sides to include: `front` | `back` | `both`.
  photoSides   String  @default("front")
  // Whether a single-copy set is photographed **on its own while the platform's limit has room**
  // (#521). A collage exists to fit more stamps than the listing has slots for, so it is a
  // compromise, not a goal: with five slots and three one-stamp sets, three photos show the stamps
  // better than one collage of three. The planner therefore spends the platform's `maxPhotos`
  // budget on singles first and collages only the tail that does not fit. Off restores #309's
  // original rule — every run of single-copy sets chunked into collages regardless of the limit —
  // for a listing where the collector wants the grouped look. Multi-copy sets are unaffected either
  // way: a set is one collage because it is one thing being sold.
  photoPreferSingles Boolean @default(true)
  // Per-tile label templates (#312), left and right annotation; null when the platform had none
  // configured. Both resolve per copy, share one strip and one font size.
  photoLabelLeftTemplate String?
  photoLabelRightTemplate String?
  // The collage numbers copied from the chosen template (#307). All null together when the platform
  // had no default template and none has been picked on the offer yet — there is no collage to
  // render until they are set. Units follow the template: percent of the stamp height for
  // `collageGapPercent`, percent of the finished image's longest edge for `collageLabelPercent`
  // (#337, fractional), `#rrggbb` for `collageBackground`.
  // How the two numbers above are read (#413): `fixed` lays every row out at `collageColumns`,
  // `auto` treats them as bounds and solves each image's width from its own tile count. Null is
  // `fixed` — both for an offer with no collage numbers at all and for every offer prepared before
  // the mode existed, which is why it is not part of the all-or-nothing group below.
  collageGridMode String?
  collageRows  Int?
  collageColumns Int?
  collageGapPercent Int?
  collageBackground String?
  collageLabelPercent Float?
  // A manual **plan order** over this offer's photos (#313): an ordered list of stable tokens, one
  // per planned image — `c:<side>:<sortedItemIds>` for a generated collage side, `a:<attachmentId>`
  // for a manual attachment. It is an *override* of the derived order (set order + grouping), not a
  // replacement: the engine still groups the composition, then reorders the images by this list.
  // Tokens the composition no longer contains are ignored; images added since the last reorder slot
  // in after their natural predecessor. Empty (the default) means the derived order, so an offer
  // never reordered by hand behaves exactly as before.
  //
  // The order is also the **priority** order: what the platform's photo limit drops is whatever
  // falls off the end of it. And it is applied to the stored images directly (their entries are
  // renumbered), so the plan and the stored files never disagree about the upload sequence.
  photoPlanOrder String[] @default([])
  // Plan tokens marked **do not publish**: still rendered and stored — the collector wants to look
  // at them, and a collage cannot be "removed" the way a manual attachment can — but kept out of the
  // upload set. They take no upload number, are absent from the plan's ZIP, and do not count toward
  // the platform's photo limit, so hiding one can let a truncated image back in.
  photoPlanUnpublished String[] @default([])
  // Which Allegro listing profile (#486) this listing is published with — the seller-side settings
  // no offer has any notion of: the shipping rate set, the after-sales services, where the parcel is
  // sent from. Null is the ordinary case and means *the platform's default*, which is what almost
  // every listing wants; naming one here is the escape hatch for the listing that does not — a
  // heavier package wanting a different rate set, a run posted while away from home.
  //
  // `onDelete: SetNull`, not `Restrict`: deleting a profile must never be blocked by a listing that
  // merely preferred it, and falling back to the platform's default is a defined state rather than a
  // gap. Nothing here is read until #477 publishes, and nothing about an already-published listing
  // changes when it is edited — Allegro holds the published values from then on.
  allegroListingProfileId String?
  // The Delcampe listing profile this offer is uploaded with (#608), or null for the platform's
  // default — the column above's rule, on the marketplace it was written for. Its escape hatch is a
  // concrete one: a heavier lot needs the other shipping model, and a shipping model on Delcampe
  // travels in a profile rather than on its own (ADR-0034 §1). Also `SetNull`, for the same reason.
  delcampeListingProfileId String?
  // ── The Allegro category this listing goes out in (#488, moved onto the offer by #494) ────────
  // A listing needs a category and that category's parameters, and unlike the profile above they are
  // a property of *these stamps* rather than of the account. They live here — on the offer, beside
  // the profile — rather than being worked out at publish time, because there are two ways a listing
  // reaches Allegro (the API, #477; the Assistant's sale form, #493) and a value each path resolved
  // for itself is a value the two would eventually disagree about.
  //
  // Filled in **automatically when the offer gains its first copy**, from the learned register and
  // then from Allegro's own guess at the title (`backfillAllegroCategory`) — the `syncGeneratedTexts`
  // shape (#365/#380), except that this is a *backfill and never a refresh*: a category is a decision
  // about what the goods are, and re-deriving it under a collector who has corrected it would undo
  // that silently. Re-matching is an explicit ↻ on the offer's Allegro card.
  //
  // Nothing here is a gate. Whatever was matched is what publishes, and every value is correctable
  // in place; `allegroCategorySource` (`learned` | `allegro` | `manual`) and `allegroCategoryMatchedOn`
  // exist so the card can say where a value came from, which is the difference between a suggestion
  // and a number nobody can account for.
  allegroCategoryId        String?
  allegroCategoryName      String?
  allegroCategoryPath      String?
  allegroCategorySource    String?
  allegroCategoryMatchedOn String?
  // The parameter answers this listing goes out with, as Allegro takes them:
  // `[{ parameterId, parameterName, value }]`, where `value` is `{ valuesIds } | { values } |
  // { rangeValue }`. Seeded from what the register recalls and then owned by the offer — the
  // register learns from a listing that went live, and this is what it learns from.
  //
  // Only *offer*-section parameters are ever held here: Allegro splits a category's parameters into
  // an offer half and a product half, and a product parameter sent among the offer's own is refused
  // by name (ADR-0027 §2).
  allegroCategoryParameters Json?
  // ── The Delcampe category this upload row goes out in (#609) ──────────────────────────────────
  // The same question on the marketplace next door, answered out of the same register
  // (`PlatformCategoryLesson`) and stored the same way — on the offer, because the value is settled
  // while the listing is being prepared and read later by the file that exports it (#610).
  //
  // Four columns rather than Allegro's six: a Delcampe category carries **no parameters at all**, so
  // there is nothing corresponding to `allegroCategoryParameters`, and `delcampeCategorySource` has
  // only two values (`learned` | `manual`) because Delcampe has no title-guess of its own to fall
  // back on — an unmatched key falls through to the picker, which is a person rather than a source.
  //
  // The per-offer override is not a nicety here, it is the reason the design works: Delcampe files a
  // souvenir sheet under its own category (`7911`) while the same country and condition as a single
  // stamp goes to `7938`, and nothing in this collection records "this is a souvenir sheet"
  // dependably enough to key on. So the key answers for the common case and the offer says otherwise
  // where it must.
  delcampeCategoryId        String?
  delcampeCategoryName      String?
  delcampeCategoryPath      String?
  delcampeCategorySource    String?
  delcampeCategoryMatchedOn String?
  // The Allegro offer this listing was published as (#477), and the publication state this app last
  // knew it in. Written only by a publish Allegro accepted, and never by hand.
  //
  // The id is kept even though #467 matches a synced listing on `external.id` (the offer number) and
  // on `url`: those are how an *observation* finds its way back to an offer, while this is the
  // address every later write goes to — activating a draft above all. A draft has no public page, so
  // there is no URL to carry it, and re-deriving it from the address bar is exactly what publishing
  // through the API exists to stop doing.
  //
  // `allegroPublishStatus` is what came back: `INACTIVE` for a draft left in the account for a last
  // look, `ACTIVE` for a listing that went straight up, `PENDING` for a create Allegro accepted
  // (202) whose validation had not concluded before the request gave up waiting. The third is the
  // reason this is a column and not a boolean — a draft and an unfinished validation are both a
  // `ready` offer carrying an Allegro offer id, and only one of them can be activated.
  allegroOfferId      String?
  allegroPublishStatus String?
  // The Delcampe listing this offer is up as (#611) — Delcampe's own `id_auction`, written by the
  // reconciliation of an active-items export and never by hand.
  //
  // It is `allegroOfferId`'s counterpart and arrives the other way round: Allegro hands its id back
  // from the publish this app made, while Delcampe's listings are created from a file uploaded by
  // hand and their ids only ever come back in an export. So this is written **on confirmation from
  // the platform** and nothing is written at export time — an offer that was exported but never
  // successfully uploaded must not read as live.
  //
  // `Offer.url` is composed from it (`…/collectibles/item/<id>.html`) rather than the address being
  // stored a second time, and it is what #612 will match an order's items on. Unique per collection:
  // two offers claiming one listing is a contradiction, not a state to be reconciled later.
  delcampeItemId       String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  platform   Contact    @relation("OfferPlatform", fields: [platformId], references: [id], onDelete: Restrict)
  allegroListingProfile AllegroListingProfile? @relation("OfferAllegroListingProfile", fields: [allegroListingProfileId], references: [id], onDelete: SetNull)
  delcampeListingProfile DelcampeListingProfile? @relation("OfferDelcampeListingProfile", fields: [delcampeListingProfileId], references: [id], onDelete: SetNull)
  sets       OfferSet[]
  saleLines  SaleLine[]
  /** Listing images owned by this offer (#311): the generated collages, and the files uploaded
   * straight to it for a manual attachment (#313). */
  photos     Photo[]
  photoEntries OfferPhotoEntry[]
  photoAttachments OfferPhotoAttachment[]
  photoGeneration OfferPhotoGeneration?
  /** What the Allegro sync has observed about this listing (#467): the order lines matched to it,
   * and its own row in the last sweep of the account's active listings. Both `SetNull` — an
   * observation about a marketplace listing outlives the local offer being deleted, and it is then
   * an unmatched row, which is a state the worklist already knows how to show. */
  allegroOrderLines AllegroOrderLine[] @relation("AllegroOrderLineOffer")
  allegroListing    AllegroListing[]   @relation("AllegroListingOffer")
  /** What a Delcampe active-items export has said about this listing (#611). `SetNull` for the row
   * above's reason: an observation about a marketplace listing outlives the offer being deleted. */
  delcampeListings  DelcampeListing[]  @relation("DelcampeListingOffer")
  /** Which variant this offer lists an unknown-variant umbrella under, where the collector has said
   * so by hand. See {@link OfferListedVariant}. */
  listedVariants    OfferListedVariant[]

  // The short address `/o/<collectionSlug>/<offerNo>` (#416) resolves on this pair, and the
  // uniqueness is the guarantee that it names one listing.
  @@unique([collectionId, offerNo])
  @@index([collectionId])
  @@index([platformId])
  @@index([allegroListingProfileId])
  @@index([delcampeListingProfileId])
  // One listing is one offer's (#611), which is what makes the reconciliation's refusal to guess
  // enforceable rather than merely intended.
  @@unique([collectionId, delcampeItemId])
  // The photo-purge sweep's own scan (#512): closed offers past the grace cutoff.
  @@index([state, closedAt])
  @@map("offer")
}

// The state of one offer's photo generation (#311) — at most one row per offer, acting as both the
// job queue entry and the state the panel reads.
//
// Generation is **explicit**: nothing renders until the collector presses Generate, which only
// enqueues (`status = 'queued'`). An in-process worker started from `instrumentation.ts` `register()`
// drains the queue, so a large offer never blocks a request. A row left `running` by a container
// restart is requeued at boot — the render is idempotent (it replaces everything it finds).
//
// `fingerprint` is the hash of the inputs the *stored* images were produced from (composition and
// order, source photo ids, the offer's photo configuration, the platform's limits). Comparing it with
// the current inputs is what marks a plan **out of date**; it never triggers a render — images are
// served as stored and regenerated on request alone — but it is read by the `preparing → ready` gate,
// which refuses an offer whose plan would render images and whose stored ones are missing, stale, in
// flight or left by a failed run. Null until a run has succeeded.
model OfferPhotoGeneration {
  id       String @id @default(cuid())
  offerId  String @unique
  /** `queued` | `running` | `ready` | `failed` | `purged` — the last being a `ready` run whose images
   * the closed-offer sweep deleted once the grace period was up (#512). The row outlives them so the
   * card can say the images were cleaned up rather than never made. */
  status   String @default("queued")
  fingerprint String?
  /** Progress, for the panel: images the plan asked for, and images written so far. */
  plannedCount  Int @default(0)
  renderedCount Int @default(0)
  /** Why the last run failed, shown verbatim; null once a run succeeds. */
  error    String?
  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([status, queuedAt])
  @@map("offer_photo_generation")
}

// One image of an offer's photo plan (#309, #311). Thin on purpose: `Photo` stays the record of a
// *file* (bytes, dimensions, mime, backend, owner), and everything that describes the image's place
// in the plan lives here.
//
// `role` on the photo does not describe plan images — they carry `role = null` and take their order
// from `sortOrder` here, which is the upload order for the platform.
//
// `setIds` is a plain array, not a foreign key: a group can cover several single-copy sets (#309
// chunking), and the plan is a *snapshot* of what was rendered — a set disappearing afterwards is
// exactly the staleness the fingerprint reports, not a referential error to repair.
model OfferPhotoEntry {
  id      String @id @default(cuid())
  offerId String
  /** The generated file this entry is. One entry per photo; deleting either drops the pair. */
  photoId String @unique
  /** 0-based position in the finished plan — the order the images are uploaded in. Rewritten when
   * the collector reorders the plan (#313), so the stored files, their numbering and the ZIP always
   * follow one order; the bytes are never touched by a reorder. */
  sortOrder Int
  /** The plan identity this image was rendered for (#313): `c:<side>:<sortedItemIds>` for a collage
   * side, `a:<attachmentId>` for a manual attachment. It is what matches a stored file back to its
   * planned entry — so the plan can preview a generated collage with the real image, and a reorder
   * or a do-not-publish mark can name it. Null on rows generated before tokens existed that could
   * not be backfilled; such a row simply does not match. */
  token   String?
  /** What the image was produced from: `collage` (a group of set copies) today; `copy_photo` and
   * `upload` arrive with manual attachments (#313). */
  source  String @default("collage")
  /** `front` | `back` for a collage; null for an attachment, which has no side. */
  side    String?
  /** Links the front/back pair rendered from the same copies; null when the image has no pair. */
  pairKey String?
  /** The sets that contributed copies, in plan order. */
  setIds  String[]
  /** The copies this image actually shows, in tile order (#314). `setIds` cannot answer that on its
   * own: a set larger than the collage's capacity is split into several groups that all name it. */
  itemIds String[]
  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([offerId, sortOrder])
  @@map("offer_photo_entry")
}

// A manual photo attachment on an offer (#313) — an image the collector put in the plan by hand,
// rather than one a rule produced.
//
// Three modes, one row shape. `copy_photo` points at a *specific* photo of a copy in the offer (a
// front, a back, or an extra), so a perforation or a cancel can be shown on its own; its label
// tokens resolve from that copy. `upload` points at an image uploaded straight to the offer — an
// offer-owned `Photo` with `kind = original` — which has no copy at all, so inventory tokens
// resolve empty and only the literal text of the label template renders. `manual_collage` (#331) is a set
// of chosen photos — either kind, mixed freely — combined into **one** image at a column count the
// collector picks: the grouping the automatic rules do not produce. Its tiles are `tiles` rows and
// its `photoId` is null, because there is no single image; the other two modes are the same shape
// with one tile, which is what `photoId` is shorthand for.
//
// The row is the *plan entry*, not the image: this is where the derived/manual distinction lives,
// which is what lets a regeneration (#315) recompute the collages and leave these alone. Being
// manual, they are also protected from the platform's photo-count truncation (#309) — a collage is
// the output of a rule, an attachment was added deliberately.
//
// `photoId` cascades on purpose. Deleting a copy's scan removes the attachment from *future* plans;
// the image already generated from it is a separate `Photo` and survives, which is exactly the
// staleness the fingerprint reports. An `upload` attachment's photo exists only for the attachment,
// so removing the attachment deletes that row and its bytes explicitly.
model OfferPhotoAttachment {
  id      String @id @default(cuid())
  offerId String
  /** 0-based position in the finished plan. Out-of-range values clamp to the end (#309). */
  sortOrder Int
  /** `copy_photo` | `upload` | `manual_collage`. */
  source  String
  /** The image this attachment shows: a copy's own photo, or the offer's own upload. Null for a
   * `manual_collage` (#331), whose images are its `tiles`. */
  photoId String?
  /** The copy whose data annotates the tile (#312); null for an upload and for a collage, whose
   * tiles each name their own. */
  itemId  String?
  /** How many tiles per row a `manual_collage` is laid out at (#331); null for the single-image modes.
   * Rows are not stored: the contents are explicit here, so the row count follows from the two. */
  collageColumns Int?
  /** The collector's own caption for the attachment, shown in the plan. Never drawn on the image —
   * the tile's annotation comes from the offer's label templates like every other tile. */
  title   String?
  createdAt DateTime @default(now())

  offer Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  photo Photo? @relation(fields: [photoId], references: [id], onDelete: Cascade)
  item  Item?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tiles OfferPhotoAttachmentTile[]

  // The per-mode shape (which of `photoId` / `itemId` / `collageColumns` each mode carries) is a
  // CHECK in the migration — Prisma cannot express it.
  @@index([offerId, sortOrder])
  @@index([photoId])
  @@index([itemId])
  @@map("offer_photo_attachment")
}

// One tile of a manual collage attachment (#331), in the order the collector arranged them — tiles
// fill the collage left to right, row by row.
//
// It carries its own `source` for the same reason the attachment does: it says who owns the bytes.
// An `upload` tile's photo is offer-owned (`kind = original`) and exists for this collage alone, so
// removing the attachment deletes that row and its bytes; a `copy_photo` tile only ever pointed at
// the copy's own scan and leaves it be.
model OfferPhotoAttachmentTile {
  id           String @id @default(cuid())
  attachmentId String
  /** 0-based, dense. */
  sortOrder    Int
  /** `copy_photo` | `upload`. */
  source       String
  photoId      String
  /** The copy whose data annotates this tile (#312); null for an uploaded image. */
  itemId       String?

  attachment OfferPhotoAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  photo      Photo                @relation(fields: [photoId], references: [id], onDelete: Cascade)
  item       Item?                @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([attachmentId, sortOrder])
  @@index([photoId])
  @@index([itemId])
  @@map("offer_photo_attachment_tile")
}

// One atomic sellable unit inside an offer (ADR-0013). A set holds one or more `Item`s that sell
// **together and indivisibly** — a series / *komplet* never breaks apart. There is no unit/quantity
// discriminator: a single-stamp offer is one 1-item set, a series is one N-item set, and a
// "quantity" listing is simply many sets. Cascade-deleted with its offer.
model OfferSet {
  id      String  @id @default(cuid())
  offerId String
  // Optional free-text label; the UI derives one from the copies when blank.
  title   String?
  // Explicit, user-controlled position within the offer (#306), 0-based and dense. Sets are what a
  // buyer sees as "the second lot" and what the photo plan (#309) renders as image groups, so the
  // order is canonical and persisted rather than incidental creation order. New sets append.
  sortOrder Int @default(0)

  offer     Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  items     OfferSetItem[]
  saleLines SaleLine[]

  @@index([offerId])
  @@map("offer_set")
}

// The physical copies in an offer set (ADR-0013). **N:M** — unlike `PurchaseLot`, which owns its
// items, a copy can belong to sets across several offers at once (listed on multiple platforms).
// This is the cross-platform thread: selling a copy retires it globally (`sale_line_item.itemId`
// UNIQUE) and every other offer whose set still holds it surfaces as needing action. Cascade-
// deleted with either side.
model OfferSetItem {
  offerSetId String
  itemId     String
  // Position of the copy inside its set (#306) — the tile order in a collage, the copy order in a
  // generated listing text. **Nullable on purpose**: `null` means "derive from the catalog sort
  // key" (`stamp.primaryCatalogSortKey`), a value means the collector hand-corrected it. The
  // distinction is what tells "this is how catalog order came out" from "this is how I want it".
  // Kept all-or-nothing per set: reordering writes a value for every copy in the set, and the
  // reset action clears the whole set back to null. A copy added to a hand-ordered set appends.
  sortOrder  Int?

  offerSet OfferSet @relation(fields: [offerSetId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([offerSetId, itemId])
  @@index([itemId])
  @@map("offer_set_item")
}

// Which catalogue entry one offer lists an **unknown-variant umbrella** under, chosen by hand.
//
// #616 derives that entry — the cheapest variant, from the same rollup that values the copy — and
// stores nothing, deliberately: a derived answer cannot go stale and cannot assert that the umbrella
// *is* the variant. This is the escape hatch for the cases a derivation cannot cover: a collector who
// can rule a variant out from the piece in front of them, one who would rather sell under a variant
// that is actually being traded on the platform, and one who does not want to price a whole tree
// (#617) to post a single offer.
//
// **Keyed on the offer's own row — `offer × stamp × condition`.** Not per copy: `OfferSetItem` is
// N:M (a copy can sit in several offers' sets at once), so a per-copy choice would leak into every
// other listing holding that copy, and the sets of one offer have to stay interchangeable (#405),
// which this key guarantees rather than merely permits. Not per stamp either: the cheapest variant is
// a per-condition answer, so a used and an MNH copy of one umbrella may want different variants, and
// a shared row would force them together. The certificate and format axes the rollup also resolves at
// are deliberately *not* in the key — the On Colnect card the choice is made on is itself keyed on
// `stamp × condition`, and a choice made on a line has to apply to that line.
//
// The chosen variant may be **any** stamp in the umbrella's subtree, matched or not. Choosing an
// unmatched one still refuses the listing (#405's `missing-catalog-id`) — but against the variant the
// collector picked, whose own match affordance is right there on the card; requiring a match first
// would mean not being able to say what you want to sell before you can say it.
//
// What this deliberately does **not** move is the **valuation**. #616 held that a listing and its
// valuation can never drift apart, which was true of a derivation and cannot be true of a choice:
// what a copy is worth is a fact about the stamp and stays the rollup's lowest-variant answer, while
// what it is sold as is a fact about one listing. A collector overriding this is choosing that drift.
model OfferListedVariant {
  offerId        String
  /** The umbrella the offer holds copies of — the stamp whose variant is not identified. */
  stampId        String
  conditionId    String
  /** The variant to list under. A descendant of `stampId`; validated by the writer rather than by
   *  the database, a subtree not being expressible as a constraint. */
  variantStampId String

  offer     Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  stamp     Stamp          @relation("OfferListedVariantUmbrella", fields: [stampId], references: [id], onDelete: Cascade)
  condition StampCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  variant   Stamp          @relation("OfferListedVariantChoice", fields: [variantStampId], references: [id], onDelete: Cascade)

  @@id([offerId, stampId, conditionId])
  @@index([offerId])
  @@index([stampId])
  @@index([conditionId])
  @@index([variantStampId])
  @@map("offer_listed_variant")
}

// A sale transaction (ADR-0012). Single platform, single currency. Shared amounts —
// buyer-paid handling (+), my actual shipping (−), platform commission (−, entered manually) —
// are allocated proportionally to line sale prices by the pure engine (#163). `fxRateToBase`
// is frozen at `soldAt` (#20). A single sale can span multiple offers within the one platform.
model Sale {
  id            String   @id @default(cuid())
  collectionId  String
  // Short per-collection sale number (#432) — see `Issue.issueNo`. What the quick-jump box takes
  // after `s` (#431). Distinct from `externalRef`, which is the *marketplace's* order number: that
  // one is the platform's word for the transaction, this one is the collection's.
  saleNo        Int
  platformId    String
  // Optional buyer — the `Contact` (carrying the `buyer` role) the sale went to. `onDelete:
  // Restrict`: a referenced buyer cannot be deleted without first detaching it (like the
  // purchase supplier). Null when the buyer is unknown/anonymous.
  buyerId       String?
  // The moment of sale; the FX rate is frozen as of this date.
  soldAt        DateTime @db.Date
  // Single transaction currency for every amount on this sale and its lines.
  currency      String
  // The transaction / order number in the external system (e.g. a Delcampe or Allegro order id),
  // free-text. Null when not recorded. Handy for reconciling against the marketplace.
  externalRef   String?
  // Link to the transaction/order page on the marketplace (#292), the sale-side counterpart of
  // `Offer.url`. Free-text, stored as pasted (only trimmed) — collectors paste whatever the
  // platform gives them. Editable in any fulfillment status, for record-keeping (mirrors #213).
  transactionUrl String?
  // Base-currency FX rate frozen at `soldAt` (DECIMAL(65,30), like `ExchangeRate.rate`);
  // null when base == transaction currency or no rate is known yet.
  fxRateToBase  Decimal?
  // Buyer-paid handling/postage collected from the buyer (adds to proceeds, +). The buyer-side
  // proceeds have exactly one anchor (#205): either this handling is stored directly, or the total
  // the buyer paid is stored in `buyerPaidTotal` and handling is derived (total − gross). At most
  // one of the two is non-null.
  buyerHandling Decimal? @db.Decimal(10, 2)
  // The full amount the buyer paid, when that is the anchor (#205). When set, buyer handling is
  // derived = this − gross (sum of line prices) and recomputed as sold sets change, so `buyerHandling`
  // is null. Null when handling is entered directly.
  buyerPaidTotal Decimal? @db.Decimal(10, 2)
  // Which shipping method the buyer chose (#468), from the platform's own dictionary. Nullable —
  // a sale recorded before the dictionary existed, or one whose method was a one-off, carries none.
  // `onDelete: Restrict`: a method a sale points at cannot be deleted without first detaching it
  // (the dictionary guard the other reference lists use).
  shippingMethodId String?
  // What the method was **called at sale time** — always written beside the FK, and the only thing
  // written for a one-off *Custom* method (which has no dictionary row). A snapshot on purpose: the
  // dictionary is a live price list the collector re-prices and renames as the carriers do, and a
  // sale must keep saying which service was actually bought. Null when no method was recorded.
  shippingMethodName String?
  // My actual shipping/postage cost, in `shippingCurrency` (subtracts from proceeds, −). Entered in
  // any currency (#206) — converted straight to the base currency for profit, not to the sale's
  // transaction currency. Pre-filled from the chosen method's cost (#468) and editable afterwards:
  // what the method costs is what it usually costs, not what this parcel cost.
  shippingCost  Decimal? @db.Decimal(10, 2)
  // Currency `shippingCost` was paid in (#206), independent of the sale's transaction currency.
  // Null when no shipping cost is recorded; defaults to the sale currency in the UI.
  shippingCurrency String?
  // Base-currency FX rate for `shippingCurrency`, frozen at `soldAt` (DECIMAL(65,30), like
  // `fxRateToBase`). Null when `shippingCurrency == base` (identity) or no rate is known (#206).
  shippingFxRateToBase Decimal?
  // The shipment's tracking number (#491), as the carrier stated it — free text, trimmed only.
  // Null until the parcel is sent (the `sent` transition asks for it) or where the service has no
  // tracking at all. Deliberately **not** a link: the address is built on read from the carrier's
  // own template, so re-pointing a carrier at a new tracking site fixes every sale at once rather
  // than none of them.
  trackingCode  String?
  // Who actually carried **this** parcel (#491). Null on a sale that never said, which then falls
  // back on read to the carrier named on its shipping method.
  //
  // A sale needs its own answer because the two questions are genuinely different: the buyer picks
  // a *service* at checkout ("Courier"), and which courier that turns out to be is decided at the
  // parcel counter days later. The method's carrier is therefore a **default**, not the truth —
  // seeded into the prompt shown while a sale is marked `sent`, and overridable there. `onDelete:
  // Restrict`, the guard every other dictionary reference carries.
  carrierId     String?
  // Platform commission/fees, entered manually per transaction (subtracts, −).
  commission    Decimal? @db.Decimal(10, 2)
  // Fulfillment status in lifecycle order (#191): ordered → paid → packed → sent → received.
  // Defaults `ordered` — a freshly recorded sale is placed but not yet paid/shipped. Each change
  // also appends a `SaleStatusEvent` so the transition timeline is preserved for reporting/audit.
  status        String   @default("ordered")
  createdAt     DateTime @default(now())

  collection    Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  platform      Contact           @relation("SalePlatform", fields: [platformId], references: [id], onDelete: Restrict)
  buyer         Contact?          @relation("SaleBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod?  @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  carrier       Carrier?          @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  lines         SaleLine[]
  statusEvents  SaleStatusEvent[]

  @@unique([collectionId, saleNo])
  @@index([collectionId])
  @@index([platformId])
  @@index([buyerId])
  @@index([shippingMethodId])
  @@index([carrierId])
  @@map("sale")
}

// One shipping service a platform's buyers can choose, with what it costs to send (#468) — a
// per-platform price list, because postage is quoted by the marketplace the parcel was sold on:
// "Allegro: registered letter — 12 PLN" says nothing about a Delcampe sale. It is a dictionary in
// the sense `StampCondition` (#93) and `CertificateStatus` (#94) are — a short list the collector
// maintains and then picks from — but it hangs off the platform rather than the collection, so it
// is managed on the contact dialog's Platform tab beside the listing templates.
//
// `cost` + `currency` are the **current** price, read when a method is picked and copied onto the
// sale from there. Nothing recalculates a sale already recorded when the carrier raises its rates.
model ShippingMethod {
  id           String   @id @default(cuid())
  collectionId String
  // The platform (a `Contact` carrying the `platform` role) this method is offered on.
  platformId   String
  // Who usually carries a parcel sent this way (#491) — a **default**, seeded onto a sale and
  // overridable there, because the buyer picks a service ("Courier") and which courier it actually
  // goes with is decided at the parcel counter. Optional, and the only reason it exists is the
  // tracking link: the method is per platform, the carrier is not, and "Poczta Polska" tracks the
  // same way whichever marketplace the sale came from. `onDelete: Restrict` — the
  // detach-before-delete guard every other dictionary reference carries.
  carrierId    String?
  name         String
  // What sending by this method costs *me* — the seller-side postage, which is what the sale's
  // `shippingCost` records. Not what the buyer is charged for it (that is `buyerHandling`).
  cost         Decimal  @db.Decimal(10, 2)
  // The currency the postage is paid in — usually the collector's own, which is exactly why
  // shipping carries a currency of its own on the sale (#206) rather than the transaction's.
  currency     String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // A method belongs to its platform: deleting the platform takes its price list with it. (In
  // practice a platform with sales cannot be deleted at all — `Sale.platformId` is `Restrict`.)
  platform   Contact    @relation("PlatformShippingMethod", fields: [platformId], references: [id], onDelete: Cascade)
  carrier    Carrier?   @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  sales      Sale[]

  // Names are the pick-list, so they are unique per platform — two "Courier" rows would be a
  // select nobody could choose from.
  @@unique([platformId, name])
  @@index([collectionId])
  @@index([platformId])
  @@index([carrierId])
  @@map("shipping_method")
}

// A carrier the collection posts with (#491) — the post office or courier that actually moves the
// parcel, and where its consignments are tracked.
//
// A dictionary in the same sense as `StampCondition` (#93) or `ShippingMethod` (#468), but hung off
// the **collection** rather than a platform, which is the whole point of it existing: a shipping
// method is per marketplace, and the same Poczta Polska carries an Allegro parcel and a Delcampe one
// and tracks both at the same address. Storing the tracking address on the method would mean typing
// it again for every platform, and one of the copies going stale.
model Carrier {
  id           String @id @default(cuid())
  collectionId String
  name         String
  // Where a consignment is looked up, with `{code}` standing in for the tracking number — e.g.
  // `https://emonitoring.poczta-polska.pl/?numer={code}`. Null (or blank) where the carrier has no
  // tracking page worth linking to, which is a real case: the code is then still recorded and shown,
  // just not as a link. A stored template always carries the `{code}` token — a template without it
  // would build a link that lands somewhere other than this parcel, so it is refused on save.
  trackingUrlTemplate String?
  createdAt    DateTime @default(now())

  collection      Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  shippingMethods ShippingMethod[]
  sales           Sale[]

  // The name is the pick-list, as it is for shipping methods.
  @@unique([collectionId, name])
  @@index([collectionId])
  @@map("carrier")
}

// Append-only fulfillment-status transition log for a sale (#191). One row per status change,
// stamped at the moment of transition, so the sale's progression through ordered → paid → packed
// → sent → received is preserved for future reporting/audit. Cascades with its sale.
model SaleStatusEvent {
  id        String   @id @default(cuid())
  saleId    String
  // The status the sale moved to at `changedAt` (same token set as `Sale.status`).
  status    String
  changedAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_status_event")
}

// One line of a sale (ADR-0013): the offer set that went, the offer it sold through, its line
// sale price (sale currency), and the exact physical `Item`s that left (via `sale_line_item`).
// One line per set sold — a quantity offer selling K units records K lines.
model SaleLine {
  id         String  @id @default(cuid())
  saleId     String
  // The offer the sale came through; `SetNull` so a historical sale survives offer cleanup.
  offerId    String?
  // The offer set sold; `Restrict` so a sold set cannot be deleted out from under the sale record.
  offerSetId String
  // Line sale price in the sale's transaction currency.
  price      Decimal @db.Decimal(10, 2)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  offer    Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  offerSet OfferSet @relation(fields: [offerSetId], references: [id], onDelete: Restrict)
  items    SaleLineItem[]

  @@index([saleId])
  @@index([offerId])
  @@index([offerSetId])
  @@map("sale_line")
}

// The specific physical copies that left on a sale line (ADR-0012). The **no-double-sale**
// invariant is a DB-level `@@unique([itemId])`: a copy can appear on at most one sale line
// ever. `onDelete: Restrict` on the item so a sold copy cannot be deleted while the sale
// record references it; the join cascades with its sale line.
model SaleLineItem {
  saleLineId String
  itemId     String
  // Whether this individual physical copy has been packed (#192). Independent of the sale's overall
  // fulfillment status (#191): packing happens per copy, and a sale can span many copies packed at
  // different times. When every copy of a sale is packed the UI hints that the sale can advance to
  // the `packed` status, but never changes `Sale.status` automatically.
  packed     Boolean  @default(false)

  saleLine SaleLine @relation(fields: [saleLineId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([saleLineId, itemId])
  @@unique([itemId])
  @@map("sale_line_item")
}

model Contact {
  id               String   @id @default(cuid())
  collectionId     String
  name             String
  notes            String?
  // The person's or company's **legal** name, where it differs from what they are filed under
  // (#463). A marketplace buyer is known by their login — that is what the collector writes down
  // and what a message to them is addressed to — while the parcel has to carry the name on the
  // order. Two different things, so two fields: `name` is the identity here, this is the name on
  // the paperwork. Nullable, and blank on nearly every contact.
  fullName         String?
  email            String?
  phone            String?
  // Roles are independent, combinable boolean flags (a contact can be several at
  // once), mirroring the disposition flags on `Item` (ADR-0007 §4, ADR-0008).
  buyer            Boolean  @default(false)
  seller           Boolean  @default(false)
  exchangePartner  Boolean  @default(false)
  auctionHouse     Boolean  @default(false)
  platform         Boolean  @default(false)
  other            Boolean  @default(false)
  // Fixed transaction currency for a platform (#196). Every offer and sale routed to this
  // platform inherits and locks this currency, guaranteeing offer↔sale consistency. Nullable —
  // only platforms carry it, and it is required (domain-enforced, not a DB constraint) before the
  // first offer/sale on the platform. A per-offer/-sale `currency` snapshot preserves history, so
  // changing this later leaves existing offers/sales untouched.
  platformCurrency String?
  // Free-text title template for this platform's listings (#210), e.g. `{catalog} {name} {year}
  // {condition}`. Tokens resolve over an offer's (or set's) copies to pre-fill the offer name (#209)
  // and set/lot titles. Nullable — only platforms use it, and a null template falls back to the
  // built-in default (`DEFAULT_TITLE_TEMPLATE`). See `offer-title-template.ts`.
  titleTemplate    String?
  // Templates for the platform's longer generated listing texts: the public description (#266) and
  // the seller-only private note (#267). Same `{token}` engine as `titleTemplate`, but multi-line and
  // able to repeat a block per set / copy (`{#set}…{/set}`, `{#copy}…{/copy}`). Nullable, and blank
  // here means **generate nothing** (there is no built-in default to fall back to) — which is also
  // how a platform that has no private-note feature at all is configured.
  descriptionTemplate String?
  privateNoteTemplate String?
  // What the platform's description field accepts (#319): `plain` | `html` | `markdown`. Marketplaces
  // disagree — some show plain text with its line breaks, some take raw HTML, some paste rich text —
  // and the app renders and copies the description accordingly (ADR-0019). **Seeded** onto every
  // offer created on this platform, like the photo defaults: changing it here never re-interprets a
  // listing already written. The private note (#267) has no format; it is always plain.
  descriptionFormat String @default("plain")
  // Language this platform's generated listing text is written in (#265, #293) — a free ISO 639-1
  // code (`"pl"`, `"en"`). Nullable; only platforms carry it. Title tokens resolve translated
  // entity text for this language and fall back to the entity's default-language value when a
  // translation is missing. The collection's language set is the distinct set of these values, so
  // entity forms only offer per-language inputs for languages actually in use.
  titleLanguage    String?
  // Fallback **starting price** for a new auction on this platform (#362, narrowed in #449), in the
  // platform's own `platformCurrency` — an auction house one always opens at the same figure should
  // not have it retyped per listing. It is the **lowest-priority** suggestion: a lot's suggested
  // price (#190) and the copies' catalog value (#230) both describe the goods and win over it, so it
  // only fills a figure nothing else could answer. Nullable — no default is the normal case.
  //
  // Only meaningful, and only kept, while `defaultListingType` is `auction` (the writers clear it
  // otherwise). A quick buy has no such figure: its price follows from the goods, which is precisely
  // what the two suggestions above already answer, so a flat default there only ever said "5" about
  // stamps nobody had looked at. Not seeded onto anything: read at creation, then owned by the offer.
  defaultStartingPrice Decimal? @db.Decimal(10, 2)
  // How a new offer on this platform is sold by default (#449): `fixed` | `auction`. Read at
  // creation exactly as `defaultOfferPrice` is and then owned by the offer, which is what makes a
  // platform one only ever auctions on cost nothing per listing. Nullable — null is "no preference",
  // which reads as `fixed`, and is deliberately distinct from a stored `fixed`: a platform that has
  // never been asked the question and one told "quick buy" behave identically today, so nothing
  // needs writing to leave it alone.
  defaultListingType String?
  // ── Offer photos (#308) ────────────────────────────────────────────────────────────────────
  // Hard technical limits on what this platform physically accepts. All optional (null = no limit),
  // and **not** seeded onto offers: they describe the platform, so the renderer reads them live
  // (#310). They say nothing about how many stamps go on one collage — that is the collage
  // template's job (#307).
  maxPhotos        Int?
  // Longest edge of an uploaded image, in pixels.
  maxPhotoEdge     Int?
  // Maximum file size per image, in mebibytes — the unit platforms actually quote, never bytes.
  maxPhotoFileSizeMib Int?
  // ── Listing text limits (#403) ─────────────────────────────────────────────────────────────
  // The same kind of fact as the photo limits above: what this platform's own form physically
  // accepts. Colnect caps both of its listing texts at 100 characters (#402), and a cap discovered
  // in that form — after the text was written and the offer marked Ready — is discovered too late.
  // Counted in UTF-16 code units, the unit an HTML `maxlength` enforces. Both optional (null = no
  // limit, the normal case) and, like the photo limits, **not** seeded onto offers: they describe
  // the platform, so every surface reads them live. Two columns rather than one because platforms
  // cap the two texts independently — Colnect using one number for both is not a reason to fuse
  // them. Nothing is ever truncated against them; the app reports, it does not cut.
  // Delcampe caps a listing title and the cap is not published anywhere this app can read (#610),
  // which is why it is a field rather than a constant: an upload refused for a title 4 characters
  // over is discovered after the file was built, and a guess compiled into the exporter is one
  // nobody could correct. Blank on every platform until somebody types the number they were told.
  maxTitleLength       Int?
  maxDescriptionLength Int?
  maxPrivateNoteLength Int?
  // Which Assistant **platform module** can post to this platform (#406, part of #155) — the
  // extension's `PlatformModule` id (`"colnect"`), or null for a platform the Assistant knows
  // nothing about. It is what makes the listing preconditions answerable: they are that module's
  // rules — a Colnect item-ID on every stamp, a Colnect grade for every condition — and applying
  // them to a Delcampe listing would be noise about a form nobody is going to fill from here.
  // Nullable and unset by default, so a collection that has never used the Assistant sees none of
  // it; validated against the modules the app knows (`src/lib/platform-modules.ts`).
  platformModule   String?
  // Defaults **seeded** onto every offer created on this platform, exactly as the listing-text
  // templates seed the offer's texts: which scan sides to include (`front` | `back` | `both`) and
  // the two per-tile label templates (#312). Changing any of them here never touches an offer
  // already prepared — a buyer referring to a label on an uploaded image must keep getting that
  // label. A tile's strip carries two independent annotations, drawn flush left and flush right;
  // either may be null, and a lone one is centred.
  photoSides       String  @default("front")
  // Seeded default for #521's single-first grouping. On, like the offer column it seeds: the
  // platform's photo limit is exactly the fact the rule reads, so the platform is where a collector
  // who always wants collages says so once.
  photoPreferSingles Boolean @default(true)
  tileLabelLeftTemplate String?
  tileLabelRightTemplate String?
  // Which collage template (#307) a new offer on this platform copies its render numbers from.
  // Null — or a template later deleted — leaves the offer without collage numbers until one is
  // picked on the offer itself.
  defaultCollageTemplateId String?
  // ── Seller defaults for auction sales (#350; ADR-0021) ─────────────────────────────────────
  // The currency and fees this seller normally trades on, all optional. **Seeded** onto an
  // `AuctionSale` at creation and freely editable there — the same rule as the listing templates
  // and photo defaults above: changing a seller's settings must never re-price a sale already
  // being tracked or already settled. Only meaningful for contacts carrying the `seller` (or
  // `auctionHouse`) role. Currency lives here rather than on the platform because philasearch
  // aggregates houses listing in EUR, CHF and GBP, so `platformCurrency` (#196) cannot answer it.
  defaultCurrency     String?
  defaultShippingCost Decimal? @db.Decimal(10, 2)
  buyerPremiumPercent Decimal? @db.Decimal(5, 2)
  buyerPremiumFixed   Decimal? @db.Decimal(10, 2)
  // The platform this seller was **last tracked on** (#351/#352), pointing at another `Contact`
  // carrying the `platform` role. Written by the domain layer whenever a lot or a sale is created,
  // and read back to pre-fill the platform once the seller is named — where you bid follows from
  // who you buy from: one house always comes through an aggregator, another sells directly.
  //
  // Deliberately **not** shared with the platform an offer is listed on: where you bid and where
  // you list are different marketplaces, so one field could only be right for one of them. It is a
  // remembered value rather than a setting, so nothing in the contact form edits it, and
  // `onDelete: SetNull` — deleting the platform must forget the memory, never block the delete.
  defaultAuctionPlatformId String?
  // The Allegro listing profile (#486) every listing on this platform is published with unless the
  // offer names another. Null on a platform that is not Allegro — which is most of them — and on an
  // Allegro platform whose profiles have not been set up yet, which is what #477 refuses to publish
  // from. `onDelete: SetNull`: deleting the default profile leaves the platform without one rather
  // than blocking the delete, and "no default" is a state the settings tab states plainly.
  defaultAllegroListingProfileId String?
  // The Delcampe listing profile every upload row from this platform is written with unless the
  // offer names another (#608). The column above's shape and its `SetNull`, on a marketplace that
  // needs a great deal more of it: an Easy Uploader row carries a shipping model, renewal counters
  // and five promotion flags, none of which is a fact about a stamp. Null on every platform that is
  // not Delcampe, and on a Delcampe platform whose first profile has not been written yet.
  defaultDelcampeListingProfileId String?
  createdAt        DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  defaultCollageTemplate CollageTemplate? @relation("PlatformDefaultCollage", fields: [defaultCollageTemplateId], references: [id], onDelete: SetNull)
  // Purchases sourced from this contact (supplier). `onDelete: Restrict` on the FK
  // (from `Purchase`) means a referenced contact cannot be deleted without first
  // detaching it (ADR-0008 §4, ADR-0009 — supersedes the old `Item` acquisition link).
  purchases         Purchase[] @relation("PurchaseSupplier")
  // Purchases routed through this contact as their platform (e.g. Allegro). Same
  // `onDelete: Restrict` guard from the `Purchase.platformId` FK.
  platformPurchases Purchase[] @relation("PurchasePlatform")
  // Sales module (ADR-0012): offers listed on this contact's platform, and sales
  // transacted through it. Both FKs are `onDelete: Restrict` (same detach-before-delete
  // guard as purchases).
  offers            Offer[]    @relation("OfferPlatform")
  salesPlatform     Sale[]     @relation("SalePlatform")
  // The shipping methods this platform's buyers can choose from (#468) — a price list owned by the
  // platform, so it goes when the platform does.
  shippingMethods   ShippingMethod[] @relation("PlatformShippingMethod")
  // The Allegro listing profiles owned by this platform (#486), and the one of them it publishes
  // with by default. Two relations to the same model, the second being a single reference back —
  // the `defaultCollageTemplateId` shape (#308), for the same reason: a default is one row of the
  // list, not a flag on every row that something has to keep exclusive.
  allegroListingProfiles AllegroListingProfile[] @relation("PlatformAllegroListingProfile")
  platformCategoryLessons PlatformCategoryLesson[] @relation("PlatformCategoryLesson")
  allegroCategoryParameterMemories AllegroCategoryParameterMemory[] @relation("PlatformAllegroCategoryParameterMemory")
  defaultAllegroListingProfile AllegroListingProfile? @relation("PlatformDefaultAllegroListingProfile", fields: [defaultAllegroListingProfileId], references: [id], onDelete: SetNull)
  // The same pair for Delcampe (#608; ADR-0034).
  delcampeListingProfiles DelcampeListingProfile[] @relation("PlatformDelcampeListingProfile")
  defaultDelcampeListingProfile DelcampeListingProfile? @relation("PlatformDefaultDelcampeListingProfile", fields: [defaultDelcampeListingProfileId], references: [id], onDelete: SetNull)
  // Sales made to this contact as the buyer (ADR-0012, #166). Same detach-before-delete guard
  // via the `Sale.buyerId` FK (`onDelete: Restrict`).
  salesBuyer        Sale[]     @relation("SaleBuyer")
  // Auction settlements this contact is the seller of, and those routed through it as the
  // platform (ADR-0021). Both FKs are `onDelete: Restrict`, like purchases and sales.
  auctionSalesSeller   AuctionSale[] @relation("AuctionSaleSeller")
  auctionSalesPlatform AuctionSale[] @relation("AuctionSalePlatform")
  // Copies deliberately never listed on this platform (#506). Cascades on delete — a preference
  // about a platform that no longer exists is not a record worth keeping.
  itemExclusions       ItemPlatformExclusion[] @relation("PlatformItemExclusion")
  // Self-relation for the remembered auction platform above: a seller points at a platform, and a
  // platform knows which sellers were last tracked on it.
  defaultAuctionPlatform    Contact?  @relation("ContactAuctionPlatform", fields: [defaultAuctionPlatformId], references: [id], onDelete: SetNull)
  defaultAuctionPlatformFor Contact[] @relation("ContactAuctionPlatform")

  // `name` is unique per collection (see migration).
  @@unique([collectionId, name])
  @@index([collectionId])
  @@index([defaultCollageTemplateId])
  @@index([defaultAuctionPlatformId])
  @@index([defaultAllegroListingProfileId])
  @@map("contact")
}

model Location {
  id           String   @id @default(cuid())
  collectionId String
  name         String
  parentId     String?
  description  String?
  // Grouping-only nodes (e.g. a cabinet) have `assignable = false`; leaf storage
  // that can hold copies (e.g. a stockbook) has `assignable = true`. Defaults true (#56).
  assignable   Boolean  @default(true)
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // Adjacency-list hierarchy (same pattern as `CollectionArea`). Deleting a location
  // with children or items is blocked in the domain layer; the FK is SetNull as a
  // backstop, matching `CollectionArea`.
  parent     Location?  @relation("LocationChildren", fields: [parentId], references: [id])
  children   Location[] @relation("LocationChildren")
  items      Item[]

  @@index([collectionId])
  @@map("location")
}

model CollectionAreaCatalog {
  collectionAreaId String
  catalogNameId    String

  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  catalogName    CatalogName    @relation(fields: [catalogNameId], references: [id], onDelete: Cascade)

  @@id([collectionAreaId, catalogNameId])
  @@map("collection_area_catalog")
}

model CollectionAreaVendor {
  collectionAreaId String
  catalogVendorId  String
  areaPrefix       String?

  collectionArea CollectionArea @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  catalogVendor  CatalogVendor  @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@id([collectionAreaId, catalogVendorId])
  @@map("collection_area_vendor")
}

// Per-issue override of the area-resolved catalog prefix (#377). The prefix an issue's stamps show
// in front of their bare numbers normally comes from `CollectionAreaVendor.areaPrefix`, inherited
// down the area tree (#66); a row here replaces it for one issue and one vendor, for the *whole*
// catalog identity — the displayed label, duplicate detection (#85) and the Colnect strict full-key
// match (#155) alike. There is no stored "no prefix at all": the dialog's blank field means inherit,
// and inheriting is the absence of a row, so `areaPrefix` is non-null here (unlike the area's own,
// where a null row is what stops inheritance).
model IssueCatalogPrefix {
  issueId         String
  catalogVendorId String
  areaPrefix      String

  issue         Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  catalogVendor CatalogVendor @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@id([issueId, catalogVendorId])
  @@map("issue_catalog_prefix")
}

model Issue {
  id               String   @id @default(cuid())
  collectionId     String
  // Short per-collection issue number (#432), allocated from `Collection.nextIssueNo` exactly as
  // `Item.itemNo` (#268) and `Offer.offerNo` (#416) are. Assigned at creation, never editable,
  // never reused. It is what the quick-jump box takes after `iss` (#431).
  issueNo          Int
  collectionAreaId String
  name             String?
  year             Int?
  isAutoCreated    Boolean  @default(false)
  createdAt        DateTime @default(now())
  // Denormalized numeric sort key for catalog-number ordering (#181): the parsed number of the
  // issue's effective primary-catalog vendor, else the lowest numeric across its numbers, else
  // null (sorts last). Maintained on every write that changes the issue's numbers or area, and
  // bulk-recomputed when an area's effective primary catalog changes. See ADR-0012.
  primaryCatalogSortKey Int?

  collection     Collection          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionArea CollectionArea       @relation(fields: [collectionAreaId], references: [id], onDelete: Cascade)
  members        IssueMember[]
  checklists     Checklist[]
  catalogNumbers IssueCatalogNumber[]
  catalogPrefixes IssueCatalogPrefix[]
  translations   IssueTranslation[]
  formatFactors  StampFormatFactor[]

  @@unique([collectionId, issueNo])
  @@index([collectionId, year, primaryCatalogSortKey])
  @@index([collectionId, primaryCatalogSortKey])
  @@map("issue")
}

// Per-language `name` for an issue (#295), behind the `{issueName}` title token. Same shape as
// `CollectionAreaTranslation` (#293): `Issue.name` stays the default-language value and a row here
// overrides it for one language.
model IssueTranslation {
  issueId  String
  language String
  name     String?

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([issueId, language])
  @@map("issue_translation")
}

model IssueCatalogNumber {
  issueId         String
  catalogVendorId String
  firstNumber     String
  lastNumber      String?

  issue         Issue         @relation(fields: [issueId], references: [id], onDelete: Cascade)
  catalogVendor CatalogVendor @relation(fields: [catalogVendorId], references: [id], onDelete: Cascade)

  @@id([issueId, catalogVendorId])
  @@map("issue_catalog_number")
}

model IssueMember {
  issueId String
  stampId String
  // Manual position in the issue's stamp tree (#549). The value only ever has to be consistent
  // **within one sibling group** — root nodes are read against root nodes and a parent's children
  // against each other, and the two groups never compare — so a reorder densely renumbers the one
  // group it was handed and leaves every other group's values alone. A new member appends at
  // `max(sortOrder) over the issue + 1`, which is past every group, so it lands last in whichever
  // group it joins. Backfilled by `stamp.createdAt`, which is the order added.
  sortOrder Int @default(0)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  stamp Stamp @relation("IssueMemberStamp", fields: [stampId], references: [id], onDelete: Cascade)

  @@id([issueId, stampId])
  @@index([issueId, sortOrder])
  @@map("issue_member")
}

// A **checklist** (#531; ADR-0031) is a named list of stamps that counts as one complete unit —
// the collecting goal, as against `Issue`, which is the publication event. They are usually 1:1
// and used to be welded together by `IssueMember.requiredForCompleteness`, one boolean giving an
// issue exactly one complete set. They are not always 1:1: the same series is collected basic and
// specialized, perforated and imperforate, tabbed and plain, and each of those needs its own
// completeness.
//
// `issueId` is the same nullable anchor `StampFormatFactor` uses: a row naming an issue is that
// issue's goal and is edited on its row, and null means the checklist spans issues (a thematic
// set, "all Grosik 1928-1932") — one kind of checklist with an optional anchor, rather than two.
model Checklist {
  id           String   @id @default(cuid())
  collectionId String
  // Null = spans issues. Not null = this issue's own goal, edited from the issue's row.
  issueId      String?
  name         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  issue      Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  stamps     ChecklistStamp[]

  @@index([collectionId])
  @@index([issueId, sortOrder])
  @@map("checklist")
}

// Membership **is** required-ness (#531). The old per-membership boolean expressed exactly this,
// and a stamp that is an optional extra is simply an `IssueMember` in no checklist — so a checklist
// needs no second flag. Many-to-many both ways: a stamp belongs to as many checklists as apply,
// exactly as `IssueMember` already lets it belong to several issues.
model ChecklistStamp {
  checklistId String
  stampId     String

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  stamp     Stamp     @relation("ChecklistStampStamp", fields: [stampId], references: [id], onDelete: Cascade)

  @@id([checklistId, stampId])
  @@index([stampId])
  @@map("checklist_stamp")
}

// What the collector is **looking for** (#532; ADR-0032) — for a stamp not owned yet, and for one
// owned but wanted in better shape.
//
// Deliberately **not** a fourth disposition. `inCollection` / `forSale` / `forTrade` live on `Item`,
// and an `Item` is one physical copy (ADR-0007, no quantity field). A wanted stamp has no copy, so a
// fourth flag would force phantom `Item` rows and poison every count that reads inventory — holdings
// totals, valuation, cost-basis, completeness. Disposition answers "what am I doing with what I
// have"; wanting is outside its domain.
//
// A want is an **acceptance criterion**, not a (stamp, condition, format) tuple. Nothing owned yet
// means anything from used to MNH will do; a used copy owned turns the same want into "any mint";
// certificates matter for a few stamps and not at all for the rest. So each axis carries a *set* of
// acceptable values in its own join table below, where **zero rows means "any"**.
//
// "At least X" is deliberately inexpressible. `StampCondition.sortOrder` is display order, not
// quality: `U` and `MNG` are cancellation and gum, two different axes, and `CTO` / `FDC` are on no
// scale at all. Any minimum-quality rule would invent an ordering the dictionary does not guarantee
// and the collector can destroy by dragging a row.
//
// Upgrades fall out for free and need no concept of their own: with a used copy held and the
// acceptance set narrowed to the mint conditions, the held copy does not satisfy the want, so it
// stays open.
model Want {
  id           String @id @default(cuid())
  collectionId String
  stampId      String
  // Open/closed as one column, the `Item.disposedAt` idiom: null is open, a timestamp is the moment
  // the collector decided the want was met. Flag and date in one, so every filter stays a plain
  // `where` and no second column can disagree with the first.
  //
  // Nothing sets this automatically. A copy arriving surfaces the wants it *could* satisfy and the
  // collector closes, narrows or leaves each one — auto-closing would silently discard a record of
  // intent, and narrowing (the common case) is a judgement the app cannot make.
  closedAt     DateTime?
  // There is deliberately **no maximum price** here. A want is a standing intention with no date, so
  // a figure on it would be a price opinion frozen the day it was typed and then silently wrong —
  // and on a whole-series add it would be one number stamped onto twelve stamps worth wildly
  // different amounts. What a stamp is worth *at the moment of buying* is what the recommendation
  // engine answers from recorded results (ADR-0029/ADR-0022), against the copy actually in front of
  // the collector. Two mechanisms for one question is how they drift.
  // What to chase first when a dealer's list is long, not a queue position — several wants share a
  // priority and nothing orders within one.
  //
  // Stored as the **rank** (0 = high, 1 = normal, 2 = low), not as the word: the list is ordered by
  // priority and paged on the server, so the database has to sort it, and the only order Postgres
  // can put a `text` column in is its spelling — `high < low < normal`, which is not what anybody
  // means. Ascending rank is descending urgency, so a plain `ORDER BY` reads right. The vocabulary
  // lives in `want-rules.ts`; the word never reaches this column, and nothing has to agree with
  // anything.
  priority     Int @default(1)
  notes        String?
  createdAt    DateTime @default(now())

  collection          Collection             @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  stamp               Stamp                  @relation("WantStamp", fields: [stampId], references: [id], onDelete: Cascade)
  conditions          WantCondition[]
  certificateStatuses WantCertificateStatus[]
  formats             WantFormat[]

  @@index([collectionId])
  // Every list read narrows to the wants still open, so the flag is indexed with the scope rather
  // than on its own — `Item`'s `[collectionId, disposedAt]` for the same reason.
  @@index([collectionId, closedAt])
  // The list's whole ordering, in order: open before closed, then urgency. `createdAt` is the last
  // tiebreak and is left off — it varies per row, so it would only lengthen the index.
  @@index([collectionId, closedAt, priority])
  @@index([stampId])
  @@map("want")
}

// One acceptable condition. **Zero rows means "any"** — the want is satisfied by a copy in any
// condition — and that is the whole reason this is a table rather than a nullable column.
//
// The only axis of the three needing no nullable FK: `Item.conditionId` is required, so there is no
// "none" value to express and a plain composite primary key is enough.
model WantCondition {
  wantId      String
  conditionId String

  want      Want           @relation(fields: [wantId], references: [id], onDelete: Cascade)
  condition StampCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@id([wantId, conditionId])
  @@index([conditionId])
  @@map("want_condition")
}

// One acceptable certificate status, **nullable on purpose**. On `Item` and `StampCatalogPrice` a
// null `certificateStatusId` *is* a value — "no certificate" (ADR-0006 §2) — so "only without a
// certificate" is a real want and must be expressible, while "don't care" is zero rows. Both
// meanings therefore have to fit, which a non-null column cannot do.
//
// Uniqueness on `(wantId, certificateStatusId)` is a raw `UNIQUE ... NULLS NOT DISTINCT` index (see
// the migration), the idiom `stamp_catalog_price_unique` and `stamp_format_factor_unique` already
// use: without it Postgres treats every null row as distinct and the "no certificate" member could
// be added over and over. Requires PostgreSQL 15+.
model WantCertificateStatus {
  id                  String  @id @default(cuid())
  wantId              String
  /** Null = the "no certificate" value, not "any". Any is zero rows. */
  certificateStatusId String?

  want              Want               @relation(fields: [wantId], references: [id], onDelete: Cascade)
  certificateStatus CertificateStatus? @relation(fields: [certificateStatusId], references: [id], onDelete: Cascade)

  @@index([wantId])
  @@index([certificateStatusId])
  @@map("want_certificate_status")
}

// One acceptable format, nullable for the same reason one table up: a null `Item.formatId` **means
// single** (see `StampFormat`), so "only singles" is a real want, while "any format" is zero rows.
// Same `NULLS NOT DISTINCT` index in the migration.
model WantFormat {
  id       String  @id @default(cuid())
  wantId   String
  /** Null = the "single" value, not "any". Any is zero rows. */
  formatId String?

  want   Want         @relation(fields: [wantId], references: [id], onDelete: Cascade)
  format StampFormat? @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@index([wantId])
  @@index([formatId])
  @@map("want_format")
}

// A named, reusable acceptance set (#533; ADR-0032 §9) — "any mint", "anything", "kopia do
// kolekcji". Collection-scoped, and carrying exactly the three axes a `Want` carries, nullable
// members included, so everything expressible on a want is expressible on a profile.
//
// Applying one **seeds** the want: the three sets are copied onto it and the link ends there. So
// there is deliberately **no `profileId` on `Want`**, and that absence is the whole of the decision
// — a seed leaves no column behind, which is why ADR-0032 §9 states it in words. Editing a profile
// therefore changes nothing already written, including closed wants, whose acceptance is a record
// of a decision already taken; deleting one cannot orphan or alter a want, so there is no in-use
// check to get wrong. It is the shape `CollageTemplate` (#308) and `Contact.descriptionTemplate`
// already have here, and the precedent is the reason rather than a coincidence.
model AcceptanceProfile {
  id           String   @id @default(cuid())
  collectionId String
  name         String
  /** Display order in the picker and in Settings, dragged rather than typed — the dictionaries'
   *  own idiom. */
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  collection          Collection                          @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  conditions          AcceptanceProfileCondition[]
  certificateStatuses AcceptanceProfileCertificateStatus[]
  formats             AcceptanceProfileFormat[]

  // The picker names them, so two profiles called "Any mint" is a dictionary nobody can read.
  @@unique([collectionId, name])
  @@index([collectionId, sortOrder])
  @@map("acceptance_profile")
}

/** One acceptable condition. Zero rows means "any" — {@link WantCondition}'s rule, and the reason
 *  this is a table rather than a column, restated on the profile so the two cannot disagree. */
model AcceptanceProfileCondition {
  profileId   String
  conditionId String

  profile   AcceptanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  condition StampCondition    @relation(fields: [conditionId], references: [id], onDelete: Cascade)

  @@id([profileId, conditionId])
  @@index([conditionId])
  @@map("acceptance_profile_condition")
}

/** See {@link WantCertificateStatus}: null is the "no certificate" **value**, any is zero rows, and
 *  the `UNIQUE … NULLS NOT DISTINCT` index lives in the migration. */
model AcceptanceProfileCertificateStatus {
  id                  String  @id @default(cuid())
  profileId           String
  /** Null = the "no certificate" value, not "any". Any is zero rows. */
  certificateStatusId String?

  profile           AcceptanceProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  certificateStatus CertificateStatus? @relation(fields: [certificateStatusId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([certificateStatusId])
  @@map("acceptance_profile_certificate_status")
}

/** See {@link WantFormat}: null **means single**, any is zero rows, same index in the migration. */
model AcceptanceProfileFormat {
  id        String  @id @default(cuid())
  profileId String
  /** Null = the "single" value, not "any". Any is zero rows. */
  formatId  String?

  profile AcceptanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  format  StampFormat?      @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([formatId])
  @@map("acceptance_profile_format")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  collectionId String
  fromCurrency String
  toCurrency   String
  rate         Decimal
  fetchedAt    DateTime

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, fromCurrency, toCurrency])
  @@map("exchange_rate")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
