# Local development environment
# Copy this file to .env and fill in the values.

# PostgreSQL connection string
# Matches the db service in docker-compose.yml
DATABASE_URL=postgresql://stamporama:stamporama@localhost:5432/stamporama

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the application — Better Auth redirects through it, and it is also the address the
# `{offerUrl}` listing-template token (#415) links back to, as `<base>/o/<collection>/<offerNo>`.
BETTER_AUTH_URL=http://localhost:3000

# Key that encrypts stored third-party credentials at rest (#476) — currently the Allegro client
# secret and OAuth tokens (ADR-0023).
#
# A fixed throwaway value for local development, matching the default baked into
# docker-compose.yml so both ways of running dev behave identically. A real deployment generates
# its own with `openssl rand -base64 32` — see .env.prod.example, which deliberately ships this
# key commented out.
#
# Losing or changing it does not lose collection data, but every stored connection has to be made
# again.
STAMPORAMA_SECRET_KEY=stamporama-local-dev-key-not-for-production

# App version shown in the UI — set automatically by Docker build; leave empty for local dev
STAMPORAMA_VERSION=

# When the running build was made, ISO-8601 UTC (#507) — shown beside the version. Set
# automatically by the Docker build; leave empty for local dev, where no date is shown.
STAMPORAMA_BUILD_DATE=

# Directory for uploaded photo bytes (#112). Defaults to ./.data locally (gitignored) and
# /data in the container; only set this to override.
# STAMPORAMA_DATA_DIR=
# Hours a staged (dropped-but-unsaved) photo upload survives before the orphan-GC sweep.
# STAMPORAMA_PHOTO_UPLOAD_TTL_HOURS=3
# Days a sold / withdrawn offer keeps its generated listing images before they are purged (#512).
# They can always be rendered again from the copies' scans, so a listing that is over has no reason
# to keep its collages on disk. `0` purges at the next hourly sweep; `off` keeps them forever.
# Originals — a copy's scan, an image you uploaded to the offer yourself — are never touched.
# STAMPORAMA_CLOSED_OFFER_PHOTO_TTL_DAYS=7

# Log every refused Allegro API call in full — the request body, and Allegro's own answer (#477).
# Off by default: on a publish the request body is the whole listing, and a self-hosted instance's
# logs are not the place for that unless somebody is looking at a refusal. The bearer is never
# logged. Set to `1` to turn it on, then read the app's own output.
#
# The local Docker stack (`docker-compose.yml`) already sets it to 1 — a refusal there is a
# developer's own terminal. This line is for running the app outside Docker.
# STAMPORAMA_ALLEGRO_DEBUG=1

# Active write backend for new photos (#138): `filesystem` (default) or `gcs`. Existing photos
# always keep serving from the backend they were written to, regardless of this setting.
# STAMPORAMA_STORAGE_BACKEND=filesystem
# --- Google Cloud Storage (only when STAMPORAMA_STORAGE_BACKEND=gcs) ---
# STAMPORAMA_GCS_BUCKET=my-stamporama-photos
# Optional object-key prefix inside the bucket.
# STAMPORAMA_GCS_KEY_PREFIX=
# Lifetime of the signed read URLs the app mints, in seconds (default 300).
# STAMPORAMA_GCS_SIGNED_URL_TTL_SECONDS=300
# Credentials via Application Default Credentials — path to a service-account key (also signs URLs).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
