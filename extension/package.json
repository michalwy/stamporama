    "test": "tsx --test \"src/**/*.test.ts\" \"*.test.ts\""
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "esbuild": "0.28.1",
    "linkedom": "0.18.13",
    "tsx": "4.23.11",
    "typescript": "5.9.3"
  }
}
