{
  "name": "@stamporama/assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Stamporama Assistant — MV3 browser extension shell (#253, part of #155)",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
