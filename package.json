{
  "name": "stamporama",
  "version": "0.0.0",
  "packageManager": "pnpm@12.13.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:static": "scripts/static-checks.sh",
    "check:ruleset": "node scripts/check-ruleset.mjs",
    "postinstall": "if [ -f prisma/schema.prisma ]; then prisma generate; fi",
    "pretypecheck": "scripts/ensure-prisma-client.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "photos:migrate:gcs": "tsx scripts/migrate-photos-to-gcs.ts",
    "delcampe:categories": "tsx --tsconfig scripts/tsconfig.json scripts/refresh-delcampe-categories.ts",
    "assistant:zip": "cd extension && node build.mjs --release && node pack.mjs",
    "pretest:unit": "scripts/ensure-prisma-client.sh",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "pretest:integration": "scripts/ensure-prisma-client.sh",
    "test:integration": "scripts/e2e-db.sh test",
    "test:integration:time": "scripts/e2e-db.sh time",
    "e2e:db:up": "scripts/e2e-db.sh up",
    "e2e:db:reset": "scripts/e2e-db.sh reset",
    "e2e:db:down": "scripts/e2e-db.sh down",
    "slot": "scripts/dev-slot.sh"
  },
  "dependencies": {
    "@google-cloud/storage": "8.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.104.3",
    "better-auth": "1.7.9",
    "dompurify": "3.4.17",
    "lucide-react": "1.58.0",
    "marked": "18.1.1",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.30",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
