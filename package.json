{
  "name": "stamporama",
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "photos:migrate:gcs": "tsx scripts/migrate-photos-to-gcs.ts",
    "delcampe:categories": "tsx --tsconfig scripts/tsconfig.json scripts/refresh-delcampe-categories.ts",
    "assistant:zip": "cd extension && node build.mjs --release && node pack.mjs",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "scripts/e2e-db.sh test",
    "e2e:db:up": "scripts/e2e-db.sh up",
    "e2e:db:reset": "scripts/e2e-db.sh reset",
    "e2e:db:down": "scripts/e2e-db.sh down",
    "slot": "scripts/dev-slot.sh show"
  },
  "dependencies": {
    "@google-cloud/storage": "7.22.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@tanstack/react-query": "5.102.8",
    "better-auth": "1.6.26",
    "dompurify": "3.4.14",
    "lucide-react": "1.34.0",
    "marked": "18.0.11",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.26",
    "prisma": "7.9.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
